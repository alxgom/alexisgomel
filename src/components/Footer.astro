---
const today = new Date();
import {
  INSTAGRAM_LINK,
  LINKEDIN_LINK,
  GITHUB_LINK,
  RESEARCHGATE_LINK,
} from "../consts";
---

<footer class="page-footer">
  <div class="container">
    <div class="row align-items-center justify-content-center">
      <div class="col-sm-12 text-center">
        <div class="socials">
          <a
            class="social-item"
            href={INSTAGRAM_LINK}
            target="_blank"
            rel="noopener noreferrer"><i class="ti-instagram"></i></a
          >
          <a
            class="social-item"
            href={LINKEDIN_LINK}
            target="_blank"
            rel="noopener noreferrer"><i class="ti-linkedin"></i></a
          >
          <a
            class="social-item"
            href={GITHUB_LINK}
            target="_blank"
            rel="noopener noreferrer"><i class="ti-github"></i></a
          >
          <a
            class="social-item"
            href={RESEARCHGATE_LINK}
            target="_blank"
            rel="noopener noreferrer"><i class="ti-pencil-alt"></i></a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
