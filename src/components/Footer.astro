---
const today = new Date();
import {
  INSTAGRAM_LINK,
  LINKEDIN_LINK,
  GITHUB_LINK,
  RESEARCHGATE_LINK,
  EMAIL,
} from "../consts";
---

<footer class="page-footer">
  <div class="container">
    <div class="row align-items-center justify-content-end">
      <div class="col-sm-12 text-right">
        <div class="socials" style="display: flex; justify-content: flex-end;">
          <a
            class="social-item"
            href={INSTAGRAM_LINK}
            target="_blank"
            rel="noopener noreferrer"><i class="ti-instagram"></i></a
          >
          <a
            class="social-item"
            href={LINKEDIN_LINK}
            target="_blank"
            rel="noopener noreferrer"><i class="ti-linkedin"></i></a
          >
          <a
            class="social-item"
            href={GITHUB_LINK}
            target="_blank"
            rel="noopener noreferrer"><i class="ti-github"></i></a
          >
          <a
            class="social-item"
            href={RESEARCHGATE_LINK}
            target="_blank"
            rel="noopener noreferrer"><i class="ai ai-researchgate"></i></a
          >
          <a
            class="social-item"
            href={`mailto:${EMAIL}`}
            aria-label="Send email"><i class="ti-email"></i></a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
