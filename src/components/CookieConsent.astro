---
interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;

// Define translations for the banner
const i18n = {
  en: {
    bannerTitle: "Your privacy matters to us",
    accept: "Accept all",
    reject: "Reject non-essential",
  },
  es: {
    bannerTitle: "Tu privacidad nos importa",
    accept: "Aceptar todo",
    reject: "Rechazar no esenciales",
  },
};

const text = currentLang === "es" ? i18n.es : i18n.en;
---

<link
  rel="stylesheet"
  id="silktide-consent-manager-css"
  href="/cookie-banner/silktide-consent-manager.css"
/>
<script is:inline src="/cookie-banner/silktide-consent-manager.js"></script>

<script is:inline define:vars={{ text }}>
  silktideConsentManager.init({
    text: {
      prompt: {
        description:
          "<p>We use cookies to help us understand how you use this site.</p>",
        acceptAllButtonText: text.accept,
        rejectNonEssentialButtonText: text.reject,
      },
    },
    icon: { position: "bottomLeft" },
    consentTypes: [
      {
        id: "necessary",
        label: "Necessary",
        required: true,
        description: "Essential cookies for the website to function properly.",
      },
      {
        id: "analytics",
        label: "Analytics",
        defaultValue: true,
        description: "Cookies to help us understand how you use the website.",
        gtag: "analytics_storage",
      },
      {
        id: "advertising",
        label: "Advertising",
        description: "Cookies used to deliver relevant advertisements.",
        gtag: ["ad_storage", "ad_user_data", "ad_personalization"],
      },
    ],
  });
</script>
