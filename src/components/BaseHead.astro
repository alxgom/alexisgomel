---
import { SEO } from "astro-seo";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  INSTAGRAM_LINK,
  LINKEDIN_LINK,
  GITHUB_LINK,
  RESEARCHGATE_LINK,
} from "../consts";

interface Props {
  title: string;
  description: string;
  image?: string;
  // New Multilingual Props
  currentLang: string;
  alternateHref: string;
  alternateHrefs?: Record<string, string>;
}

const {
  title,
  description,
  image = "/assets/imgs/curvy_logo.svg", // Updated to use curvy_logo.svg for social media previews
  currentLang,
  alternateHref,
  alternateHrefs,
} = Astro.props;

// 1. Determine the canonical URL for the current page
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);

// 2. Determine the alternate language tags for SEO
// We build an array of alternates. If alternateHrefs is provided, we use it.
// Otherwise, we fall back to the old single alternateHref logic.
const languageAlternates = [{ href: canonicalURL.href, hrefLang: currentLang }];

if (alternateHrefs) {
  Object.entries(alternateHrefs).forEach(([lang, href]) => {
    const path = href.endsWith("/") ? href : `${href}/`;
    const url = new URL(path, Astro.site);
    languageAlternates.push({ href: url.href, hrefLang: lang });
  });
} else if (alternateHref) {
  const alternateLang = currentLang === "en" ? "es" : "en";
  const alternatePath = alternateHref.endsWith("/")
    ? alternateHref
    : `${alternateHref}/`;
  const alternateUrl = new URL(alternatePath, Astro.site);
  languageAlternates.push({ href: alternateUrl.href, hrefLang: alternateLang });
}

// 3. Set the base URL for the 'x-default' (fallback) link
// Use the 'en' version if available, otherwise use canonical if current is 'en'
const enAlt = alternateHrefs?.en || (currentLang === "en" ? canonicalPath : alternateHref);
const enPath = enAlt.endsWith("/") ? enAlt : `${enAlt}/`;
const enUrl = new URL(enPath, Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alexis Gomel",
  url: Astro.site,
  image: new URL(image, Astro.url),
  sameAs: [LINKEDIN_LINK, GITHUB_LINK, RESEARCHGATE_LINK, INSTAGRAM_LINK],
  jobTitle: "Physicist | Data Scientist | Data Analyst | Researcher",
  description: description,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Barcelona",
    addressRegion: "Catalonia",
    addressCountry: "ES",
  },
};
---

<SEO
  title={title}
  description={description}
  canonical={canonicalURL.href}
  charset="utf-8"
  openGraph={{
    basic: {
      title: title,
      type: "website",
      image: new URL(image, Astro.url).href,
    },
    optional: {
      description: description,
    },
  }}
  twitter={{
    card: "summary_large_image",
    title: title,
    description: description,
    image: new URL(image, Astro.url).href,
  }}
  languageAlternates={[
    ...languageAlternates,
    { href: enUrl.href, hrefLang: "x-default" },
  ]}
  extend={{
    meta: [
      { name: "viewport", content: "width=device-width,initial-scale=1" },
      { name: "generator", content: Astro.generator },
      { name: "HandheldFriendly", content: "True" },
      { name: "MobileOptimized", content: "320" },
      { name: "geo.region", content: "ES-CT" },
      { name: "geo.placename", content: "Barcelona" },
      { name: "yandex-verification", content: "59d60a5cd747bc3d" },
    ],
    link: [
      {
        rel: "icon",
        type: "image/svg+xml",
        href: "/assets/imgs/curvy_logo.svg",
      },
    ],
  }}
/>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
