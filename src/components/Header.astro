---
const { pathname } = Astro.url;
const isSpanish = pathname.startsWith("/es/");

// 1. LANGUAGE SWITCHER LOGIC
let switchUrl;
if (isSpanish) {
  switchUrl = pathname.replace(/^\/es/, "") || "/";
} else {
  // Fix for root path in English to switch to /es/
  switchUrl = pathname === "/" ? "/es/" : `/es${pathname}`;
}
const switchLabel = isSpanish ? "EN" : "ES";
const switchLangAttr = isSpanish ? "en" : "es";

// 2. BASE PATHS
const homeBase = isSpanish ? "/es" : "";

// 3. TRANSLATIONS
const t = {
  home: isSpanish ? "Inicio" : "Home",
  // Professional
  cv: isSpanish ? "CV" : "CV",
  projects: isSpanish ? "Proyectos" : "Projects",
  publications: isSpanish ? "Publicaciones" : "Publications",
  // CV Submenu
  cv_online: isSpanish ? "CV Online" : "Online CV",
  cv_about: isSpanish ? "Sobre mí" : "About me",
  cv_skills: isSpanish ? "Habilidades" : "Skills",
  cv_experience: isSpanish ? "Experiencia" : "Experience",
  cv_education: isSpanish ? "Educación" : "Education",
  // Projects Submenu
  proj_analysis: isSpanish ? "Análisis de Datos" : "Data Analysis",
  proj_apps: isSpanish ? "Apps" : "App Development",
  proj_viz_dev: isSpanish ? "Desarrollo Visualización" : "Visualization Dev",
  proj_plots: isSpanish ? "Gráficos" : "Plots & Visualization",
  // Hobbies
  photography: isSpanish ? "Fotografía" : "Photography",
  playlists: isSpanish ? "Playlists" : "Playlists",
  // Contact
  contact: isSpanish ? "Contacto" : "Contact",
};

// Links helper
const link = (path) => `${homeBase}${path}`;
---

<nav
  class="navbar navbar-expand-lg navbar-light fixed-top"
  data-spy="affix"
  data-offset-top="0"
>
  <div class="container">
    <a class="navbar-brand" href={isSpanish ? "/es/" : "/"}>
      <img src="/assets/imgs/curvy_logo.svg" alt="Logo" />
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-toggle="collapse"
      data-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ml-auto align-items-center">
        <!-- Home -->
        <li class="nav-item">
          <a class="nav-link" href={link("/")}>{t.home}</a>
        </li>

        <!-- Separator -->
        <li class="nav-separator d-none d-lg-block">|</li>

        <!-- CV Dropdown -->
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle"
            href={link("/cvonline")}
            id="cvDropdown"
          >
            {t.cv}
          </a>
          <div class="dropdown-menu" aria-labelledby="cvDropdown">
            <a class="dropdown-item" href={link("/cvonline")}>{t.cv_online}</a>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href={link("/cvonline#Current")}
              >{t.cv_about}</a
            >
            <a class="dropdown-item" href={link("/cvonline#Skills")}
              >{t.cv_skills}</a
            >
            <a class="dropdown-item" href={link("/cvonline#Experience")}
              >{t.cv_experience}</a
            >
            <a class="dropdown-item" href={link("/cvonline#Education")}
              >{t.cv_education}</a
            >
          </div>
        </li>

        <!-- Projects Dropdown -->
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle"
            href={link("/projects")}
            id="projectsDropdown"
          >
            {t.projects}
          </a>
          <div class="dropdown-menu" aria-labelledby="projectsDropdown">
            <a class="dropdown-item" href={link("/projects")}>{t.projects}</a>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href={link("/projects#Data_analysis")}
              >{t.proj_analysis}</a
            >
            <a class="dropdown-item" href={link("/projects#App_development")}
              >{t.proj_apps}</a
            >
            <a class="dropdown-item" href={link("/projects#Viz_development")}
              >{t.proj_viz_dev}</a
            >
            <a class="dropdown-item" href={link("/projects#Plots_Viz")}
              >{t.proj_plots}</a
            >
          </div>
        </li>

        <!-- Publications (External) -->
        <li class="nav-item">
          <a
            class="nav-link"
            href="https://scholar.google.com/citations?user=XgG56aYAAAAJ&hl=es&oi=ao"
            target="_blank"
            rel="noopener noreferrer">{t.publications}</a
          >
        </li>

        <!-- Separator -->
        <li class="nav-separator d-none d-lg-block">|</li>

        <!-- Hobbies -->
        <li class="nav-item">
          <a class="nav-link" href={link("/photography")}>{t.photography}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={link("/playlists")}>{t.playlists}</a>
        </li>

        <!-- Separator -->
        <li class="nav-separator d-none d-lg-block">|</li>

        <!-- Contact -->
        <li class="nav-item">
          <a class="nav-link" href={link("/contact")}>{t.contact}</a>
        </li>

        <!-- Language Switcher -->
        <li class="nav-item ml-3">
          <a
            class="nav-link btn btn-primary rounded btn-sm text-white"
            href={switchUrl}
            lang={switchLangAttr}
            style="padding: 5px 10px;"
          >
            {switchLabel}
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* Ensure header stays on top of subheaders */
  nav.navbar {
    z-index: 9999 !important;
  }

  /* Visual Separator */
  .nav-separator {
    color: #ccc;
    margin: 0 10px;
    user-select: none;
  }

  /* Hover Dropdown Logic for Desktop */
  @media (min-width: 992px) {
    .navbar-nav .dropdown:hover .dropdown-menu {
      display: block;
      margin-top: 0;
      border-radius: 0.25rem;
    }
  }

  /* Highlight Top Level Items on Hover */
  .nav-link:hover,
  .nav-item.dropdown:hover > .nav-link {
    color: var(--primary) !important;
  }

  /* Highlight Dropdown Items on Hover */
  .dropdown-item:hover,
  .dropdown-item:focus {
    background-color: #f8f9fa;
    color: var(--primary);
    text-decoration: none;
  }

  /* Active state */
  .dropdown-item:active {
    background-color: var(--primary);
    color: #fff;
  }
</style>
