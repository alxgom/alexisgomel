---
const { pathname } = Astro.url;
const isSpanish = pathname.startsWith("/es/");

// 1. LANGUAGE SWITCHER LOGIC
let switchUrl;
if (isSpanish) {
  switchUrl = pathname.replace(/^\/es/, "") || "/";
} else {
  // Fix for root path in English to switch to /es/
  switchUrl = pathname === "/" ? "/es/" : `/es${pathname}`;
}
// Ensure switchUrl has a trailing slash if it doesn't have one and doesn't have a dot or hash
if (
  !switchUrl.endsWith("/") &&
  !switchUrl.includes(".") &&
  !switchUrl.includes("#")
) {
  switchUrl += "/";
}
const switchLabel = isSpanish ? "EN" : "ES";
const switchLangAttr = isSpanish ? "en" : "es";

// 2. BASE PATHS
const homeBase = isSpanish ? "/es" : "";

// 3. TRANSLATIONS
const t = {
  home: isSpanish ? "Inicio" : "Home",
  // Professional
  cv: isSpanish ? "CV" : "CV",
  projects: isSpanish ? "Proyectos" : "Projects",
  publications: isSpanish ? "Publicaciones" : "Publications",
  // CV Submenu
  cv_online: isSpanish ? "CV Online" : "Online CV",
  cv_about: isSpanish ? "Sobre mí" : "About me",
  cv_skills: isSpanish ? "Habilidades" : "Skills",
  cv_experience: isSpanish ? "Experiencia" : "Experience",
  cv_education: isSpanish ? "Educación" : "Education",
  // Projects Submenu
  proj_analysis: isSpanish ? "Análisis de Datos" : "Data Analysis",
  proj_apps: isSpanish ? "Apps" : "App Development",
  proj_viz_dev: isSpanish ? "Desarrollo Visualización" : "Visualization Dev",
  proj_plots: isSpanish ? "Gráficos" : "Plots & Visualization",
  // Hobbies
  photography: isSpanish ? "Fotografía" : "Photography",
  playlists: isSpanish ? "Playlists" : "Playlists",
  // Contact
  contact: isSpanish ? "Contacto" : "Contact",
};

// Links helper
const link = (path: string) => {
  const fullPath = `${homeBase}${path}`;
  if (path.includes("#") || fullPath.endsWith("/") || path.includes(".")) {
    return fullPath;
  }
  return `${fullPath}/`;
};

// Active State Helper
const isActive = (slug: string) => {
  if (slug === "/") {
    return pathname === "/" || pathname === "/es/";
  }
  return pathname.includes(slug);
};
---

<nav
  class="navbar navbar-expand-lg navbar-light fixed-top"
  data-spy="affix"
  data-offset-top="0"
>
  <div class="container-fluid px-3 px-lg-5">
    <a
      class="navbar-brand gtm-track-click"
      href={isSpanish ? "/es/" : "/"}
      data-event-category="Navigation"
      data-event-label="Logo"
    >
      <img src="/assets/imgs/curvy_logo.svg" alt="Logo" />
    </a>

    <!-- Language Switcher - Always visible, outside burger -->
    <a
      class="nav-link-lang-mobile gtm-track-click d-lg-none"
      href={switchUrl}
      lang={switchLangAttr}
      data-event-category="Navigation"
      data-event-label={`Language Switch - ${switchLabel}`}
    >
      {switchLabel}
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-toggle="collapse"
      data-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ml-auto align-items-center">
        <!-- Home -->
        <li class="nav-item">
          <a
            class={`nav-link gtm-track-click ${isActive("/") ? "active" : ""}`}
            href={link("/")}
            data-event-category="Navigation"
            data-event-label="Home">{t.home}</a
          >
        </li>

        <!-- Separator -->
        <li class="nav-separator d-none d-lg-block">|</li>

        <!-- CV Dropdown -->
        <li class="nav-item dropdown">
          <a
            class={`nav-link dropdown-toggle gtm-track-click ${isActive("cvonline") ? "active" : ""}`}
            href={link("/cvonline")}
            id="cvDropdown"
            data-event-category="Navigation"
            data-event-label="CV Dropdown"
          >
            {t.cv}
          </a>
          <div class="dropdown-menu" aria-labelledby="cvDropdown">
            <a
              class="dropdown-item gtm-track-click"
              href={link("/cvonline")}
              data-event-category="Navigation"
              data-event-label="CV - Online CV">{t.cv_online}</a
            >
            <div class="dropdown-divider"></div>
            <a
              class="dropdown-item gtm-track-click"
              href={link("/cvonline#Current")}
              data-event-category="Navigation"
              data-event-label="CV - About me">{t.cv_about}</a
            >
            <a
              class="dropdown-item gtm-track-click"
              href={link("/cvonline#Skills")}
              data-event-category="Navigation"
              data-event-label="CV - Skills">{t.cv_skills}</a
            >
            <a
              class="dropdown-item gtm-track-click"
              href={link("/cvonline#Experience")}
              data-event-category="Navigation"
              data-event-label="CV - Experience">{t.cv_experience}</a
            >
            <a
              class="dropdown-item gtm-track-click"
              href={link("/cvonline#Education")}
              data-event-category="Navigation"
              data-event-label="CV - Education">{t.cv_education}</a
            >
          </div>
        </li>

        <!-- Projects Dropdown -->
        <li class="nav-item dropdown">
          <a
            class={`nav-link dropdown-toggle gtm-track-click ${isActive("projects") ? "active" : ""}`}
            href={link("/projects")}
            id="projectsDropdown"
            data-event-category="Navigation"
            data-event-label="Projects Dropdown"
          >
            {t.projects}
          </a>
          <div class="dropdown-menu" aria-labelledby="projectsDropdown">
            <a
              class="dropdown-item gtm-track-click"
              href={link("/projects")}
              data-event-category="Navigation"
              data-event-label="Projects - All">{t.projects}</a
            >
            <div class="dropdown-divider"></div>
            <a
              class="dropdown-item gtm-track-click"
              href={link("/projects#Data_analysis")}
              data-event-category="Navigation"
              data-event-label="Projects - Data Analysis">{t.proj_analysis}</a
            >
            <a
              class="dropdown-item gtm-track-click"
              href={link("/projects#App_development")}
              data-event-category="Navigation"
              data-event-label="Projects - App Development">{t.proj_apps}</a
            >
            <a
              class="dropdown-item gtm-track-click"
              href={link("/projects#Viz_development")}
              data-event-category="Navigation"
              data-event-label="Projects - Visualization Dev"
              >{t.proj_viz_dev}</a
            >
            <a
              class="dropdown-item gtm-track-click"
              href={link("/projects#Plots_Viz")}
              data-event-category="Navigation"
              data-event-label="Projects - Plots & Viz">{t.proj_plots}</a
            >
          </div>
        </li>

        <!-- Publications (External) -->
        <li class="nav-item">
          <a
            class="nav-link gtm-track-click"
            href="https://scholar.google.com/citations?user=XgG56aYAAAAJ&hl=es&oi=ao"
            target="_blank"
            rel="noopener noreferrer"
            data-event-category="Navigation"
            data-event-label="Publications">{t.publications}</a
          >
        </li>

        <!-- Separator -->
        <li class="nav-separator d-none d-lg-block">|</li>

        <!-- Hobbies -->
        <li class="nav-item">
          <a
            class={`nav-link gtm-track-click ${isActive("photography") ? "active" : ""}`}
            href={link("/photography")}
            data-event-category="Navigation"
            data-event-label="Photography">{t.photography}</a
          >
        </li>
        <li class="nav-item">
          <a
            class={`nav-link gtm-track-click ${isActive("playlists") ? "active" : ""}`}
            href={link("/playlists")}
            data-event-category="Navigation"
            data-event-label="Playlists">{t.playlists}</a
          >
        </li>

        <!-- Separator -->
        <li class="nav-separator d-none d-lg-block">|</li>

        <!-- Contact CTA -->
        <li class="nav-item nav-item-contact">
          <a
            class={`nav-link nav-link-contact gtm-track-click ${isActive("contact") ? "active" : ""}`}
            href={link("/contact")}
            data-event-category="Navigation"
            data-event-label="Contact">{t.contact}</a
          >
        </li>

        <!-- Language Switcher - Desktop only (mobile version is outside burger) -->
        <li class="nav-item ml-3 d-none d-lg-block">
          <a
            class="nav-link nav-link-lang gtm-track-click"
            href={switchUrl}
            lang={switchLangAttr}
            data-event-category="Navigation"
            data-event-label={`Language Switch - ${switchLabel}`}
          >
            {switchLabel}
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* Ensure header stays on top of subheaders */
  nav.navbar {
    z-index: 9999 !important;
  }

  /* Compact navbar - reduce padding */
  .navbar {
    padding-top: 0.3rem;
    padding-bottom: 0.3rem;
  }

  /* Smaller logo */
  .navbar-brand img {
    max-height: 35px;
  }

  /* Compact nav links */
  .nav-link {
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }

  /* Mobile: even more compact */
  @media (max-width: 991px) {
    .navbar {
      padding-top: 0.2rem;
      padding-bottom: 0.2rem;
    }

    .navbar-brand img {
      max-height: 28px;
    }

    .navbar-toggler {
      padding: 0.2rem 0.5rem;
      font-size: 1rem;
    }
  }

  /* Visual Separator */
  .nav-separator {
    color: #ccc;
    margin: 0 10px;
    user-select: none;
  }

  /* Hover Dropdown Logic for Desktop */
  @media (min-width: 992px) {
    .navbar-nav .dropdown:hover .dropdown-menu {
      display: block;
      margin-top: 0;
      border-radius: 0.25rem;
    }
  }

  /* Highlight Top Level Items on Hover & Active */
  .nav-link:hover,
  .nav-item.dropdown:hover > .nav-link,
  .nav-link.active {
    color: var(--primary) !important;
    font-weight: bold;
  }

  /* Highlight Dropdown Items on Hover */
  .dropdown-item:hover,
  .dropdown-item:focus {
    background-color: #f8f9fa;
    color: var(--primary);
    text-decoration: none;
  }

  /* Active state */
  .dropdown-item:active {
    background-color: var(--primary);
    color: #fff;
  }

  /* Contact CTA Button Styling - Filled/Solid */
  .nav-link-contact {
    background-color: var(--primary) !important;
    border: 2px solid var(--primary) !important;
    border-radius: 20px !important;
    padding: 6px 18px !important;
    margin-left: 8px;
    font-weight: 600 !important;
    color: #fff !important;
    transition: all 0.3s ease !important;
  }

  .nav-link-contact:hover {
    background-color: color-mix(in srgb, var(--primary) 85%, #000) !important;
    border-color: color-mix(in srgb, var(--primary) 85%, #000) !important;
    color: #fff !important;
  }

  .nav-link-contact.active {
    background-color: color-mix(in srgb, var(--primary) 85%, #000) !important;
    border-color: color-mix(in srgb, var(--primary) 85%, #000) !important;
    color: #fff !important;
  }

  /* Language Switcher - Outlined/Subtle */
  .nav-link-lang {
    border: 1px solid #999 !important;
    border-radius: 15px !important;
    padding: 4px 12px !important;
    font-weight: 500 !important;
    color: #666 !important;
    font-size: 0.85rem !important;
    transition: all 0.3s ease !important;
  }

  .nav-link-lang:hover {
    border-color: var(--primary) !important;
    color: var(--primary) !important;
    background-color: transparent !important;
  }

  /* Mobile adjustments for Contact button */
  @media (max-width: 991px) {
    .nav-link-contact {
      display: inline-block;
      margin: 10px 0;
    }
  }

  /* Mobile Language Switcher - Outside burger menu */
  .nav-link-lang-mobile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    border: 1px solid #999;
    border-radius: 15px;
    padding: 0 12px;
    font-weight: 500;
    color: #666;
    font-size: 0.8rem;
    text-decoration: none;
    margin-right: 10px;
    transition: all 0.3s ease;
  }

  .nav-link-lang-mobile:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
</style>
