---
import MainLayout from "../../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/sac/"; // Links to English version
---

<MainLayout
  title="Calculadora de Alquiler Justo por Metros Cuadrados | SHARE"
  description="¿Necesitas dividir el alquiler con compañeros de piso? La Calculadora SHARE te ayuda a estimar un reparto justo basado en los metros cuadrados y las zonas comunes."
  currentLang={currentLang}
  alternateHref={alternateHref}
  image="/assets/imgs/Projects/share_puzzle_logo.svg"
>
  <link rel="stylesheet" href="/assets/css/sac_styles.css?v=2" slot="head" />

  <!-- WebApplication Schema -->
  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Calculadora SHARE - SHared Appartment REnt Calculator",
      "description": "Herramienta gratuita para calcular la división justa del alquiler en pisos compartidos basándose en el tamaño de las habitaciones.",
      "url": "https://alexisgomel.com/es/sac/",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "author": {
        "@type": "Person",
        "name": "Alexis Gomel",
        "url": "https://alexisgomel.com"
      },
      "featureList": [
        "Calcula el alquiler según el tamaño de la habitación",
        "Ajusta el valor del espacio compartido",
        "Incluye gastos mensuales en el cálculo",
        "Comparación visual del tamaño de habitaciones"
      ]
    }
  </script>

  <!-- FAQ Schema for better search visibility -->
  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo dividir el alquiler de forma justa en un piso compartido?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mejor forma de dividir el alquiler es según los metros cuadrados de cada habitación. Calcula la proporción de cada habitación respecto al espacio privado total, y luego considera las áreas compartidas. La Calculadora SHARE automatiza esto ayudándote a cómo dividir el alquiler proporcionalmente basándose en las dimensiones y el valor del espacio compartido."
          }
        },
        {
          "@type": "Question",
          "name": "¿Deben incluirse los espacios compartidos en el cálculo del alquiler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, los espacios compartidos como el salón y la cocina deben considerarse en el cálculo. La Calculadora SHARE usa un 'valor de espacio compartido' configurable (0-1) para determinar cuánto peso tienen las áreas comunes. Un valor de 0.75 significa que el espacio compartido vale el 75% del valor de una habitación privada."
          }
        }
      ]
    }
  </script>

  <main>
    <article class="container mt-5 pt-5 mb-5 pb-5">
      <h1 class="title">
        Cómo dividir el alquiler por metros cuadrados: Calculadora SHARE
      </h1>
      <p class="subtitle text-center mb-5">
        Descubre cómo dividir el alquiler de forma justa basándote en los metros
        cuadrados de las habitaciones y el espacio compartido.
      </p>

      <div class="row">
        <div class="col-lg-6 mb-4">
          <form id="rent-form">
            <div class="sac-card">
              <h3 class="h5 mb-3">1. Detalles del Apartamento</h3>
              <div class="inline-inputs mb-3">
                <div>
                  <label for="rent">Precio del Alquiler:</label>
                  <input type="number" id="rent" name="rent" required />
                </div>
                <div>
                  <label for="total_area"
                    >Área total del apartamento / Metros Cuadrados: <small
                      class="text-muted d-block font-weight-normal"
                      >(cualquier unidad)</small
                    ></label
                  >
                  <input
                    type="number"
                    id="total_area"
                    name="total_area"
                    required
                  />
                </div>
                <div id="price-per-unit-area"></div>
              </div>

              <div class="form-group mb-0">
                <label for="bills">Gastos mensuales totales (opcional):</label>
                <input type="number" id="bills" name="bills" />
              </div>
            </div>

            <div class="sac-card mt-4">
              <h3 class="h5 mb-3">2. Habitaciones Privadas</h3>
              <div class="form-group mb-0">
                <label for="num_rooms">Número de habitaciones privadas:</label>
                <input type="number" id="num_rooms" name="num_rooms" required />
              </div>

              <div id="room-dimensions-container" class="mt-3"></div>
            </div>

            <div class="sac-card mt-4">
              <h3 class="h5 mb-3">3. Preferencias de Espacio Compartido</h3>
              <div class="form-group mb-0">
                <div
                  class="d-flex justify-content-between align-items-baseline mb-2"
                >
                  <label for="alpha" class="mb-0"
                    >Valor del espacio compartido:</label
                  >
                  <span
                    id="alpha-value"
                    class="font-weight-bold"
                    style="font-size: 1.25rem; color: var(--highlight-color);"
                    >0.75</span
                  >
                </div>
                <input
                  type="range"
                  id="alpha"
                  name="alpha"
                  min="0"
                  max="1"
                  step="0.01"
                  value="0.75"
                  class="w-100"
                  style="margin: 0 0 15px 0; padding: 0;"
                />
                <small class="form-text text-muted mb-0">
                  <details>
                    <summary
                      style="cursor: pointer; color: var(--highlight-color);"
                      >¿Qué es esto?</summary
                    >
                    <div class="mt-2 p-2 bg-light rounded small border">
                      0 si el espacio compartido no se cuenta.<br />
                      1 si el valor por área del espacio compartido es igual al de
                      las habitaciones.<br />
                      <strong>Por defecto: 0.75</strong>. El área del espacio
                      compartido se considera que vale 3/4 del valor de las
                      habitaciones privadas.
                    </div>
                  </details>
                </small>
              </div>
            </div>

            <button
              type="submit"
              class="btn btn-primary btn-block mt-4 compute-btn"
              >Calcular Reparto Justo <i class="fas fa-calculator ml-2"
              ></i></button
            >
          </form>
        </div>

        <div class="col-lg-6">
          <div id="warning"></div>
          <div id="result"></div>
          <div class="room-visualization" id="room-visualization"></div>
        </div>
      </div>

      <div class="row mt-5 pt-4 border-top">
        <div class="col-md-8 mx-auto">
          <h3 class="h4 mb-3">¿Por qué esta herramienta?</h3>
          <p>
            Esta simple calculadora es mi pequeña contribución para ayudar a
            quienes navegan la crisis habitacional. Encontrar un lugar ya es
            bastante difícil; dividir el alquiler no debería sumar más estrés.
          </p>
          <p>
            Si estás buscando alquilar un lugar con otras personas, esta
            herramienta ofrece un punto de partida justo para dividir los
            costos. Calcula la parte de cada persona basándose en el tamaño de
            su habitación privada y las áreas comunes.
          </p>
          <p>
            Está pensada para ahorrar tiempo y energía en ciudades donde
            encontrar alojamiento ya es un desafío. Si te resulta útil,
            ¡compártela con otros!
          </p>
          <p class="text-center mt-4 text-muted small">
            ¿Tienes sugerencias o encontraste un error? <a href="/es/contact/">
              >¡Contáctame!</a
            >
          </p>
        </div>
      </div>

      <!-- Visible FAQ Section for SEO -->
      <div class="row mt-5">
        <div class="col-md-8 mx-auto">
          <h2 class="h4 mb-4 text-center">Preguntas Frecuentes</h2>

          <div class="mb-4">
            <h3 class="h6 font-weight-bold">
              Cómo dividir el alquiler de forma justa en un piso compartido?
            </h3>
            <p class="text-muted">
              La forma más justa de dividir el alquiler es según los metros
              cuadrados de cada habitación. Calcula la proporción de cada
              habitación respecto al espacio privado total, y luego considera
              las áreas compartidas. La Calculadora SHARE automatiza esto
              dividiendo el alquiler proporcionalmente según las dimensiones de
              las habitaciones y un valor configurable para el espacio
              compartido.
            </p>
          </div>

          <div class="mb-4">
            <h3 class="h6 font-weight-bold">
              ¿Quieres saber cómo dividir el alquiler y gastos comunes?
            </h3>
            <p class="text-muted">
              Si buscas cómo dividir el alquiler, debes saber que los espacios
              compartidos como el salón y la cocina deben considerarse. La
              espacio compartido' configurable (0-1) para determinar cuánto peso
              tienen las áreas comunes. Un valor de 0.75 significa que el
              espacio compartido vale el 75% del valor de una habitación
              privada.
            </p>
          </div>
        </div>
      </div>
    </article>
  </main>

  <script is:inline defer src="/js/sac_script.js"></script>
</MainLayout>
