---
import MainLayout from "../../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/sac"; // Links to English version
---

<MainLayout
  title="Calculadora SHARE - División de Alquiler de Pisos | Alexis Gomel"
  description="Calculadora de Alquiler Compartido. Divide el alquiler de tu piso de forma justa basándote en el tamaño de las habitaciones y espacios comunes."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <link rel="stylesheet" href="/assets/css/sac_styles.css" slot="head" />
  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Calculadora de Alquiler Compartido",
      "description": "Una herramienta gratuita para calcular la división justa del alquiler en pisos compartidos.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "author": {
        "@type": "Person",
        "name": "Alexis Gomel"
      }
    }
  </script>

  <div class="container mt-5 pt-5">
    <h1 class="title">Calculadora de Alquiler Compartido (SHARE)</h1>
    <p class="subtitle">
      Calcula cómo dividir el alquiler de forma justa basándote en el tamaño de
      las habitaciones y el espacio compartido.
    </p>

    <form id="rent-form">
      <div class="inline-inputs">
        <div>
          <label for="rent">Precio del Alquiler:</label>
          <input type="number" id="rent" name="rent" required />
        </div>
        <div>
          <label for="total_area">Área total del apartamento:</label>
          <input type="number" id="total_area" name="total_area" required />
        </div>
        <div id="price-per-unit-area"></div>
      </div>

      <label for="num_rooms">Número de habitaciones:</label>
      <input type="number" id="num_rooms" name="num_rooms" required />

      <label for="alpha"
        >Valor del espacio compartido (entre 0 y 1):
        <div class="tooltip">
          0 si el espacio compartido no se cuenta.<br />
          1 si el valor por área del espacio compartido es igual al de las habitaciones.<br
          />
          Por defecto: 0.75.
        </div>
      </label>
      <div class="inline-inputs">
        <input
          type="range"
          id="alpha"
          name="alpha"
          min="0"
          max="1"
          step="0.01"
          value="0.75"
          style="width: 150px;"
        />
        <span id="alpha-value">0.75</span>
      </div>

      <div id="room-dimensions-container"></div>

      <label for="bills">Gastos mensuales (opcional):</label>
      <input type="number" id="bills" name="bills" />

      <button type="submit">Calcular</button>
    </form>

    <div id="warning"></div>
    <div id="result"></div>
    <div class="room-visualization" id="room-visualization"></div>
  </div>

  <script is:inline src="/js/sac_script.js"></script>
</MainLayout>
