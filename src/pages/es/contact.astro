---
import MainLayout from "../../layouts/MainLayout.astro";
import ContactForm from "../../components/ContactForm.astro";

const currentLang = "es";
const alternateHref = "/contact";
---

<MainLayout
  title="Contacto - Alexis Gomel | Ponte en Contacto"
  description="Contacta con Alexis Gomel. Envía un mensaje para discutir sobre física, ciencia de datos, colaboraciones de investigación o proyectos."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <section class="section mt-5">
    <div class="container">
      <div class="text-center mb-5">
        <h6 class="subtitle">Hablemos</h6>
        <h1 class="section-title">Contáctame</h1>
        <p class="mb-4">
          ¿Tienes alguna pregunta o quieres colaborar? ¡Siéntete libre de
          escribirme!
        </p>
      </div>

      <ContactForm
        formId="xldqpzqd"
        turnstileSiteKey="0x4AAAAAACFRCmkjExcAkZaD"
        lang="es"
      />

      <div class="text-center mt-5">
        <p>O escríbeme directamente a:</p>
        <a
          href="mailto:alexis.gomel@gmail.com"
          class="text-primary"
          style="font-size: 1.2rem;"
        >
          alexis.gomel@gmail.com
        </a>
      </div>
    </div>
  </section>

  <!-- Load Cloudflare Turnstile Script -->
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
</MainLayout>
