---
import MainLayout from "../../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import performanceImg from "../../../assets/imgs/Projects/performance.png";
import bestPracticesImg from "../../../assets/imgs/Projects/best_practices_screenshot.png";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/projects/looker-studio-custom-visuals/";
---

<MainLayout
  title="Visualizaciones Personalizadas para Looker Studio | Jerarquía de Árbol, Lipstick e Histograma"
  description="Mejora tu narrativa de datos con visualizaciones interactivas personalizadas para Google Looker Studio, incluyendo Jerarquía de Árbol, Histogramas y gráficos Lipstick."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <meta
    slot="head"
    name="description"
    content="Explora visualizaciones personalizadas avanzadas para Google Looker Studio. Construidas con JavaScript y DSCC, estas visualizaciones de la comunidad mejoran tus reportes con interactividad profunda."
  />
  <meta
    slot="head"
    name="keywords"
    content="Visualizaciones Personalizadas Looker Studio, Visualizaciones de la Comunidad, Jerarquía de Árbol Looker Studio, Gráfico Lipstick, Histograma Personalizado, API DSCC, Visualización de Datos JavaScript"
  />
  <meta
    slot="head"
    property="og:title"
    content="Visualizaciones Personalizadas para Looker Studio | Alexis Gomel"
  />
  <meta
    slot="head"
    property="og:description"
    content="Visualizaciones interactivas personalizadas para Looker Studio. Incluye Jerarquía de Árbol, Histogramas y gráficos Lipstick avanzados."
  />
  <meta
    slot="head"
    property="og:image"
    content="/assets/imgs/Projects/tree_hierarchy_viz.png"
  />
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />

  <style>
    .looker-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .section-title {
      text-align: center;
      margin-bottom: 1rem;
    }

    .lead {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 2rem auto;
    }

    .report-frame {
      width: 100%;
      max-width: 1000px;
      margin: 2rem auto;
      display: block;
      border: none;
      border-radius: 8px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .viz-list {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid #eee;
    }

    .viz-list h3 {
      margin-bottom: 1rem;
    }

    .viz-list ul {
      list-style: disc;
      padding-left: 1.5rem;
    }

    .viz-list li {
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
    }

    .viz-icon {
      width: 24px;
      height: 24px;
      margin-right: 10px;
    }
  </style>

  <div class="looker-container">
    <div class="container mt-5 pt-5">
      <h1 class="section-title">
        Visualizaciones de la Comunidad de Looker Studio
      </h1>
      <p class="lead text-muted">
        Visualizaciones personalizadas de la comunidad que he desarrollado para
        Google Looker Studio, extendiendo sus capacidades con tipos de gráficos
        especializados para una mejor narrativa de datos.
      </p>

      <div class="looker-embed-container">
        <div id="looker-loader" class="looker-loader">
          <div class="spinner"></div>
        </div>
        <iframe
          id="looker-iframe"
          class="report-frame"
          width="100%"
          height="600"
          src="https://lookerstudio.google.com/embed/reporting/7f1ad7dc-2ae4-4e72-be31-b588c9890fa9/page/p_8m1usmbk0d"
          frameborder="0"
          style="border:0"
          allowfullscreen
          sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        ></iframe>
      </div>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const iframe = document.getElementById("looker-iframe");
          const loader = document.getElementById("looker-loader");

          if (iframe && loader) {
            iframe.addEventListener("load", function () {
              loader.style.display = "none";
              iframe.style.visibility = "visible";
            });

            // Fallback for cases where 'load' event might not fire reliably
            setTimeout(() => {
              if (iframe.style.visibility !== "visible") {
                loader.style.display = "none";
                iframe.style.visibility = "visible";
              }
            }, 5000); // Hide loader after 5 seconds if iframe hasn't loaded
          }
        });
      </script>

      <div class="viz-list">
        <h3>Visualizaciones Incluidas</h3>
        <div class="row align-items-center mt-4">
          <div class="col-md-12">
            <ul>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/lipstick%20icon.svg"
                  class="viz-icon"
                  alt="Icono Gráfico Lipstick"
                />
                <div>
                  <strong>Gráfico Lipstick</strong> - Un tipo de gráfico especializado
                  para comparar valores reales con objetivos con un estilo visual
                  distintivo y de alta densidad.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/tree%20icon.svg"
                  class="viz-icon"
                  alt="Icono Jerarquía de Árbol"
                />
                <div>
                  <strong>Jerarquía de Árbol</strong> - Una visualización jerárquica
                  para mostrar estructuras de datos multinivel con capacidades intuitivas
                  de desglose (drill-down).
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/Histogram.svg"
                  class="viz-icon"
                  alt="Icono Histograma"
                />
                <div>
                  <strong>Histograma</strong> - Un histograma personalizable con opciones
                  de orientación, escala logarítmica y visibilidad de ejes para el
                  análisis de distribución.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/sparkline_table_icon.svg"
                  class="viz-icon"
                  alt="Icono Tabla Sparkline"
                />
                <div>
                  <strong>Tabla Sparkline</strong> - Una tabla rica en datos con sparklines
                  incrustados para rastrear tendencias de un vistazo.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/cleveland%20icon.svg"
                  class="viz-icon"
                  alt="Icono Gráfico Cleveland"
                />
                <div>
                  <strong>Gráfico Cleveland</strong> - Una alternativa limpia a los
                  gráficos de barras para comparar valores o mostrar distribuciones.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/minimal_pause_kpi.svg"
                  class="viz-icon"
                  alt="Icono KPI Personalizado"
                />
                <div>
                  <strong>KPI Personalizado</strong> - Un diseño de tarjeta KPI minimalista
                  con estética 'minimal pause' para un impacto métrico claro.
                </div>
              </li>
            </ul>
            <p class="text-muted mt-3">
              A continuación puedes ver demostraciones detalladas y
              explicaciones técnicas de las visualizaciones principales.
            </p>
          </div>
        </div>
      </div>

      <div class="viz-list">
        <h3>Gráfico Lipstick: Análisis de Valor vs. Objetivo</h3>
        <div class="row align-items-center mt-4">
          <div class="col-md-6 order-md-2 mb-4 mb-md-0">
            <div class="video-container">
              <video
                autoplay
                muted
                loop
                playsinline
                class="img-fluid rounded shadow"
                aria-label="Demo de Visualización Lipstick"
              >
                <source
                  src="/assets/imgs/Projects/lookerstudio_lipstick_viz.webm"
                  type="video/webm"
                />
                <source
                  src="/assets/imgs/Projects/lookerstudio_lipstick_viz_optimized.mp4"
                  type="video/mp4"
                />
                Tu navegador no soporta el formato de video.
              </video>
            </div>
          </div>
          <div class="col-md-6 order-md-1">
            <p>
              La <strong>Visualización Lipstick</strong> es una herramienta potente
              diseñada para comparar el rendimiento actual frente a objetivos específicos.
              Es excelente para desglosar métricas a través de varias dimensiones;
              por ejemplo, comparar los <em>Ingresos Reales</em> de diferentes regiones
              con sus <em>Objetivos Esperados</em>.
            </p>
            <p>
              Al combinar múltiples puntos de datos en un solo elemento gráfico,
              proporciona una visión completa de un vistazo:
            </p>
            <ul>
              <li>
                <strong>Porcentaje de Cumplimiento:</strong> Progreso visual hacia
                la meta.
              </li>
              <li>
                <strong>Valor Real de la Métrica:</strong> La cifra absoluta actual.
              </li>
              <li>
                <strong>Valor Objetivo:</strong> El punto de referencia o presupuesto.
              </li>
              <li>
                <strong>Variación Absoluta:</strong> La brecha calculada entre ambos
                valores.
              </li>
            </ul>
            <p class="text-muted small">
              Esta visualización reemplaza efectivamente la necesidad de tener
              gráficos de barras y tablas de datos por separado al consolidar
              todos los indicadores de rendimiento en un componente interactivo
              y simplificado.
            </p>
          </div>
        </div>
      </div>

      <div class="viz-list">
        <h3>Jerarquía de Árbol en Acción</h3>
        <div class="row align-items-center mt-4">
          <div class="col-md-6 mb-4 mb-md-0">
            <div class="video-container">
              <video
                autoplay
                muted
                loop
                playsinline
                class="img-fluid rounded shadow"
                aria-label="Demo de Visualización Jerarquía de Árbol"
                poster="/assets/imgs/Projects/tree_hierarchy_viz.png"
              >
                <source
                  src="/assets/imgs/Projects/lookerstudio_tree_hierarchy_viz.webm"
                  type="video/webm"
                />
                <source
                  src="/assets/imgs/Projects/lookerstudio_tree_hierarchy_viz_optimized.mp4"
                  type="video/mp4"
                />
                Tu navegador no soporta el formato de video.
              </video>
            </div>
          </div>
          <div class="col-md-6">
            <p>
              La visualización de <strong>Jerarquía de Árbol</strong> permite a los
              usuarios navegar a través de estructuras de datos multinivel de manera
              intuitiva. Al hacer clic en los nodos, los usuarios pueden profundizar
              en categorías específicas, mientras que las transiciones fluidas ayudan
              a mantener el contexto.
            </p>
            <p class="text-muted small">
              Este video muestra las capacidades de desglose, el diseño
              adaptable y las funciones interactivas de selección de nodos de la
              estructura de árbol.
            </p>
          </div>
        </div>
      </div>

      <div class="viz-list">
        <h3>¿Por qué usar visualizaciones personalizadas de la comunidad?</h3>
        <p>
          Aunque Google Looker Studio ofrece un conjunto robusto de gráficos
          predeterminados, algunas estructuras de datos complejas requieren
          enfoques visuales especializados.
          <strong>Las visualizaciones personalizadas de la comunidad</strong> llenan
          este vacío al permitir a los desarrolladores crear gráficos únicos e interactivos
          utilizando
          <a href="https://d3js.org/" target="_blank" rel="noopener noreferrer"
            >D3.js</a
          >
          y la
          <a
            href="https://developers.google.com/looker-studio/visualization"
            target="_blank"
            rel="noopener noreferrer">API DSCC</a
          >.
        </p>
        <p>Los beneficios clave incluyen:</p>
        <ul>
          <li>
            <strong>Informes con Marca:</strong> Adapta el estilo de tus datos para
            que coincida con tu identidad de marca.
          </li>
          <li>
            <strong>Interacción Avanzada:</strong> Implementa comportamientos complejos
            de desglose y filtrado cruzado.
          </li>
          <li>
            <strong>Gráficos Especializados:</strong> Utiliza gráficos no estándar
            como Jerarquías de Árbol o gráficos Lipstick para una comunicación más
            efectiva.
          </li>
        </ul>
      </div>

      <div class="viz-list">
        <h3>Preguntas Frecuentes</h3>
        <div class="faq-item mt-4">
          <h5>
            1. ¿Qué es una visualización de la comunidad de Looker Studio?
          </h5>
          <p>
            Es un gráfico de terceros desarrollado utilizando la API de
            visualización de la comunidad de Google Looker Studio. Permite el
            renderizado y la interacción personalizados que van más allá de los
            componentes incorporados estándar.
          </p>
        </div>
        <div class="faq-item mt-3">
          <h5>2. ¿Cómo instalo estas visualizaciones personalizadas?</h5>
          <p>
            Puedes agregarlas a tu informe utilizando el icono "Visualizaciones
            y componentes de la comunidad" en la barra de herramientas de Looker
            Studio y pegando la ruta del manifiesto proporcionada (disponible
            bajo peticion).
          </p>
        </div>
        <div class="faq-item mt-3">
          <h5>3. ¿Son estas visualizaciones responsivas?</h5>
          <p>
            Sí, todas las visualizaciones que se muestran aquí están diseñadas
            para ser totalmente responsivas y adaptarse al tamaño del contenedor
            dentro de tu informe de Looker Studio.
          </p>
        </div>
      </div>

      <div class="viz-list">
        <h3>Detalles Técnicos</h3>
        <p>
          Estas visualizaciones están construidas utilizando la
          <a
            href="https://developers.google.com/looker-studio/visualization"
            target="_blank"
            rel="noopener noreferrer"
          >
            API de Visualización de la Comunidad de Looker Studio (DSCC)
          </a>
          con JavaScript y D3.js para el renderizado. Están diseñadas para ser altamente
          configurables a través del panel de estilo de Looker Studio.
        </p>
        <p>
          <strong>Tecnologías y habilidades:</strong> JavaScript, D3.js, API DSCC,
          Visualización de Datos, CSS.
        </p>
      </div>
    </div>
  </div>
</MainLayout>

<div
  style="background: linear-gradient(to bottom, #ffffff 0%, #f0eee9 300px, #f0eee9 100%); width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; padding: 4rem 0;"
>
  <div class="looker-container">
    <div class="container">
      <h3>Aplicación en el Mundo Real: Monitorización de Rendimiento</h3>
      <p
        class="lead"
        style="text-align: left; margin: 0 0 1rem 0; color: #212529;"
      >
        Utilizo estos componentes para visualizar datos de formas que son
        imposibles con los gráficos nativos. El <strong
          >Gráfico Cleveland</strong
        >, por ejemplo, me permite rastrear distribuciones de rendimiento en una
        sola vista, mientras que las herramientas estándar requerirían múltiples
        gráficos separados para transmitir la misma información.
      </p>

      <p>
        Visualiza las puntuaciones diarias de <strong>PageSpeed Insights</strong
        >, permitiendo una identificación rápida de tendencias de rendimiento y
        la distribución de métricas de Core Web Vitals.
      </p>

      <div class="row mt-4">
        <div class="col-md-6 mb-4">
          <figure class="text-center">
            <div
              class="shadow rounded overflow-hidden d-inline-block"
              style="background: white;"
            >
              <Image
                src={performanceImg}
                alt="Gráfico Cleveland mostrando distribución de puntuaciones de rendimiento"
                class="img-fluid"
              />
            </div>
            <figcaption class="text-muted small mt-2">
              Distribución de puntuaciones de rendimiento visualizada con
              Gráfico Cleveland
            </figcaption>
          </figure>
        </div>
        <div class="col-md-6 mb-4">
          <figure class="text-center">
            <div
              class="shadow rounded overflow-hidden d-inline-block"
              style="background: white;"
            >
              <Image
                src={bestPracticesImg}
                alt="Gráfico Cleveland mostrando puntuaciones de mejores prácticas en el tiempo"
                class="img-fluid"
              />
            </div>
            <figcaption class="text-muted small mt-2">
              Seguimiento de métricas de Mejores Prácticas
            </figcaption>
          </figure>
        </div>
      </div>

      <div class="text-center mt-4 mb-5">
        <a
          href="/es/projects/webanalytics/"
          class="btn btn-primary btn-lg shadow-sm"
        >
          Ver Panel de Analítica Web <i class="fas fa-arrow-right ml-2"></i>
        </a>
      </div>
    </div>
  </div>
</div>
