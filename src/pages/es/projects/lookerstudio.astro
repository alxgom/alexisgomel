---
import MainLayout from "../../../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/projects/lookerstudio/";
---

<MainLayout
  title="Visualizaciones de la Comunidad de Looker Studio | Alexis Gomel"
  description="Visualizaciones personalizadas de la comunidad para Looker Studio, incluyendo jerarquía de árbol, histograma y gráficos de lápiz labial."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <meta
    slot="head"
    name="description"
    content="Visualizaciones personalizadas de la comunidad para Looker Studio. Explora visualizaciones interactivas de jerarquía de árbol, histograma y gráficos de lápiz labial construidos con JavaScript y DSCC."
  />
  <meta
    slot="head"
    name="keywords"
    content="Looker Studio, Visualizaciones de la Comunidad, Visualización de Datos, Jerarquía de Árbol, Histograma, Gráfico de Lápiz Labial, DSCC, JavaScript"
  />
  <meta
    slot="head"
    property="og:title"
    content="Visualizaciones de la Comunidad de Looker Studio | Alexis Gomel"
  />
  <meta
    slot="head"
    property="og:description"
    content="Visualizaciones personalizadas de la comunidad para Looker Studio, incluyendo jerarquía de árbol, histogramas y gráficos de lápiz labial."
  />
  <meta
    slot="head"
    property="og:image"
    content="/assets/imgs/Projects/tree_hierarchy_viz.png"
  />
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />

  <style>
    .looker-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .section-title {
      text-align: center;
      margin-bottom: 1rem;
    }

    .lead {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 2rem auto;
    }

    .report-frame {
      width: 100%;
      max-width: 1000px;
      margin: 2rem auto;
      display: block;
      border: none;
      border-radius: 8px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .viz-list {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid #eee;
    }

    .viz-list h3 {
      margin-bottom: 1rem;
    }

    .viz-list ul {
      list-style: disc;
      padding-left: 1.5rem;
    }

    .viz-list li {
      margin-bottom: 0.5rem;
    }
  </style>

  <div class="looker-container">
    <div class="container mt-5 pt-5">
      <h1 class="section-title">
        Visualizaciones de la Comunidad de Looker Studio
      </h1>
      <p class="lead text-muted">
        Visualizaciones personalizadas de la comunidad que he desarrollado para
        Google Looker Studio, extendiendo sus capacidades con tipos de gráficos
        especializados para una mejor narrativa de datos.
      </p>

      <iframe
        class="report-frame"
        width="100%"
        height="600"
        src="https://lookerstudio.google.com/embed/reporting/7f1ad7dc-2ae4-4e72-be31-b588c9890fa9/page/p_8m1usmbk0d"
        frameborder="0"
        style="border:0"
        allowfullscreen
        sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
      ></iframe>

      <div class="viz-list">
        <h3>Visualizaciones Incluidas</h3>
        <div class="row align-items-center mt-4">
          <div class="col-md-6">
            <ul>
              <li>
                <strong>Jerarquía de Árbol</strong> - Una visualización jerárquica
                para mostrar estructuras de datos de varios niveles con capacidades
                de desglose (drill-down).
              </li>
              <li>
                <strong>Histograma</strong> - Un histograma personalizable con opciones
                de orientación, escala logarítmica y visibilidad de ejes.
              </li>
              <li>
                <strong>Gráfico de Lápiz Labial (Lipstick Chart)</strong> - Un tipo
                de gráfico especializado para comparar valores con un estilo visual
                distintivo.
              </li>
            </ul>
            <p class="text-muted small mt-3">
              El video demuestra las características interactivas de la
              visualización de Lápiz Labial, incluyendo personalización de
              colores, filtrado cruzado y redimensionamiento dinámico.
            </p>
          </div>
          <div class="col-md-6 mb-4 mb-md-0">
            <div class="video-container">
              <video
                autoplay
                muted
                loop
                playsinline
                class="img-fluid rounded shadow"
                aria-label="Demo de Visualización Lipstick"
              >
                <source
                  src="/assets/imgs/Projects/lookerstudio_lipstick_viz.webm"
                  type="video/webm"
                />
                <source
                  src="/assets/imgs/Projects/lookerstudio_lipstick_viz_optimized.mp4"
                  type="video/mp4"
                />
                Tu navegador no soporta el formato de video.
              </video>
            </div>
          </div>
        </div>
      </div>

      <div class="viz-list">
        <h3>Detalles Técnicos</h3>
        <p>
          Estas visualizaciones están construidas utilizando la
          <a
            href="https://developers.google.com/looker-studio/visualization"
            target="_blank"
            rel="noopener noreferrer"
          >
            API de Visualización de la Comunidad de Looker Studio (DSCC)
          </a>
          con JavaScript y D3.js para el renderizado. Están diseñadas para ser altamente
          configurables a través del panel de estilo de Looker Studio.
        </p>
        <p>
          <strong>Tecnologías y habilidades:</strong> JavaScript, D3.js, API DSCC,
          Visualización de Datos, CSS.
        </p>
      </div>
    </div>
  </div>
</MainLayout>
