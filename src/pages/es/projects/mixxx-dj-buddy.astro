---
import MainLayout from "../../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import mainScreenshot from "../../../assets/imgs/Projects/mixxx_dj_buddy_main.png";
import settingsScreenshot from "../../../assets/imgs/Projects/mixxx_dj_buddy_settings.png";
import einkCloseup from "../../../assets/imgs/Projects/eink_mixxx_display_closeup.jpg";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/projects/mixxx-dj-buddy/";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Mixxx DJ Buddy",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows",
  description:
    "Una aplicación complementaria para Mixxx que rastrea tendencias de BPM e historial de tracks, ayudando a los DJs a mantener el pulso durante eventos de baile social.",
  url: "https://alexisgomel.com/es/projects/mixxx-dj-buddy/",
  downloadUrl: "https://github.com/alxgom/Mixxx-dj-buddy/releases",
  author: {
    "@type": "Person",
    name: "Alexis Gomel",
    url: "https://alexisgomel.com/es/",
  },
  keywords:
    "Mixxx companion, visualizador de set de DJ, gráfico BPM, DJ swing blues, herramienta DJ en vivo, app Go, software DJ de código abierto",
});
---

<MainLayout
  title="Visualiza el flujo de tu set de DJ en tiempo real con Mixxx DJ Buddy | Alexis Gomel"
  description="Mixxx DJ Buddy es una app en tiempo real para Mixxx. Rastrea tu flujo de BPM, organiza crates y mantén la energía de tu set sin distracciones."
  currentLang={currentLang}
  alternateHref={alternateHref}
  image="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
>
  <meta
    slot="head"
    name="keywords"
    content="Mixxx companion app, visualizador set de DJ, gráfico BPM en vivo, herramienta DJ swing blues, software DJ código abierto, app Go escritorio, DJ baile social"
  />
  <link
    rel="preload"
    as="image"
    href={mainScreenshot.src}
    slot="head"
    fetchpriority="high"
  />
  <link
    rel="preload"
    as="image"
    href="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
    slot="head"
  />
  <script type="application/ld+json" set:html={schema} slot="head" />
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://alexisgomel.com/es/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Proyectos",
          "item": "https://alexisgomel.com/es/projects/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Mixxx DJ Buddy",
          "item": "https://alexisgomel.com/es/projects/mixxx-dj-buddy/"
        }
      ]
    }
  </script>

  <style>
    /* ── Layout ────────────────────────────────────── */
    .buddy-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.25rem;
    }

    /* ── Hero ──────────────────────────────────────── */
    .buddy-hero {
      padding: 8rem 1rem 6rem;
      background: var(--cloud-dance-white);
      position: relative;
      overflow: hidden;
    }
    .buddy-hero::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: radial-gradient(var(--light-gray) 1px, transparent 1px);
      background-size: 30px 30px;
      opacity: 0.2;
      pointer-events: none;
    }
    .buddy-hero .eyebrow {
      font-family: var(--font-family-monospace);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: 1rem;
      display: block;
    }
    .buddy-hero h1 {
      font-size: clamp(2.2rem, 6vw, 3.8rem);
      font-weight: 900;
      line-height: 1.05;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
    }
    .buddy-hero .lead {
      max-width: 620px;
      margin: 0 0 2.5rem;
      font-size: 1.2rem;
      color: var(--dark-gray);
      line-height: 1.6;
    }
    .btn-hero-primary {
      display: inline-block;
      background: var(--primary);
      color: #fff;
      font-weight: 700;
      padding: 0.9rem 2rem;
      border-radius: 0; /* Sharp corner */
      text-decoration: none;
      transition: all 0.2s ease;
      margin-right: 1rem;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.9rem;
      box-shadow: 6px 6px 0px var(--dark);
      border: 1px solid var(--dark);
    }
    .btn-hero-primary:hover {
      background: var(--dark);
      color: #fff;
      transform: translate(-2px, -2px);
      box-shadow: 8px 8px 0px var(--primary);
    }
    .btn-hero-outline {
      display: inline-block;
      border: 1px solid var(--dark-gray);
      color: var(--dark-gray);
      font-weight: 700;
      padding: 0.9rem 2rem;
      border-radius: 0; /* Sharp corner */
      text-decoration: none;
      transition: all 0.2s ease;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.9rem;
      box-shadow: 6px 6px 0px var(--light-gray);
    }
    .btn-hero-outline:hover {
      border-color: var(--primary);
      color: var(--primary);
      transform: translate(-2px, -2px);
      box-shadow: 8px 8px 0px var(--albero-pantone);
    }

    /* ── Section dividers ──────────────────────────── */
    .buddy-section {
      padding: 5rem 0;
      border-top: 1px solid var(--light-gray);
    }
    .buddy-section p a {
      color: var(--primary);
      text-decoration: underline;
      font-weight: 600;
    }
    .buddy-section p a:hover {
      color: var(--dark);
    }
    .buddy-section h2 {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      letter-spacing: -0.01em;
    }
    .buddy-section h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    /* ── Story quote ───────────────────────────────── */
    .story-quote {
      border-left: 2px solid var(--primary);
      padding: 1.5rem 2rem;
      margin: 2rem 0;
      font-style: italic;
      color: var(--dark-gray);
      background: var(--cloud-dance-white);
      font-size: 1.1rem;
    }

    /* ── Features grid ─────────────────────────────── */
    .features-row {
      display: grid;
      gap: 2.5rem;
      margin-top: 2.5rem;
    }
    .features-row-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .features-row-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .feature-item {
      padding: 2rem 0;
      border-top: 1px solid var(--light-gray);
      transition: border-color 0.3s;
    }
    .feature-item:hover {
      border-top-color: var(--primary);
    }
    .feature-item h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .feature-item p {
      color: #666;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .feature-item-img {
      margin-top: 1.5rem;
      overflow: hidden;
      border: 1px solid var(--light-gray);
      background: #000;
    }
    .feature-item-img img {
      display: block;
      width: 100%;
      opacity: 0.9;
    }

    /* ── Video ─────────────────────────────────────── */
    .demo-video {
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
      border: 1px solid var(--dark);
      box-shadow: 20px 20px 0px var(--albero-pantone);
      display: block;
      transition: all 0.3s ease;
    }
    .demo-video:hover {
      transform: translate(-4px, -4px);
      box-shadow: 24px 24px 0px var(--albero-pantone);
    }

    /* ── Screenshots ───────────────────────────────── */
    .screenshot-frame {
      overflow: hidden;
      box-shadow: 20px 20px 0px var(--albero-pantone);
      border: 1px solid var(--dark);
      background: #000;
      transition: all 0.3s ease;
    }
    .screenshot-frame:hover {
      transform: translate(-4px, -4px);
      box-shadow: 24px 24px 0px var(--albero-pantone);
    }
    .screenshot-frame img {
      display: block;
      width: 100%;
      filter: grayscale(0.2) contrast(1.1);
      transition: all 0.4s ease;
    }
    .screenshot-frame:hover img {
      filter: grayscale(0) contrast(1.1);
      transform: scale(1.02);
    }
    .hero-frame {
      transform: perspective(1000px) rotateY(-8deg) rotateX(2deg) skewY(1deg);
    }
    .hero-frame:hover {
      transform: perspective(1000px) rotateY(-2deg) rotateX(1deg) translate(-4px, -4px) !important;
    }

    /* ── Tech badges ───────────────────────────────── */
    .tech-badge {
      display: inline-block;
      border: 1px solid var(--light-gray);
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
      font-family: var(--font-family-monospace);
      font-weight: 500;
      margin: 0.25rem 0.2rem;
      color: var(--dark-gray);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* ── CTA cards ─────────────────────────────────── */
    .display-cta {
      margin-top: 5rem;
      padding: 5rem 1.25rem;
      border-top: 1px solid var(--light-gray);
      background: var(--cloud-dance-white);
    }
    .display-cta-inner {
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
    }
    .display-cta h2 {
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
    }
    .display-cta .lead {
      max-width: 600px;
      margin: 0 auto 3rem;
      color: var(--dark-gray);
      font-size: 1.05rem;
    }
    .cta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      text-align: left;
    }
    .cta-card {
      border: 1px solid var(--dark);
      padding: 2.5rem 2rem;
      background: #fff;
      display: flex;
      flex-direction: column;
      height: 100%;
      box-shadow: 8px 8px 0px var(--light-gray);
      transition: all 0.3s ease;
    }
    .cta-card:hover {
      transform: translate(-4px, -4px);
      box-shadow: 12px 12px 0px var(--primary);
      border-color: var(--dark);
    }
    .cta-label {
      font-family: var(--font-family-monospace);
      font-size: 0.75rem;
      color: var(--primary);
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 0.5rem;
      display: block;
    }
    .cta-card h3 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .cta-card p {
      font-size: 0.9rem;
      color: #666;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }
    .cta-link {
      font-family: var(--font-family-monospace);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--dark);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: inline-flex;
      align-items: center;
      transition: all 0.2s ease;
      border-bottom: 2px solid transparent;
      padding-bottom: 2px;
      align-self: flex-start;
    }
    .cta-link:hover {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    /* ── Future plans list ─────────────────────────── */
    .future-list li {
      margin-bottom: 0.6rem;
      padding-left: 0.25rem;
    }

    /* ── Setup Steps - Anti-AI UI elements ────────── */
    .setup-steps {
      list-style: none;
      padding: 0;
      margin: 2rem 0;
    }
    .setup-step-item {
      display: flex;
      align-items: flex-start;
      margin-bottom: 2rem;
    }
    .setup-step-num {
      font-family: var(--font-family-monospace);
      font-weight: 900;
      color: var(--primary);
      font-size: 1.25rem;
      width: 45px;
      flex-shrink: 0;
      line-height: 1;
      padding-top: 2px;
    }
    .setup-step-content {
      border-left: 2px solid var(--light-gray);
      padding-left: 1.5rem;
    }
    .setup-step-content h3 {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    .setup-step-content p {
      font-size: 0.95rem;
      color: #666;
      margin: 0;
      line-height: 1.5;
    }

    /* ── Remote Display callout ─────────────────────── */
    .remote-display-callout {
      background: var(--dark);
      padding: 5rem 0;
      border-top: none;
    }
    .remote-display-callout h2 {
      color: #fff;
    }
    .remote-display-callout .eyebrow {
      color: var(--albero-pantone);
    }
    .remote-display-callout p {
      color: rgba(255,255,255,0.75);
    }
    .remote-display-callout p a {
      color: var(--albero-pantone) !important;
      text-decoration: underline;
    }
    .remote-display-callout .btn-hero-outline {
      color: #fff;
      border-color: rgba(255,255,255,0.5);
      box-shadow: 6px 6px 0px rgba(255,255,255,0.15);
    }
    .remote-display-callout .btn-hero-outline:hover {
      color: var(--albero-pantone);
      border-color: var(--albero-pantone);
      box-shadow: 8px 8px 0px rgba(255,255,255,0.1);
    }

    @media (max-width: 767px) {
      .buddy-hero {
        padding: 6rem 1rem 4rem;
        text-align: left;
      }
      .display-cta {
        padding: 2rem 1rem;
      }
      .features-row-3,
      .features-row-2 {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <div class="buddy-hero">
    <div class="buddy-container">
      <div class="row align-items-center text-start">
        <div class="col-lg-6">
          <p class="eyebrow">Herramienta de DJ de código abierto para Mixxx</p>
          <h1>Mixxx DJ Buddy visualiza tu set de DJ en tiempo real.</h1>
          <p class="lead">
            Mixxx DJ Buddy es una aplicación complementaria en tiempo real para
            <a href="https://mixxx.org/" target="_blank" rel="noopener noreferrer"
              >Mixxx</a
            >. Rastrea tu flujo de BPM a medida que tocas, muestra las crates detrás de cada canción e incluye un servidor de transmisión para pantallas remotas.
          </p>
          <div class="hero-actions">
            <a
              href="https://github.com/alxgom/Mixxx-dj-buddy/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-hero-primary gtm-track-click"
              data-event-category="Mixxx DJ Buddy ES"
              data-event-label="Hero - Descargar"
            >
              Descargar (.exe)
            </a>
            <a
              href="https://github.com/alxgom/Mixxx-dj-buddy"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-hero-outline gtm-track-click"
              data-event-category="Mixxx DJ Buddy ES"
              data-event-label="Hero - GitHub"
            >
              Ver en GitHub
            </a>
          </div>
        </div>
        <div class="col-lg-6 mt-5 mt-lg-0">
          <div class="screenshot-frame hero-frame">
            <Image
              src={mainScreenshot}
              alt="Interfaz principal de Mixxx DJ Buddy que muestra un gráfico de BPM con el tema Jazzy Light"
              class="img-fluid"
              loading="eager"
              width={600}
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="buddy-container">
    <!-- ─── THE STORY ────────────────────────────────────────── -->
    <section class="buddy-section">
      <h2>De una libreta a un visualizador en tiempo real</h2>
      <p>
        Cuando empecé a pinchar música para fiestas de swing y blues como
        <strong>Dr. Beat</strong>, llevaba una pequeña libreta junto a los
        platos para esbozar el arco de BPM de mi set. Era un mapa aproximado de
        la energía que intentaba construir, liberar y reconstruir durante la
        noche.
      </p>
      <div class="story-quote">
        "Miro la pista de baile y reacciono. Pero también me gusta construir
        una historia — subir la energía, crear tensión, dejar que respire."
      </div>
      <!-- Video debajo de la historia — muestra el gráfico en vivo -->
      <div class="mt-4 mb-4">
        <video
          autoplay
          muted
          loop
          playsinline
          class="demo-video"
          poster="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
          aria-label="Grabación de pantalla demostrativa de Mixxx DJ Buddy"
        >
          <source src="/assets/imgs/Projects/mixxx_dj_buddy.webm" type="video/webm" />
          <source src="/assets/imgs/Projects/mixxx_dj_buddy_optimized.mp4" type="video/mp4" />
          Tu navegador no soporta el formato de video.
        </video>
        <p class="text-muted small mt-3 text-center">
          El gráfico se actualiza en vivo con cada track. Pasa el cursor por
          cualquier punto para ver los crates y playlists de esa canción — los
          crates compartidos con el track anterior se destacan automáticamente.
        </p>
      </div>
      <p>
        Mixxx DJ Buddy convirtió esa libreta en un gráfico en vivo. Lee
        directamente de la base de datos SQLite de
        <a
          href="https://mixxx.org/"
          target="_blank"
          rel="noopener noreferrer">Mixxx</a
        >
        y se actualiza automáticamente con cada track. No requiere entradas manuales ni
        interrupciones en el flujo.
      </p>
      <p>
        El BPM solo no captura todo, pero es un punto de partida sólido.
        La capa de crates y playlists lo hace genuinamente útil para tomar
        decisiones durante el set. Las versiones futuras irán más allá con
        métricas de audio perceptuales.
      </p>
    </section>

    <!-- ─── FEATURES ─────────────────────────────────────────── -->
    <section class="buddy-section">
      <h2>Funciones principales</h2>

      <!-- Fila 1: tres funciones solo texto -->
      <div class="features-row features-row-3">
        <div class="feature-item">
          <h3>Gráfico de BPM en vivo</h3>
          <p>
            Un gráfico de líneas impulsado por D3.js que se actualiza en tiempo
            real con cada nuevo track. Ve el arco de energía de tu set de un
            vistazo — subidas, descansos y recuperaciones.
          </p>
        </div>

        <div class="feature-item">
          <h3>Tooltip de Crates y Playlists</h3>
          <p>
            Pasa el cursor o haz clic en cualquier punto para ver a qué
            <strong>crates</strong> (tus categorías personales — big band, vocales,
            energía, cierres…) y <strong>playlists</strong> pertenece ese track. Los
            crates compartidos con el track anterior se resaltan para identificar
            hilos temáticos durante el set.
          </p>
        </div>

        <div class="feature-item">
          <h3>Siempre visible</h3>
          <p>
            Activa el modo "pin" para que la ventana permanezca sobre Mixxx —
            ideal cuando pinchás en una sola pantalla de laptop. Maximiza el
            gráfico para tener más espacio cuando lo necesites.
          </p>
        </div>
      </div>

      <!-- Fila 2: funciones con capturas de pantalla -->
      <div class="features-row features-row-2">
        <div class="feature-item">
          <h3>Temas</h3>
          <p>
            Alterna entre un tema oscuro predeterminado y el vibrante tema
            <strong>Jazzy Light</strong> — colores expresivos inspirados en el espíritu
            de libertad del jazz.
          </p>
          <div class="feature-item-img">
            <Image
              src={mainScreenshot}
              alt="Interfaz principal de Mixxx DJ Buddy — tema Jazzy Light con gráfico de BPM y logo de vinilo"
              class="img-fluid"
              width={500}
            />
          </div>
          <p class="text-muted small mt-2">Interfaz principal — tema Jazzy Light</p>
        </div>

        <div class="feature-item">
          <h3>Configuración persistente</h3>
          <p>
            Todas tus preferencias (tema, siempre visible, ejes, modo tooltip)
            se guardan y restauran automáticamente entre sesiones.
          </p>
          <div class="feature-item-img">
            <Image
              src={settingsScreenshot}
              alt="Panel de configuración de Mixxx DJ Buddy mostrando opciones de ejes, always-on-top, tema y selector de info del tooltip"
              class="img-fluid"
              width={500}
            />
          </div>
          <p class="text-muted small mt-2">Panel de configuración — tema oscuro</p>
        </div>
      </div>
    </section>

    <!-- ─── REMOTE DISPLAY CALLOUT ───────────────────────────── -->
    <section class="buddy-section remote-display-callout">
      <div class="row align-items-center">
        <div class="col-md-6">
          <span class="eyebrow">Extensión inalámbrica opcional</span>
          <h2>Transmite a Mixxx Remote Display</h2>
          <p>
            DJ Buddy puede transmitir inalámbricamente datos de tracks y portadas a
            <a href="/es/projects/mixxx-remote-display/">Mixxx Remote Display</a> — una
            app Android que convierte un teléfono libre en una pantalla de sala.
            Desarrollado como proyecto complementario, está diseñado para eventos de baile social
            donde el público quiere saber qué está sonando.
          </p>
          <a
            href="/es/projects/mixxx-remote-display/"
            class="btn-hero-outline gtm-track-click"
            data-event-category="Mixxx DJ Buddy ES"
            data-event-label="Remote Display Callout"
          >
            Ver Mixxx Remote Display →
          </a>
        </div>
        <div class="col-md-6 mt-4 mt-md-0">
          <div class="screenshot-frame">
            <Image
              src={einkCloseup}
              alt="Mixxx Remote Display mostrando información de pista en una pantalla e-ink en un evento de baile"
              class="img-fluid"
              width={500}
            />
          </div>
        </div>
      </div>
    </section>


    <!-- ─── CÓMO FUNCIONA ─────────────────────────────────────── -->
    <section class="buddy-section">
      <div class="row align-items-center">
        <div class="col-md-6">
          <h2>Cómo funciona</h2>
          <p>
            Mixxx guarda su historial en una base de datos SQLite local (<code
              >mixxxdb.sqlite</code
            >). DJ Buddy consulta esta base periódicamente para detectar los
            tracks recién reproducidos — sin conexión a internet, sin cuenta
            necesaria.
          </p>
          <p>
            El gráfico se renderiza con <strong>D3.js</strong>, mientras que el
            backend en Go gestiona la lectura de la base de datos. Si se activa,
            también actúa como un servidor <strong>Bluetooth RFCOMM</strong> para
            transmitir los metadatos de los tracks.
          </p>
          <p>
            Esta arquitectura permite que la aplicación sea rápida y autocontenida.
            Funciona como un único <code>.exe</code> sin necesidad de un entorno
            Python o configuraciones complejas.
          </p>
          <p>
            Detecta automáticamente la ubicación predeterminada de
            <code>mixxxdb.sqlite</code> según tu sistema operativo — simplemente haz
            doble clic para empezar.
          </p>
