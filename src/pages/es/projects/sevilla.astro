---
import MainLayout from "../../../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/projects/sevilla";

// PALETTE DATA
const sevillePalette = [
  { name: "Almegre Red", hex: "#A50034" },
  { name: "Triana Green", hex: "#115740" },
  { name: "Lapiz Lazuli", hex: "#26619C" },
  { name: "Albero Pantone", hex: "#FFAB60" },
  { name: "White", hex: "#FFFFFF" },
  { name: "Cloud Dance", hex: "#F0EEE9" },
  { name: "Light Gray", hex: "#D4D4D4" },
  { name: "Dark Gray", hex: "#434343" },
  { name: "Black", hex: "#000000" },
];
---

<MainLayout
  title="La Paleta de Sevilla | Alexis Gomel"
  description="Una visualización de datos de la paleta de colores inspirada en Sevilla."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <!-- SEO: Indexing Allowed -->
  <meta
    slot="head"
    name="description"
    content="Una visualización de datos de la paleta de colores inspirada en Sevilla, con análisis de contraste y simulaciones de daltonismo."
  />
  <meta
    slot="head"
    name="keywords"
    content="Sevilla, Paleta de Colores, Visualización de Datos, Accesibilidad, WCAG, Daltonismo, Diseño, D3.js"
  />
  <meta
    slot="head"
    property="og:title"
    content="La Paleta de Sevilla | Alexis Gomel"
  />
  <meta
    slot="head"
    property="og:description"
    content="Explora la paleta de colores accesible inspirada en Sevilla con visualizaciones interactivas."
  />
  <meta
    slot="head"
    property="og:image"
    content="/assets/imgs/Projects/sevilla_thumb.png"
  />
  <link rel="stylesheet" href="/assets/css/sevilla.css" slot="head" />

  <!-- D3.js -->
  <script is:inline src="https://d3js.org/d3.v7.min.js"></script>

  <div class="palette-container">
    <div class="text-center mb-5">
      <h1 class="section-title">La Paleta de Sevilla</h1>
      <p class="lead text-muted">
        Inspirada en los vibrantes colores de Sevilla, esta paleta categórica
        está diseñada para un contraste accesible.
      </p>
    </div>

    <div class="row mt-4 mb-5">
      <div class="col-md-3 mb-3">
        <div id="viz-bar" class="mini-viz"></div>
        <p class="text-center text-muted small mt-2">Gráfico de barras</p>
      </div>
      <div class="col-md-3 mb-3">
        <div id="viz-scatter" class="mini-viz"></div>
        <p class="text-center text-muted small mt-2">Dispersión</p>
      </div>
      <div class="col-md-3 mb-3">
        <div id="viz-box" class="mini-viz"></div>
        <p class="text-center text-muted small mt-2">Diagrama de caja</p>
      </div>
      <div class="col-md-3 mb-3">
        <div id="viz-spark" class="mini-viz"></div>
        <p class="text-center text-muted small mt-2">Minigráfico</p>
      </div>
    </div>

    <p class="text-center mt-4 mb-4">
      El núcleo de la paleta se compone de tres colores
    </p>

    <div class="palette-row">
      <div class="palette-card">
        <div class="palette-card-color" style="background-color: #A50034;">
        </div>
        <div class="palette-card-name">Almegre</div>
        <div class="palette-card-hex">#A50034</div>
      </div>
      <div class="palette-card">
        <div class="palette-card-color" style="background-color: #FFAB60;">
        </div>
        <div class="palette-card-name">Albero</div>
        <div class="palette-card-hex">#FFAB60</div>
      </div>
      <div class="palette-card">
        <div class="palette-card-color" style="background-color: #26619C;">
        </div>
        <div class="palette-card-name">Lapiz Lazuli</div>
        <div class="palette-card-hex">#26619C</div>
      </div>
    </div>

    <p class="text-center mt-4 mb-4">
      Y se complementa con una escala de grises.
    </p>

    <p style="max-width: 600px; margin: 0 auto;">
      Las conexiones representan pares con
      <strong>contraste aceptable</strong> (WCAG AA), revelando cómo estos matices
      distintos pueden trabajar juntos en armonía.
    </p>

    <!-- D3 Visualization Container -->
    <div id="d3-viz" class="viz-container">
      <div id="tooltip" class="tooltip"></div>
    </div>

    <!-- Contrast Matrix Section -->
    <section class="contrast-section mt-5 pt-5">
      <h2 class="text-center mb-3">Matriz de Contraste</h2>
      <p
        class="text-center text-muted mb-4"
        style="max-width: 600px; margin: 0 auto;"
      >
        Una referencia práctica para la accesibilidad. Los valores muestran las
        relaciones de contraste WCAG;
        <strong>negrita (✓)</strong> indica cumplimiento AA (≥ 4.5).
      </p>
      <div style="overflow-x: auto;">
        <table id="contrast-matrix" class="contrast-table">
          <!-- Generated by JS -->
        </table>
      </div>

      <!-- Color Blindness Simulation Section -->
      <section class="colorblind-section mt-5 pt-5">
        <h3 class="text-center mb-3">Simulación de Daltonismo</h3>
        <div class="text-center mb-4">
          <label class="toggle-switch">
            <input type="checkbox" id="accessible-toggle" />
            <span class="slider round"></span>
          </label>
          <span class="ml-2 text-muted" style="vertical-align: middle;"
            >Usar Verde Accesible (Triana) en lugar de Rojo (Almegre)</span
          >
        </div>
        <p
          class="text-center text-muted mb-4"
          style="max-width: 700px; margin: 0 auto;"
        >
          ¿Cómo aparece esta paleta para personas con diferentes tipos de
          deficiencia visual del color?
        </p>

        <!-- SVG Filters for Color Blindness -->
        <svg style="position: absolute; width: 0; height: 0;">
          <defs>
            <filter id="protanopia">
              <feColorMatrix
                type="matrix"
                values="0.567, 0.433, 0, 0, 0  0.558, 0.442, 0, 0, 0  0, 0.242, 0.758, 0, 0  0, 0, 0, 1, 0"
              ></feColorMatrix>
            </filter>
            <filter id="deuteranopia">
              <feColorMatrix
                type="matrix"
                values="0.625, 0.375, 0, 0, 0  0.7, 0.3, 0, 0, 0  0, 0.3, 0.7, 0, 0  0, 0, 0, 1, 0"
              ></feColorMatrix>
            </filter>
            <filter id="tritanopia">
              <feColorMatrix
                type="matrix"
                values="0.95, 0.05, 0, 0, 0  0, 0.433, 0.567, 0, 0  0, 0.475, 0.525, 0, 0  0, 0, 0, 1, 0"
              ></feColorMatrix>
            </filter>
          </defs>
        </svg>

        <div class="colorblind-grid">
          <!-- Normal Vision -->
          <div class="colorblind-card">
            <h4>Visión Normal</h4>
            <p class="stat">~92% de la población</p>
            <div id="swatches-normal"></div>
          </div>

          <!-- Deuteranopia -->
          <div class="colorblind-card">
            <h4>Deuteranopía</h4>
            <p class="stat">~6% de hombres | Ceguera al verde</p>
            <div id="swatches-deuteranopia" style="filter: url(#deuteranopia);">
            </div>
          </div>

          <!-- Protanopia -->
          <div class="colorblind-card">
            <h4>Protanopía</h4>
            <p class="stat">~1% de hombres | Ceguera al rojo</p>
            <div id="swatches-protanopia" style="filter: url(#protanopia);">
            </div>
          </div>

          <!-- Tritanopia -->
          <div class="colorblind-card">
            <h4>Tritanopía</h4>
            <p class="stat">~0.01% de la población | Ceguera al azul</p>
            <div id="swatches-tritanopia" style="filter: url(#tritanopia);">
            </div>
          </div>
        </div>
      </section>

      <!-- Photo Gallery Section -->
      <section class="photo-gallery mt-5 pt-5 inspiration-bg fade-in-section">
        <h2 class="text-center mb-4">La Inspiración</h2>
        <p
          class="text-center text-muted mb-5"
          style="max-width: 600px; margin: 0 auto;"
        >
          Este proyecto surgió mientras visitaba Andalucía con mi familia en
          diciembre de 2025. Al recorrer la ciudad de Sevilla y muchos pueblos
          en Andalucía, aprendí cómo muchos de los colores utilizados reflejan
          la rica historia de la zona.
        </p>
        <h3
          class="text-center text-muted mb-5"
          style="max-width: 600px; margin: 0 auto;"
        >
          Estos colores incluyen
        </h3>
        <ul>
          <li>
            <span class="inline-swatch" style="background-color: #FFAB60;"
            ></span>
            Albero: Proveniente de sedimentos del río Guadalquivir. Este tono específico
            se basa en realidad en el <b>Pantone "Flor de Sevilla"</b>, una
            interpretación más brillante del Albero tradicional desarrollada en
            colaboración con Tanqueray.
            <div class="mt-3 mb-3">
              <iframe
                width="560"
                height="315"
                src="https://www.youtube.com/embed/2vImZx_f0pg"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                style="max-width: 100%; height: auto; aspect-ratio: 16/9;"
              ></iframe>
            </div>
          </li>
          <li>
            <span class="inline-swatch" style="background-color: #A50034;"
            ></span>
            Almegre: La palabra proviene del árabe andalusí al-máḡra, que se origina
            del árabe al-maḡra (الْمَغْرَة), que significa "arcilla roja o tierra".
          </li>
          <li>
            <span class="inline-swatch" style="background-color: #26619C;"
            ></span>
            Lapiz lazuli: El azul de la paleta, refleja el valioso lapizlázuli azul
            importado por los árabes, y el azul utilizado en las muchas cerámicas
            que decoran Andalucía. También representa los cielos despejados generalmente
            presentes en Sevilla.
          </li>
          <li>
            <span class="inline-swatch" style="background-color: #115740;"
            ></span>
            Verde Triana: Un verde profundo que refleja el verde en la bandera de
            Andalucía, y el verde asociado con la "Esperanza de Triana". También simboliza
            el verde exuberante de los muchos árboles que habitan la ciudad.
            <b>Nota:</b> Este es un color opcional en la paleta, recomendado como
            reemplazo de Almegre (Rojo) cuando la accesibilidad para el daltonismo
            rojo-verde es una prioridad.
          </li>
        </ul>

        <p>
          La inspiración detrás de estos colores es una mezcla de la hermosa
          historia de la zona, que habla sobre la mezcla y convivencia de
          culturas a través de los tiempos.
        </p>
        <p>
          Esta idea también surgió gracias a la comprensión de que estos colores
          formaban una paleta muy agradable y accesible. Con saturaciones
          naturales apagadas y elecciones que pueden ser accesibles para
          audiencias daltónicas.
        </p>

        <ul>
          <li>
            Para terminar el núcleo de la paleta, agregué el color del año 2026
            de Pantone: "Cloud Dancer". Un blanco suave que invoca paz y
            tranquilidad. Haciéndolo un ajuste perfecto para una paleta
            inspirada en la convivencia de culturas en una región tan rica.
          </li>
        </ul>
        <a href="https://www.pantone.com/color-of-the-year/2026">
          https://www.pantone.com/color-of-the-year/2026
        </a>

        <p class="mt-4">
          Para construir una paleta secuencial usando estos colores, puedes usar
          el <a href="https://gka.github.io/palettes/" target="_blank"
            >Ayudante de Paleta de Colores Chroma.js</a
          >.
        </p>

        <p
          class="text-center text-muted mb-5"
          style="max-width: 600px; margin: 0 auto;"
        >
          Estas fotografías de mi viaje a Sevilla capturaron las texturas, la
          luz y el espíritu que inspiraron esta paleta.
        </p>
        <div class="gallery-grid">
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/oranges_tree_on_white_background.webp"
              alt="Árbol de naranjas sobre fondo blanco"
              loading="lazy"
            />
            <p class="caption">Árbol de naranjas sobre fondo blanco</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/wall_paint_and_sky.JPG"
              alt="Pintura de pared y cielo"
              loading="lazy"
            />
            <p class="caption">Pintura de pared y cielo</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/panorama_plaza_espana.webp"
              alt="Panorama Plaza España"
              loading="lazy"
            />
            <p class="caption">Panorama Plaza España</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/blue_and_yellow_tiles_on_red_floor.webp"
              alt="Azulejos azules y amarillos sobre suelo rojo"
              loading="lazy"
            />
            <p class="caption">Azulejos azules y amarillos sobre suelo rojo</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/white_and_blue_ceramic_decorations_on_columns.webp"
              alt="Decoraciones de cerámica blanca y azul en columnas"
              loading="lazy"
            />
            <p class="caption">
              Decoraciones de cerámica blanca y azul en columnas
            </p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/plaza_espana_lake_with_boats.webp"
              alt="Lago de Plaza España con barcas"
              loading="lazy"
            />
            <p class="caption">Lago de Plaza España con barcas</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/cordoba_cathedral_interior.jpg"
              alt="Interior de la catedral de Córdoba"
              loading="lazy"
            />
            <p class="caption">Interior de la catedral de Córdoba</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/little_street_cordoba.webp"
              alt="Callecita en Córdoba"
              loading="lazy"
            />
            <p class="caption">Callecita en Córdoba</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/orange_wall_and_green_leaves.webp"
              alt="Pared naranja y hojas verdes"
              loading="lazy"
            />
            <p class="caption">Pared naranja y hojas verdes</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/door_with_blue_and_white_ceramics.jpg"
              alt="Puerta con cerámicas azules y blancas"
              loading="lazy"
            />
            <p class="caption">Puerta con cerámicas azules y blancas</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/plaza_espana_dinamic_shot_with_ceramics_foreground.JPG"
              alt="Toma dinámica de Plaza España"
              loading="lazy"
            />
            <p class="caption">Toma dinámica de Plaza España</p>
          </div>
          <div class="gallery-item">
            <img
              src="/assets/imgs/palette/cordoba_cathedral_interior_2.webp"
              alt="Detalle interior de la catedral de Córdoba"
              loading="lazy"
            />
            <p class="caption">Detalle interior de la catedral de Córdoba</p>
          </div>
        </div>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ palette: sevillePalette }}>
    // --- Helper Functions ---
    function hexToRgb(hex) {
      const shorthandRegex = /^#?([a-f\d])([a-f\d])([a-f\d])$/i;
      hex = hex.replace(shorthandRegex, (m, r, g, b) => r + r + g + g + b + b);
      const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      return result
        ? {
            r: parseInt(result[1], 16),
            g: parseInt(result[2], 16),
            b: parseInt(result[3], 16),
          }
        : null;
    }

    function luminance(r, g, b) {
      const a = [r, g, b].map(function (v) {
        v /= 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      });
      return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
    }

    function calculateRatio(hex1, hex2) {
      const rgb1 = hexToRgb(hex1);
      const rgb2 = hexToRgb(hex2);
      if (!rgb1 || !rgb2) return 0;
      const lum1 = luminance(rgb1.r, rgb1.g, rgb1.b);
      const lum2 = luminance(rgb2.r, rgb2.g, rgb2.b);
      return (Math.max(lum1, lum2) + 0.05) / (Math.min(lum1, lum2) + 0.05);
    }

    // --- Visualization Setup ---
    const width = document.getElementById("d3-viz").offsetWidth;
    const height = 600;

    // 1. Prepare Nodes (Colors)
    const nodes = palette.map((d) => ({ ...d, id: d.name }));

    // 2. Prepare Links (Contrast Connections)
    const links = [];
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const ratio = calculateRatio(nodes[i].hex, nodes[j].hex);
        // Only connect if ratio meets WCAG AA Large (3.0) at minimum
        if (ratio >= 3.0) {
          links.push({
            source: nodes[i].id,
            target: nodes[j].id,
            ratio: ratio,
            strength: ratio >= 4.5 ? 1 : 0.3, // Stronger link for better contrast
          });
        }
      }
    }

    const svg = d3
      .select("#d3-viz")
      .append("svg")
      .attr("width", width)
      .attr("height", height)
      .attr("viewBox", [0, 0, width, height]);

    // Simulation
    const simulation = d3
      .forceSimulation(nodes)
      .force(
        "link",
        d3
          .forceLink(links)
          .id((d) => d.id)
          .distance(150),
      )
      .force("charge", d3.forceManyBody().strength(-300))
      .force("center", d3.forceCenter(width / 2, height / 2))
      .force("collide", d3.forceCollide().radius(40));

    // Draw Links
    const link = svg
      .append("g")
      .attr("stroke-opacity", 0.6)
      .selectAll("line")
      .data(links)
      .join("line")
      .attr("stroke", "#999")
      .attr("stroke-width", (d) => Math.sqrt(d.ratio)); // Thicker lines for better contrast

    // Draw Nodes
    const node = svg
      .append("g")
      .selectAll("circle")
      .data(nodes)
      .join("circle")
      .attr("r", 25)
      .attr("fill", (d) => d.hex)
      .attr("stroke", "#fff")
      .attr("stroke-width", 2)
      .attr("cursor", "grab")
      .call(drag(simulation));

    // Labels
    const label = svg
      .append("g")
      .selectAll("text")
      .data(nodes)
      .join("text")
      .text((d) => d.name)
      .attr("font-size", 12)
      .attr("text-anchor", "middle")
      .attr("dy", 40) // Below circle
      .attr("fill", "#333")
      .style("pointer-events", "none");

    // Tooltip Interactions
    const tooltip = d3.select("#tooltip");

    link
      .on("mouseover", (event, d) => {
        tooltip.style("opacity", 1);
        tooltip.html(`Ratio Contraste: <strong>${d.ratio.toFixed(2)}</strong>`);
        d3.select(event.target)
          .attr("stroke", "#333")
          .attr("stroke-opacity", 1);
      })
      .on("mousemove", (event) => {
        tooltip
          .style(
            "left",
            event.pageX - document.getElementById("d3-viz").offsetLeft + "px",
          )
          .style(
            "top",
            event.pageY -
              document.getElementById("d3-viz").offsetTop -
              40 +
              "px",
          );
      })
      .on("mouseout", (event, d) => {
        tooltip.style("opacity", 0);
        d3.select(event.target)
          .attr("stroke", "#999")
          .attr("stroke-opacity", 0.6);
      });

    node
      .on("mouseover", (event, d) => {
        d3.select(event.target).attr("stroke", "#333").attr("stroke-width", 4);
      })
      .on("mouseout", (event) => {
        d3.select(event.target).attr("stroke", "#fff").attr("stroke-width", 2);
      });

    // Simulation Tick
    simulation.on("tick", () => {
      link
        .attr("x1", (d) => d.source.x)
        .attr("y1", (d) => d.source.y)
        .attr("x2", (d) => d.target.x)
        .attr("y2", (d) => d.target.y);

      node.attr("cx", (d) => d.x).attr("cy", (d) => d.y);

      label.attr("x", (d) => d.x).attr("y", (d) => d.y);
    });

    // Drag Behavior
    function drag(simulation) {
      function dragstarted(event) {
        if (!event.active) simulation.alphaTarget(0.3).restart();
        event.subject.fx = event.subject.x;
        event.subject.fy = event.subject.y;
      }

      function dragged(event) {
        event.subject.fx = event.x;
        event.subject.fy = event.y;
      }

      function dragended(event) {
        if (!event.active) simulation.alphaTarget(0);
        event.subject.fx = null;
        event.subject.fy = null;
      }

      return d3
        .drag()
        .on("start", dragstarted)
        .on("drag", dragged)
        .on("end", dragended);
    }

    // --- Generate Contrast Matrix Table ---
    const table = document.getElementById("contrast-matrix");
    if (table) {
      // Header Row
      const headerRow = document.createElement("tr");
      const cornerTh = document.createElement("th");
      cornerTh.textContent = "FD \\ FN";
      headerRow.appendChild(cornerTh);
      palette.forEach((colColor) => {
        const th = document.createElement("th");
        th.textContent = colColor.name.split(" ")[0];
        th.style.writingMode = "vertical-rl";
        th.style.transform = "rotate(180deg)";
        th.style.height = "80px";
        th.style.fontSize = "11px";
        headerRow.appendChild(th);
      });
      table.appendChild(headerRow);

      // Data Rows
      palette.forEach((rowColor) => {
        const tr = document.createElement("tr");

        // Row Header
        const th = document.createElement("th");
        th.textContent = rowColor.name;
        th.style.textAlign = "right";
        th.style.whiteSpace = "nowrap";
        th.style.fontSize = "11px";
        tr.appendChild(th);

        palette.forEach((colColor) => {
          const td = document.createElement("td");
          const ratio = calculateRatio(rowColor.hex, colColor.hex);

          td.textContent = ratio.toFixed(2);
          td.style.backgroundColor = rowColor.hex;
          td.style.color = colColor.hex;
          td.style.fontWeight = ratio >= 4.5 ? "900" : "400";

          if (ratio >= 4.5) td.textContent += " ✓";

          td.title = `Fondo: ${rowColor.name}\nFrente: ${colColor.name}\nRatio: ${ratio.toFixed(2)}`;

          tr.appendChild(td);
        });
        table.appendChild(tr);
      });
    }

    // --- Populate Colorblind Swatch Rows ---
    document.addEventListener("DOMContentLoaded", () => {
      const toggle = document.getElementById("accessible-toggle");

      function renderSwatches() {
        const useAccessible = toggle.checked; // true = Green (Triana), false = Red (Almegre)

        // Filter palette based on toggle
        const currentPalette = palette.filter((c) => {
          if (c.name === "Triana Green") return useAccessible;
          if (c.name === "Almegre Red") return !useAccessible;
          return true;
        });

        const swatchContainers = [
          "swatches-normal",
          "swatches-deuteranopia",
          "swatches-protanopia",
          "swatches-tritanopia",
        ];

        swatchContainers.forEach((containerId) => {
          const container = document.getElementById(containerId);
          if (container) {
            container.innerHTML = ""; // Clear existing

            // Create rows
            const rowCore = document.createElement("div");
            rowCore.className = "swatch-row mb-2";

            const rowGray = document.createElement("div");
            rowGray.className = "swatch-row";

            currentPalette.forEach((color, index) => {
              const swatch = document.createElement("div");
              swatch.className = "swatch";
              swatch.style.backgroundColor = color.hex;
              swatch.title = color.name;

              if (index < 3) {
                rowCore.appendChild(swatch);
              } else {
                rowGray.appendChild(swatch);
              }
            });

            container.appendChild(rowCore);
            container.appendChild(rowGray);
          }
        });
      }

      // Initial render
      renderSwatches();

      // Toggle listener
      toggle.addEventListener("change", renderSwatches);
    });

    // --- Minimal Plots D3 Logic ---
    document.addEventListener("DOMContentLoaded", () => {
      const coreColors = ["#A50034", "#FFAB60", "#26619C"]; // Almegre, Albero, Lapiz
      const width = 250;
      const height = 150;
      const margin = 10;

      // 1. Bar Plot
      const svgBar = d3
        .select("#viz-bar")
        .append("svg")
        .attr("width", "100%")
        .attr("height", "100%")
        .attr("viewBox", `0 0 ${width} ${height}`);

      const barData = [12, 19, 8, 15, 22, 9, 14];
      svgBar
        .selectAll("rect")
        .data(barData)
        .enter()
        .append("rect")
        .attr("x", (d, i) => i * (width / barData.length))
        .attr("y", (d) => height - d * 5 - margin)
        .attr("width", width / barData.length - 5)
        .attr("height", (d) => d * 5)
        .attr("fill", (d, i) => coreColors[i % 3])
        .attr("rx", 4);

      // 2. Scatter Plot
      const svgScatter = d3
        .select("#viz-scatter")
        .append("svg")
        .attr("width", "100%")
        .attr("height", "100%")
        .attr("viewBox", `0 0 ${width} ${height}`);

      const scatterData = Array.from({ length: 20 }, () => ({
        x: Math.random() * (width - 20) + 10,
        y: Math.random() * (height - 20) + 10,
        r: Math.random() * 5 + 3,
      }));

      svgScatter
        .selectAll("circle")
        .data(scatterData)
        .enter()
        .append("circle")
        .attr("cx", (d) => d.x)
        .attr("cy", (d) => d.y)
        .attr("r", (d) => d.r)
        .attr("fill", (d, i) => coreColors[i % 3])
        .attr("opacity", 0.7);

      // 3. Box Plot (Simplified representation)
      const svgBox = d3
        .select("#viz-box")
        .append("svg")
        .attr("width", "100%")
        .attr("height", "100%")
        .attr("viewBox", `0 0 ${width} ${height}`);

      // Draw 3 simple box-and-whisker shapes
      [0, 1, 2].forEach((i) => {
        const center = (width / 4) * (i + 1);
        const bottom = height - 20;
        const top = 20 + Math.random() * 40;
        const boxTop = top + 20;
        const boxBottom = bottom - 20;

        // Line
        svgBox
          .append("line")
          .attr("x1", center)
          .attr("x2", center)
          .attr("y1", top)
          .attr("y2", bottom)
          .attr("stroke", "#ccc")
          .attr("stroke-width", 2);

        // Box
        svgBox
          .append("rect")
          .attr("x", center - 15)
          .attr("y", boxTop)
          .attr("width", 30)
          .attr("height", boxBottom - boxTop)
          .attr("fill", coreColors[i])
          .attr("rx", 2);
      });

      // 4. Sparklines
      const svgSpark = d3
        .select("#viz-spark")
        .append("svg")
        .attr("width", "100%")
        .attr("height", "100%")
        .attr("viewBox", `0 0 ${width} ${height}`);

      const line = d3
        .line()
        .x((d, i) => i * (width / 14))
        .y((d) => height - d)
        .curve(d3.curveBasis);

      // Draw 3 intertwined lines
      coreColors.forEach((color) => {
        // Generate independent random data for each line so they mix
        const data = Array.from({ length: 15 }, () => Math.random() * 70 + 30);

        svgSpark
          .append("path")
          .datum(data)
          .attr("fill", "none")
          .attr("stroke", color)
          .attr("stroke-width", 3)
          .attr("d", line)
          .attr("opacity", 0.8);
      });
    });

    // --- Smooth Scroll For Inspiration Background ---
    document.addEventListener("DOMContentLoaded", () => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        { threshold: 0.15 },
      );

      const section = document.querySelector(".fade-in-section");
      if (section) observer.observe(section);
    });
  </script>
</MainLayout>
