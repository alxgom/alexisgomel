---
import MainLayout from "../../layouts/MainLayout.astro";
import Card from "../../components/Card.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import Lightbox from "../../components/Lightbox.astro";

import { Image } from "astro:assets";
import mixxxScreenshot from "../../assets/imgs/Projects/mixxx_screenshot.png";
import mixxxDashboardSvg from "../../assets/imgs/Projects/mixxx_dashboard_svg_logo.svg";
import rentalsImg from "../../assets/imgs/Projects/PopulationByDistrict_NiceColormap.png";
import shareImg from "../../assets/imgs/Projects/sac_web_app.png";
import trackingAppImg from "../../assets/imgs/Projects/trackin_app_screenshot.png";
import stitchedColorImg from "../../assets/imgs/stitched_colormaps_combined.webp";
import springPendulumGif from "../../assets/imgs/springPendulum.gif";
import waveGif from "../../assets/imgs/3_WAVE.gif";
import filamentImg from "../../assets/imgs/filament_scheme2.png";
import wordcloud from "../../assets/imgs/wordcloud_liviano.webp";
import sevillaThumb from "../../assets/imgs/Projects/sevilla_thumb.png";
import lookerStudioImg from "../../assets/imgs/Projects/tree_hierarchy_viz.png";
import webAnalyticsImg from "../../assets/imgs/Projects/webanalytics_screenshot.png";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/projects/";
// Links to English version
const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Panel de Análisis de Sets de DJ Mixxx",
        description:
          "Panel diseñado para el análisis post-set y la autorreflexión para DJs.",
        url: "https://dj-dashboard.onrender.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Mixxx DJ Buddy",
        description:
          "App en Go para visualizar tendencias de BPM y metadatos de tracks de sets de DJ en tiempo real.",
        url: "https://alexisgomel.com/es/projects/mixxx-dj-buddy/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Panel de Analítica Web",
        description:
          "Panel de análisis casi en tiempo real construido con Data Studio y GA4.",
        url: "https://alexisgomel.com/es/projects/webanalytics/",
      },
      {
        "@type": "ListItem",
        position: 4,
        name: "Análisis Histórico de Alquileres",
        description:
          "Análisis de datos históricos de alquileres en Alemania y detección de valores atípicos.",
        url: "https://www.kaggle.com/code/alexisgomel/apartment-rental-offers-munich",
      },
      {
        "@type": "ListItem",
        position: 5,
        name: "Calculadora SHARE",
        description:
          "Calculadora para aproximar la parte del alquiler que cada inquilino debe pagar.",
        url: "https://alexisgomel.com/es/sac/",
      },
      {
        "@type": "ListItem",
        position: 6,
        name: "Rastreador de Tareas",
        description:
          "Aplicación Python para rastrear el tiempo dedicado a tareas y visualizar el progreso.",
        url: "https://github.com/alxgom/Tracking_app",
      },
      {
        "@type": "ListItem",
        position: 7,
        name: "La Paleta de Sevilla",
        description:
          "Paleta de colores categórica inspirada en la historia y los paisajes de Sevilla.",
        url: "https://alexisgomel.com/es/projects/sevilla/",
      },
      {
        "@type": "ListItem",
        position: 8,
        name: "Visualizaciones Personalizadas Gratis para Power BI",
        description:
          "Una colección de visualizaciones personalizadas, gratuitas y de código abierto para Microsoft Power BI, incluyendo el Gráfico de Bala Lipstick y el Mapa de Calor Matriz de Intensidad.",
        url: "https://alexisgomel.com/es/projects/powerbi-custom-visuals/",
      },
      {
        "@type": "ListItem",
        position: 9,
        name: "Visualizaciones Comunitarias de Data Studio",
        description:
          "Visualizaciones comunitarias personalizadas incluyendo jerarquía de árbol e histograma.",
        url: "https://alexisgomel.com/es/projects/looker-studio-custom-visuals/",
      },
      {
        "@type": "ListItem",
        position: 9,
        name: "Web Scraping de Revistas (Wordcloud)",
        description:
          "Proyecto de web scraping para visualizar palabras clave de revistas de Dinámica No Lineal.",
        url: "https://github.com/alxgom/NL-Dynamics-wordcloud",
      },
      {
        "@type": "ListItem",
        position: 10,
        name: "Mapas de Color Cosidos",
        description:
          "Código en Python y Matlab para crear un nuevo mapa de color cosiendo dos existentes.",
        url: "https://github.com/alxgom/-stitched_colorbars/wiki/Stiched-Colormaps",
      },
      {
        "@type": "ListItem",
        position: 11,
        name: "Péndulo de Resorte",
        description:
          "Visualización de la dinámica del sistema de péndulo de resorte.",
      },
      {
        "@type": "ListItem",
        position: 12,
        name: "Estabilización de 3 Ondas",
        description:
          "Animación de inestabilidad modulacional mostrando interacción no lineal.",
      },
      {
        "@type": "ListItem",
        position: 13,
        name: "Esquema de Filamentación Láser",
        description: "Esquema 3D de filamentación láser hecho en Python.",
        url: "https://github.com/alxgom/Filamentation_scheme/wiki/Filamentation-Scheme",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Demo del Panel de Análisis de Mixxx DJ",
    description:
      "Demostración del Panel de Análisis de Sets de DJ Mixxx para reflexión post-set.",
    thumbnailUrl: `https://alexisgomel.com${mixxxScreenshot.src}`,
    uploadDate: "2026-01-01T00:00:00+00:00",
    contentUrl:
      "https://alexisgomel.com/assets/imgs/Projects/mixxx_dashboard.webm",
    publisher: {
      "@type": "Person",
      name: "Alexis Gomel",
      url: "https://alexisgomel.com/es/",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Demo de Mixxx DJ Buddy",
    description:
      "Visualización en tiempo real de BPM y metadatos de tracks para sets de DJ con Mixxx DJ Buddy.",
    thumbnailUrl:
      "https://alexisgomel.com/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg",
    uploadDate: "2026-02-01T00:00:00+00:00",
    contentUrl:
      "https://alexisgomel.com/assets/imgs/Projects/mixxx_dj_buddy.webm",
    publisher: {
      "@type": "Person",
      name: "Alexis Gomel",
      url: "https://alexisgomel.com/es/",
    },
  },
]);
---

<MainLayout
  title={`Ciencia de Datos, Dashboards y Apps | ${SITE_TITLE}`}
  description="Explora mis proyectos de Ciencia de Datos, incluyendo Análisis de Datos, Dashboards (Cuadros de Mando), Desarrollo de Apps y Herramientas de Visualización."
  image="/assets/imgs/curvy_logo_og.jpg"
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <link
    rel="preload"
    as="image"
    href={mixxxScreenshot.src}
    slot="head"
    fetchpriority="high"
  />
  <script type="application/ld+json" set:html={schema} slot="head" />
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />

  <div class="cv-subheader mb-5">
    <div class="container">
      <a
        href="#Data_analysis"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="Projects - Data Analysis"
        >Análisis de datos y Dashboards</a
      >
      <a
        href="#App_development"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="Projects - App Development">Desarrollo de Apps</a
      >
      <a
        href="#Viz_development"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="Projects - Visualization Dev"
        data-event-label="Projects - Visualization Dev"
        >Desarrollo de Visualización de Datos</a
      >
      <a
        href="#Plots_Viz"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="Projects - Plots & Viz">Gráficos y Visualización</a
      >
    </div>
  </div>

  <div class="container mt-5 pt-5">
    <!-- Data Analysis & Dashboards Section -->
    <section id="Data_analysis" class="section mt-3">
      <div class="container text-center" style="padding-bottom:30px;">
        <h2 class="section-title mb-4">Análisis de datos y Dashboards</h2>
      </div>

      <div class="container">
        <div class="row mb-5 align-items-center">
          <div class="col-md-6 mb-3 mb-md-0">
            <div class="general-img-holder">
              <video
                autoplay
                muted
                loop
                playsinline
                class="img-fluid"
                poster={mixxxScreenshot.src}
                aria-label="Video demostrativo del Dashboard de Análisis para DJ Mixxx"
              >
                <source
                  src="/assets/imgs/Projects/mixxx_dashboard.webm"
                  type="video/webm"
                />
                <source
                  src="/assets/imgs/Projects/mixxx_dashboard_optimized.mp4"
                  type="video/mp4"
                />
                Tu navegador no soporta el formato de video.
              </video>
              <div class="overlay">
                <a
                  href="https://dj-dashboard.onrender.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="overlay-link-full"
                  aria-label="Ver Tablero MIXX"></a>
                <div class="overlay-infos">
                  <h5>Dashboard de Análisis para DJ Mixxx</h5>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <h4><a href="https://dj-dashboard.onrender.com/" target="_blank" rel="noopener noreferrer" class="text-dark">Dashboard de Análisis para DJ Mixxx</a></h4>
            <p>
              Es un dashboard diseñado para el <strong
                >análisis posterior al set y la autorreflexión</strong
              >. Lo utilizo para obtener información sobre mi estilo como DJ,
              comprender mi flujo y descubrir nuevas combinaciones de canciones
              o artistas para explorar.
            </p>
            <p>
              Rastrea la <strong>historia completa de mis sets</strong> tocados en
              eventos de Swing y Blues utilizando datos exportados de Mixxx, permitiéndome
              analizar tanto presentaciones individuales como tendencias a largo plazo.
            </p>
            <p>
              Puedes ver un ejemplo en vivo aquí (puede tardar unos minutos en
              iniciarse):
              <a
                href="https://dj-dashboard.onrender.com/"
                target="_blank"
                rel="noopener noreferrer">Tablero en Vivo</a
              >
            </p>
            <p>
              <strong>Tecnología y habilidades:</strong> Análisis de datos, visualización
              de datos, Python, Dash, Plotly, SQL. <a
                href="https://github.com/alxgom/mixx_addon"
                target="_blank"
                rel="noopener noreferrer">Ver código en GitHub</a
              >
            </p>
          </div>
        </div>
      </div>

      <!-- Project: Web Analytics -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image
              src={webAnalyticsImg}
              alt="Dashboard de Analítica Web"
              class="img-fluid"
              loading="eager"
              fetchpriority="high"
              widths={[400, 800, webAnalyticsImg.width]}
              sizes="(max-width: 768px) 100vw, 50vw"
            />
            <div class="overlay">
              <a
                href="/projects/webanalytics/"
                class="overlay-link-full"
                aria-label="Ver el proyecto de Analítica Web"></a>
              <div class="overlay-infos">
                <h5>Dashboard de Analítica Web</h5>
              </div>
              <a
                href={webAnalyticsImg.src}
                class="overlay-zoom-link"
                aria-label="Ampliar imagen del Dashboard de Analítica Web"
                data-lightbox="true"><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4><a href="/es/projects/webanalytics/" class="text-dark">Dashboard de Analítica Web</a></h4>
          <p>
            Un dashboard de análisis casi en tiempo real para este portafolio,
            construido con Data Studio y alimentado por datos de GA4
            exportados a BigQuery.
          </p>
          <p>
            Cuenta con una agrupación de canales de sesión personalizada y una <strong
              >visualización de Jerarquía de Árbol personalizada</strong
            > para desglosar el tráfico por dispositivo, navegador, sistema operativo
            y ubicación.
          </p>
          <p>
            <strong>Tecnología y habilidades:</strong> Data Studio, BigQuery, GA4,
            SQL, Visualización de Datos.
          </p>
        </div>
      </div>

      <!-- Project: Rentals -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image src={rentalsImg} alt="Alquileres" class="img-fluid" />
            <div class="overlay">
              <a
                href="https://www.kaggle.com/code/alexisgomel/apartment-rental-offers-munich"
                class="overlay-link-full"
                aria-label="Ver proyecto de Alquileres"></a>
              <div class="overlay-infos">
                <h5>Alquileres</h5>
              </div>
              <a
                href={rentalsImg.src}
                class="overlay-zoom-link"
                aria-label="Ampliar imagen de Alquileres"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4><a href="https://www.kaggle.com/code/alexisgomel/apartment-rental-offers-munich" target="_blank" rel="noopener noreferrer" class="text-dark">Análisis histórico de alquileres</a></h4>
          <p>
            Análisis de datos históricos de alquiler en Alemania y detección de
            valores atípicos de precios (en curso).
          </p>
          <p>
            El propósito de este proyecto es estudiar la evolución de los
            precios de alquiler y la detección de valores atípicos.
            Eventualmente me gustaría que fuera una herramienta para que la
            gente estime si una propiedad de su interés tiene un precio
            razonable.
          </p>
          <p>
            <strong>Tecnología y habilidades:</strong> Analítica de datos, Ciencia
            de datos, Python, Scikit-learn, Pandas, geopandas, Jupyter-notebook.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- App Development Section -->
  <section id="App_development" class="section mt-3">
    <div class="container text-center" style="padding-bottom:30px;">
      <h2 class="section-title mb-4">Desarrollo de Apps</h2>
    </div>

    <div class="container">
      <!-- Project: SHARE -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image src={shareImg} alt="Calculadora SHARE" class="img-fluid" />
            <div class="overlay">
              <a
                href="/es/sac/"
                class="overlay-link-full"
                aria-label="Ir a la calculadora SHARE"></a>
              <div class="overlay-infos">
                <h5>
                  Calculadora de Alquiler de Apartamento Compartido (SHARE)
                </h5>
              </div>
              <a
                href={shareImg.src}
                class="overlay-zoom-link"
                aria-label="Ampliar imagen de Calculadora SHARE"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4><a href="/es/sac/" class="text-dark">Calculadora de Alquiler de Apartamento Compartido (SHARE)</a></h4>
          <p>
            Calculadora simple para aproximar la parte del alquiler que debe
            pagar cada inquilino, dada el área de su habitación y el alquiler
            total del apartamento. También es posible agregar impuestos
            compartidos adicionales como internet o impuestos municipales al
            cálculo para fines presupuestarios.
          </p>
          <p>
            La aplicación está inspirada en mi experiencia tratando de encontrar
            alojamiento en ciudades donde el alquiler es muy alto y compartir
            alojamiento es común. Está destinado a ser una primera estimación de
            lo que sería una parte justa del alquiler para cada compañero de
            piso. No tiene en cuenta características como baños en suite,
            balcón, etc..
          </p>
          <p>
            <a href="/es/sac/" class="text-primary font-weight-bold"
              >Prueba la Calculadora SHARE &rarr;</a
            >
          </p>
          <p>
            <strong>Tecnología y habilidades:</strong> Javascript, HTML
          </p>
        </div>
      </div>

      <!-- Project: Mixxx DJ Buddy -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <video
              autoplay
              muted
              loop
              playsinline
              class="img-fluid"
              poster="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
              aria-label="Video demostrativo de Mixxx DJ Buddy"
            >
              <source
                src="/assets/imgs/Projects/mixxx_dj_buddy.webm"
                type="video/webm"
              />
              <source
                src="/assets/imgs/Projects/mixxx_dj_buddy_optimized.mp4"
                type="video/mp4"
              />
              Tu navegador no soporta el formato de video.
            </video>
            <div class="overlay">
              <a
                href="/es/projects/mixxx-dj-buddy/"
                class="overlay-link-full gtm-track-click"
                data-event-category="Projects"
                data-event-label="Mixxx DJ Buddy - Card"
                aria-label="Ver página de Mixxx DJ Buddy"></a>
              <div class="overlay-infos">
                <h5>Mixxx DJ Buddy</h5>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4><a href="/es/projects/mixxx-dj-buddy/" class="text-dark">Mixxx DJ Buddy</a></h4>
          <p>
            App complementaria en vivo para <a
              href="https://mixxx.org/"
              target="_blank"
              rel="noopener noreferrer">Mixxx</a
            > (software de DJ gratuito y de código abierto) que visualiza tendencias
            de BPM y metadatos de tracks en tiempo real, leyendo directamente de la
            base de datos SQLite de Mixxx.
          </p>
          <p>
            Pasa el cursor sobre los puntos del gráfico para ver a qué <strong
              >crates y playlists</strong
            > pertenece cada canción &mdash; ayudándote a entender la historia de
            tu set y planear el próximo movimiento en la pista.
          </p>
          <p>
            <a
              href="/es/projects/mixxx-dj-buddy/"
              class="text-primary font-weight-bold"
              >Más información sobre Mixxx DJ Buddy &rarr;</a
            >
          </p>
          <p>
            <strong>Tecnología y habilidades:</strong> Go, HTML, D3.js, SQLite.
            <a
              href="https://github.com/alxgom/Mixxx-dj-buddy"
              target="_blank"
              rel="noopener noreferrer"
              class="gtm-track-click"
              data-event-category="Projects"
              data-event-label="Mixxx DJ Buddy - Text Link">Ver en GitHub</a
            >
          </p>
        </div>
      </div>

      <!-- Project: Task Tracker -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image
              src={trackingAppImg}
              alt="Rastreador de Tareas"
              class="img-fluid"
            />
            <div class="overlay">
              <a
                href="https://github.com/alxgom/Tracking_app"
                class="overlay-link-full"
                aria-label="Ver código de Rastreador de Tareas en GitHub"></a>
              <div class="overlay-infos">
                <h5>Rastreador de Tareas</h5>
              </div>
              <a
                href={trackingAppImg.src}
                class="overlay-zoom-link"
                aria-label="Ampliar imagen de Rastreador de Tareas"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4><a href="https://github.com/alxgom/Tracking_app" target="_blank" rel="noopener noreferrer" class="text-dark">Rastreador de Tareas</a></h4>
          <p>
            Aplicación Python para rastrear el tiempo dedicado a las tareas. Uno
            puede agregar qué tareas desea rastrear y la cantidad de tiempo
            dedicado a cada tarea cada día. Está destinado a ser una aplicación
            de seguimiento solo para escritorio, para evitar interactuar con un
            teléfono. También permite graficar el tiempo dedicado a cada tarea,
            para poder visualizar el progreso y la consistencia.
          </p>
          <p>
            <strong>Tecnología y habilidades:</strong> Full stack, Python, Pandas,
            json
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Visualization Development Section -->
  <section id="Viz_development" class="section mt-3">
    <div class="container text-center" style="padding-bottom:30px;">
      <h2 class="section-title mb-4">Desarrollo de Visualización de Datos</h2>
    </div>

    <div class="container">
      <!-- Project: La Paleta de Sevilla -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image
              src={sevillaThumb}
              alt="La Paleta de Sevilla"
              class="img-fluid"
            />
            <div class="overlay">
              <a
                href="/es/projects/sevilla/"
                class="overlay-link-full"
                aria-label="Ver proyecto La Paleta de Sevilla"></a>
              <div class="overlay-infos">
                <h5>La Paleta de Sevilla</h5>
              </div>
              <a
                href={sevillaThumb.src}
                class="overlay-zoom-link"
                aria-label="Ampliar imagen de La Paleta de Sevilla"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4><a href="/es/projects/sevilla/" class="text-dark">La Paleta de Sevilla</a></h4>
          <p>
            Una visualización de datos interactiva que explora una paleta de
            colores inspirada en la arquitectura e historia de Sevilla. Incluye
            análisis de contraste, simulaciones de daltonismo y una galería de
            inspiración.
          </p>
          <p>
            <strong>Tecnología y habilidades:</strong> Visualización de datos, D3.js,
            Accesibilidad (WCAG), Teoría del color.
          </p>
        </div>
      </div>

      <!-- Project: Power BI Custom Visuals -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <img
              src="/assets/imgs/powerbi/LipsktickViz.jpg"
              alt="Visualizaciones Personalizadas para Power BI"
              class="img-fluid"
              loading="lazy"
            />
            <div class="overlay">
              <a
                href="/es/projects/powerbi-custom-visuals/"
                class="overlay-link-full"
                aria-label="Explorar Visualizaciones Personalizadas para Power BI"
              ></a>
              <div class="overlay-infos">
                <h5>Visualizaciones para Power BI</h5>
              </div>
              <a
