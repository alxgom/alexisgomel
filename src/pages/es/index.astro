---
import MainLayout from "../../layouts/MainLayout.astro";
import Card from "../../components/Card.astro";
import Lightbox from "../../components/Lightbox.astro";
import PortfolioCarousel from "../../components/PortfolioCarousel.astro";
import { Image } from "astro:assets";
import avatarLiviano from "../../assets/imgs/avatar_liviano.png";
import hamiltonian3d from "../../assets/imgs/3d_hamiltonian.png";
import waveSchemeFlows from "../../assets/imgs/wave_scheme_flows.png";
import tippings from "../../assets/imgs/tippings.png";
import wordcloud from "../../assets/imgs/wordcloud.png";
import populationMap from "../../assets/imgs/PopulationByDistrict_NiceColormap_mini.png";
import mixxxDashboard from "../../assets/imgs/Projects/mixxx_dashboard_svg_logo.svg";
import filamentScheme from "../../assets/imgs/filament_scheme2.png";
import sacWebApp from "../../assets/imgs/Projects/sac_web_app.png";
import sharePuzzleLogo from "../../assets/imgs/Projects/share_puzzle_logo.svg";
import { SITE_TITLE, SITE_DESCRIPTION_ES } from "../../consts";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/";
// Links back to English

// Portfolio items for carousel (Spanish)
const portfolioItems = [
  {
    image: hamiltonian3d,
    imageAlt: "Visualización de congelación de olas gigantes",
    title: "Congelación de Olas Gigantes",
    description:
      "Investigación sobre el control de olas oceánicas extremas usando mecánica hamiltoniana. Publicado en Physical Review Letters 2021.",
    zoomHref: "/assets/imgs/3d_hamiltonian.png",
    linkHref:
      "https://journals.aps.org/prl/abstract/10.1103/PhysRevLett.126.174501",
    linkAriaLabel: "Ver publicación sobre olas gigantes",
    zoomAriaLabel: "Ampliar imagen de olas gigantes",
    gtmLabel: "Rogue wave freezing",
  },
  {
    image: mixxxDashboard,
    imageAlt: "Panel de Análisis de Sets de DJ Mixxx",
    title: "Panel de Análisis de Sets de DJ Mixxx",
    description:
      "Panel diseñado para el análisis posterior de sets de DJ, proporcionando información sobre estilo, flujo y combinaciones de canciones.",
    zoomHref: "/assets/imgs/Projects/mixxx_screenshot.png",
    linkHref: "https://dj-dashboard.onrender.com/",
    linkAriaLabel: "Ver Panel de Análisis Mixxx",
    zoomAriaLabel: "Ampliar imagen del Panel Mixxx",
    gtmLabel: "Mixxx Dashboard",
  },
  {
    image: populationMap,
    imageAlt: "Visualización de mapas de colores personalizados",
    title: "Mapas de Colores Personalizados",
    description:
      "Librería Python para crear barras de colores combinadas - uniendo múltiples paletas para visualización de datos complejos.",
    zoomHref: "/assets/imgs/PopulationByDistrict_NiceColormap.png",
    linkHref: "https://github.com/alxgom/-stitched_colorbars",
    linkAriaLabel: "Ver mapas de colores en GitHub",
    zoomAriaLabel: "Ampliar imagen de mapas de colores",
    gtmLabel: "Custom colormaps",
  },
  {
    image: sharePuzzleLogo,
    imageAlt: "Animación del logotipo de rompecabezas para Calculadora SHARE",
    title: "Calculadora SHARE",
    description:
      "Calculadora simple para aproximar la parte del alquiler que debe pagar cada inquilino según el tamaño de su habitación. Desarrollada con JavaScript y HTML.",
    zoomHref: "/assets/imgs/Projects/sac_web_app.png",
    linkHref: "/es/sac",
    linkAriaLabel: "Abrir la Calculadora SHARE",
    zoomAriaLabel: "Ampliar imagen de la Calculadora SHARE",
    gtmLabel: "SHARE Calculator",
  },
  // PRESERVADO PARA USO FUTURO: Regímenes de Filamentación Láser
  // {
  //   image: filamentScheme,
  //   imageAlt: "Regímenes estadísticos de filamentación",
  //   title: "Regímenes de Filamentación Láser",
  //   description:
  //     "Análisis estadístico de filamentación de luz en medios no lineales, explorando diferentes regímenes de propagación.",
  //   zoomHref: "/assets/imgs/filament_scheme2.png",
  //   linkHref:
  //     "https://opg.optica.org/oe/fulltext.cfm?uri=oe-31-6-9973&id=527180",
  //   linkAriaLabel: "Ver publicación de filamentación",
  //   zoomAriaLabel: "Ampliar imagen de filamentación",
  //   gtmLabel: "Filamentation",
  // },
];
---

<MainLayout
  title="Alexis Gomel | Portafolio de Físico y Científico de Datos"
  description={SITE_DESCRIPTION_ES}
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <section class="header" id="hero">
    <div class="bg-image bg-image-white">
      <div class="bg-image-white">
        <div class="container">
          <div class="infos">
            <div class="row mb-5">
              <div class="col-12 text-center text-md-left">
                <h1 class="title h6 mb-2">Alexis Gomel</h1>
                <h2 class="subtitle font-weight-normal mb-0">
                  Físico | Científico de Datos | Analista de Datos |
                  Investigador
                </h2>
              </div>
            </div>

            <div class="row align-items-center">
              <div class="col-md-4 text-center">
                <Image
                  src={avatarLiviano}
                  alt="Alexis Gomel Avatar"
                  class="img-thumbnail mb-4"
                  style="width: 100%; max-width: 250px; height: auto;"
                />

                <div class="buttons mb-4 mb-md-0">
                  <a
                    href="#contact"
                    class="btn btn-primary rounded mr-2 gtm-track-click"
                    aria-label="Contactar a Alexis"
                    data-event-category="Header"
                    data-event-label="Contact Button Click"
                  >
                    <i class="ti-email"></i>
                  </a>
                  <a
                    href="/assets/files/CV_Alexis_Gomel_web.pdf"
                    download
                    class="gtm-track-click"
                    data-event-category="Header"
                    data-event-label="Download CV"
                  >
                    <button
                      class="btn btn-dark rounded"
                      aria-label="Descargar CV">DESCARGAR CV</button
                    >
                  </a>
                </div>
              </div>

              <div class="col-md-8 text-center text-md-left pl-md-5">
                <h3
                  class="lead"
                  style="font-size: clamp(22px, 2.9vw, 40px); line-height: 1.4;"
                >
                  Me inspiro conectando los puntos entre diferentes mundos.
                  Desde la física y la educación hasta la fotografía, utilizo mi
                  diversa experiencia para mirar más allá de lo obvio y crear
                  soluciones innovadoras.
                </h3>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <a href="#service" class="scroll-down" aria-label="Scroll Down">
      <span>Portfolio</span>
      <i class="ti-angle-down"></i>
    </a>
  </section>
  <main>
    <section id="service" class="section">
      <div class="container text-center">
        <h2 class="section-title mb-4">Lo Que Hago</h2>
        <div class="row justify-content-center">
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/es/cvonline"
              icon="icon ti-user"
              title="CV Online"
              ariaLabel="Ver CV Online"
              gtmCategory="Home Card"
              gtmLabel="Online CV"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/es/projects"
              icon="icon ti-gallery"
              title="Proyectos Personales"
              ariaLabel="Ver Proyectos Personales"
              gtmCategory="Home Card"
              gtmLabel="Personal Projects"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="https://scholar.google.com/citations?user=XgG56aYAAAAJ&hl=es&oi=ao"
              target="_blank"
              icon="ai ai-google-scholar ai-3x"
              title="Publicaciones"
              ariaLabel="Ver Publicaciones en Google Scholar"
              gtmCategory="Home Card"
              gtmLabel="Publications"
            />
          </div>
        </div>
      </div>
    </section>

    <section id="hobbies" class="section">
      <div class="container text-center">
        <h2 class="section-title pt-5 mb-2">Pasatiempos</h2>
        <p class="section-subtitle">
          Fuera de mis actividades profesionales, me encanta capturar la vida a
          través de la fotografía, moverme al ritmo del swing, tocar la batería
          y salir a la carretera en aventuras espontáneas haciendo autoestop.
        </p>
        <div class="row justify-content-center">
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/es/photography"
              icon="icon ti-camera"
              title="Fotografía"
              ariaLabel="Ver Fotografía"
              gtmCategory="Home Card"
              gtmLabel="Photography"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/es/playlists"
              icon="icon ti-music-alt"
              title="Listas de Música"
              ariaLabel="Ver Listas de Música"
              gtmCategory="Home Card"
              gtmLabel="Playlists"
            />
          </div>
        </div>
      </div>
    </section>

    <PortfolioCarousel
      items={portfolioItems}
      sectionTitle="Mis Trabajos"
      sectionSubtitle="Aquí hay una lista de algunos de mis proyectos. Si quieres ver más, visita mi página de proyectos en la sección de arriba."
    />

    <section id="contact" class="position-relative section">
      <div class="container text-center">
        <p class="subtitle">Contacto</p>
        <h2 class="section-title mb-4">
          <a
            href="mailto:alexis.gomel@gmail.com"
            target="_blank"
            rel="noopener noreferrer"
            class="gtm-track-click"
            data-event-category="Contact"
            data-event-label="Send Email Link"
          >
            Envíame un correo: alexis.gomel@gmail.com
          </a>
        </h2>

        <form
          action="https://formspree.io/f/xldqpzqd"
          method="POST"
          class="contact-form"
        >
          <input
            type="email"
            name="email"
            placeholder="Tu correo electrónico"
            aria-label="Correo electrónico"
            required
          />
          <textarea
            name="message"
            placeholder="Tu mensaje"
            aria-label="Mensaje"
            required></textarea>
          <button
            type="submit"
            class="btn btn-primary rounded gtm-track-click"
            data-event-category="Contact"
            data-event-label="Submit Form"
          >
            Enviar Mensaje
          </button>
        </form>

        <div id="map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d95776.4!2d2.154!3d41.3851!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1ses!2ses"
            title="Mapa de ubicación de Barcelona"
            style="border:0; width: 100%; height: 100%; filter: grayscale(100%);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>
  </main>
  <Lightbox />
</MainLayout>
