---
import MainLayout from "../../layouts/MainLayout.astro";
import Card from "../../components/Card.astro";
import Lightbox from "../../components/Lightbox.astro";
import { Image } from "astro:assets";
import avatarLiviano from "../../assets/imgs/avatar_liviano.png";
import hamiltonian3d from "../../assets/imgs/3d_hamiltonian.png";
import waveSchemeFlows from "../../assets/imgs/wave_scheme_flows.png";
import tippings from "../../assets/imgs/tippings.png";
import wordcloud from "../../assets/imgs/wordcloud.png";
import populationMap from "../../assets/imgs/PopulationByDistrict_NiceColormap_mini.png";
import filamentScheme from "../../assets/imgs/filament_scheme2.png";
import { SITE_TITLE, SITE_DESCRIPTION_ES } from "../../consts";

// MULTILINGUAL SETTINGS
const currentLang = "es";
const alternateHref = "/"; // Links back to English
---

<MainLayout
  title="Alexis Gomel | Portafolio de Físico y Científico de Datos"
  description={SITE_DESCRIPTION_ES}
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <header class="header" id="home">
    <div class="bg-image bg-image-white">
      <div class="bg-image-white">
        <div class="container">
          <div class="infos">
            <div class="row mb-5">
              <div class="col-12 text-center text-md-left">
                <h1 class="title h6 mb-2">Alexis Gomel</h1>
                <p class="subtitle font-weight-normal text-muted mb-0">
                  Físico | Científico de Datos | Analista de Datos |
                  Investigador
                </p>
              </div>
            </div>

            <div class="row align-items-center">
              <div class="col-md-4 text-center">
                <Image
                  src={avatarLiviano}
                  alt="Alexis Gomel Avatar"
                  class="img-thumbnail mb-4"
                  style="width: 100%; max-width: 250px; height: auto;"
                />

                <div class="buttons mb-4 mb-md-0">
                  <a
                    href="mailto:alexis.gomel@gmail.com"
                    rel="noopener noreferrer"
                    class="gtm-track-click"
                    data-event-category="Header"
                    data-event-label="Send Email"
                  >
                    <button
                      class="btn btn-primary rounded mr-2"
                      aria-label="Enviar correo"
                    >
                      <i class="ti-email"></i></button
                    >
                  </a>
                  <a
                    href="/assets/files/CV_Alexis_Gomel_web.pdf"
                    download
                    class="gtm-track-click"
                    data-event-category="Header"
                    data-event-label="Download CV"
                  >
                    <button
                      class="btn btn-dark rounded"
                      aria-label="Descargar CV">DESCARGAR CV</button
                    >
                  </a>
                </div>
              </div>

              <div class="col-md-8 text-center text-md-left pl-md-5">
                <p class="lead">
                  ¡Bienvenido a mi sitio web personal! Soy un físico apasionado
                  por la dinámica no lineal, sistemas complejos, señales de
                  alerta temprana, mecánica estadística y sus aplicaciones.
                </p>
                <p>
                  Cuando no estoy investigando, me encanta capturar la vida a
                  través de la fotografía, bailar swing, tocar la batería y
                  viajar a dedo.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <a href="#service" class="scroll-down" aria-label="Scroll Down">
      <span>Secciones</span>
      <i class="ti-angle-down"></i>
    </a>
  </header>
  <main>
    <section id="service" class="section">
      <div class="container text-center">
        <h2 class="section-title mb-4">Lo Que Hago</h2>
        <div class="row">
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/es/cvonline"
              icon="icon ti-user"
              title="CV Online"
              ariaLabel="Ver CV Online"
              gtmCategory="Home Card"
              gtmLabel="Online CV"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/es/projects"
              icon="icon ti-gallery"
              title="Proyectos Personales"
              ariaLabel="Ver Proyectos Personales"
              gtmCategory="Home Card"
              gtmLabel="Personal Projects"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="https://scholar.google.com/citations?user=XgG56aYAAAAJ&hl=es&oi=ao"
              target="_blank"
              icon="ai ai-google-scholar ai-3x"
              title="Publicaciones"
              ariaLabel="Ver Publicaciones en Google Scholar"
              gtmCategory="Home Card"
              gtmLabel="Publications"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/es/photography"
              icon="icon ti-camera"
              title="Fotografía"
              ariaLabel="Ver Fotografía"
              gtmCategory="Home Card"
              gtmLabel="Photography"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/es/playlists"
              icon="icon ti-music-alt"
              title="Listas de Música"
              ariaLabel="Ver Listas de Música"
              gtmCategory="Home Card"
              gtmLabel="Playlists"
            />
          </div>
        </div>
      </div>
    </section>

    <section id="portfolio" class="section">
      <div class="container text-center">
        <h2 class="section-title mb-4">Mis Trabajos</h2>
        <p class="mb-5 pb-4">Aquí hay una lista de algunos de mis proyectos.</p>
        <div class="row">
          <div class="col-sm-4">
            <div class="img-wrapper">
              <Image src={hamiltonian3d} alt="Rogue wave freezing" />
              <div class="overlay">
                <div class="overlay-infos">
                  <h3>Rogue wave freezing</h3>
                  <a
                    href="/assets/imgs/3d_hamiltonian.png"
                    aria-label="Zoom en Rogue wave freezing"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Rogue wave freezing - Zoom"
                    data-lightbox="true"><i class="ti-zoom-in"></i></a
                  >
                  <a
                    href="https://journals.aps.org/prl/abstract/10.1103/PhysRevLett.126.174501"
                    aria-label="Ver proyecto Rogue wave freezing"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Rogue wave freezing - Link"
                    ><i class="ti-link"></i></a
                  >
                </div>
              </div>
            </div>
            <div class="img-wrapper">
              <Image src={waveSchemeFlows} alt="ADHONLS" />
              <div class="overlay">
                <div class="overlay-infos">
                  <h3>ADHONLS</h3>
                  <a
                    href="/assets/imgs/wave_scheme_flows.png"
                    aria-label="Zoom en ADHONLS"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="ADHONLS - Zoom"
                    data-lightbox="true"><i class="ti-zoom-in"></i></a
                  >
                  <a
                    href="https://pubs.aip.org/aip/pof/article/35/8/087128/2907461/Mean-flow-modeling-in-high-order-nonlinear"
                    aria-label="Ver proyecto ADHONLS"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="ADHONLS - Link"><i class="ti-link"></i></a
                  >
                </div>
              </div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="img-wrapper">
              <Image src={tippings} alt="Tipping points" />
              <div class="overlay">
                <div class="overlay-infos">
                  <h3>Tipping points</h3>
                  <a
                    href="/assets/imgs/tippings.png"
                    aria-label="Zoom en Tipping points"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Tipping points - Zoom"
                    data-lightbox="true"><i class="ti-zoom-in"></i></a
                  >
                  <span><i class="ti-link"></i></span>
                </div>
              </div>
            </div>
            <div class="img-wrapper">
              <Image src={wordcloud} alt="Wordcloud Journal webscrapping" />
              <div class="overlay">
                <div class="overlay-infos">
                  <h3>Worldcloud Jounal webscrapping</h3>
                  <a
                    href="/assets/imgs/wordcloud.png"
                    aria-label="Zoom en Worldcloud Journal webscrapping"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Wordcloud - Zoom"
                    data-lightbox="true"><i class="ti-zoom-in"></i></a
                  >
                  <a
                    href="https://github.com/alxgom/NL-Dynamics-wordcloud"
                    aria-label="Ver proyecto Worldcloud Journal webscrapping"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Wordcloud - Link"
                    ><i class="ti-link"></i></a
                  >
                </div>
              </div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="img-wrapper">
              <Image src={populationMap} alt="Custom colormaps" />
              <div class="overlay">
                <div class="overlay-infos">
                  <h3>Custom colormaps</h3>
                  <a
                    href="/assets/imgs/PopulationByDistrict_NiceColormap.png"
                    aria-label="Zoom en Custom colormaps"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Custom colormaps - Zoom"
                    data-lightbox="true"><i class="ti-zoom-in"></i></a
                  >
                  <a
                    href="https://github.com/alxgom/-stitched_colorbars"
                    aria-label="Ver proyecto Custom colormaps"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Custom colormaps - Link"
                    ><i class="ti-link"></i></a
                  >
                </div>
              </div>
            </div>
            <div class="img-wrapper">
              <Image
                src={filamentScheme}
                alt="Filamentation statistical regimes"
              />
              <div class="overlay">
                <div class="overlay-infos">
                  <h3>Filamentation statistical regimes</h3>
                  <a
                    href="/assets/imgs/filament_scheme2.png"
                    aria-label="Zoom en Filamentation statistical regimes"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Filamentation - Zoom"
                    data-lightbox="true"><i class="ti-zoom-in"></i></a
                  >
                  <a
                    href="https://opg.optica.org/oe/fulltext.cfm?uri=oe-31-6-9973&id=527180"
                    aria-label="Ver proyecto Filamentation statistical regimes"
                    class="gtm-track-click"
                    data-event-category="Portfolio Item"
                    data-event-label="Filamentation - Link"
                    ><i class="ti-link"></i></a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="position-relative section">
      <div class="container text-center">
        <p class="subtitle">Contacto</p>
        <h2 class="section-title mb-4">
          <a
            href="mailto:alexis.gomel@gmail.com"
            target="_blank"
            rel="noopener noreferrer"
            class="gtm-track-click"
            data-event-category="Contact"
            data-event-label="Send Email Link"
          >
            Envíame un correo: alexis.gomel@gmail.com
          </a>
        </h2>

        <form
          action="https://formspree.io/f/xldqpzqd"
          method="POST"
          class="contact-form"
        >
          <input
            type="email"
            name="email"
            placeholder="Tu correo electrónico"
            aria-label="Correo electrónico"
            required
          />
          <textarea
            name="message"
            placeholder="Tu mensaje"
            aria-label="Mensaje"
            required></textarea>
          <button
            type="submit"
            class="btn btn-primary rounded gtm-track-click"
            data-event-category="Contact"
            data-event-label="Submit Form"
          >
            Enviar Mensaje
          </button>
        </form>

        <div id="map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d95776.4!2d2.154!3d41.3851!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1ses!2ses"
            title="Mapa de ubicación de Barcelona"
            style="border:0; width: 100%; height: 100%; filter: grayscale(100%);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>
  </main>
  <Lightbox />
</MainLayout>
