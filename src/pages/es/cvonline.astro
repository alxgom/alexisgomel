---
import MainLayout from "../../layouts/MainLayout.astro";
import { SITE_TITLE } from "../../consts";

// Import our new "Nice" components
import LanguageChart from "../../components/cv/LanguageChart.astro";
import SkillGroup from "../../components/cv/SkillGroup.astro";
import Lightbox from "../../components/Lightbox.astro";

const currentLang = "es";
const alternateHref = "/cvonline";

const advancedSkills = [
  { name: "Python", experience: "+8 años" },
  { name: "Matlab", experience: "+7 años" },
  { name: "Git", experience: "+5 años" },
];

const intermediateSkills = [
  { name: "Latex", experience: "+6 años" },
  { name: "SQL - BigQuery", experience: "1 año" },
  { name: "Power BI & LookerStudio", experience: "+6 meses" },
];

const beginnerSkills = [
  { name: "HTML", experience: "+1 año" },
  { name: "Spark", experience: "Nuevo" },
];
---

<MainLayout
  title="Curriculum Vitae (CV) | Alexis Gomel - Físico y Científico de Datos"
  description="Consulta mi experiencia profesional, habilidades en Python y Matlab, y formación académica en Física y Ciencia de Datos."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />
  <script
    is:inline
    type="text/javascript"
    src="https://cdn.jsdelivr.net/gh/pcooksey/bibtex-js@1.0.0/src/bibtex_js.min.js"
  ></script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alexis Gomel",
      "jobTitle": "Físico, Científico de Datos y Analista de Datos",
      "url": "https://alexisgomel.com/es/cvonline",
      "image": "https://alexisgomel.com/assets/imgs/alexis_gomel.jpg",
      "sameAs": [
        "https://www.linkedin.com/in/alexis-gomel-95484278/",
        "https://github.com/alxgom",
        "https://www.researchgate.net/profile/Alexis-Gomel"
      ],
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Universidad de Ginebra",
          "sameAs": "https://www.unige.ch/"
        },
        {
          "@type": "CollegeOrUniversity",
          "name": "Universidad de Buenos Aires",
          "sameAs": "https://www.uba.ar/"
        }
      ],
      "knowsAbout": [
        "Física",
        "Ciencia de Datos",
        "Análisis de Datos",
        "Dinámica No Lineal",
        "Machine Learning",
        "Python",
        "SQL",
        "BigQuery",
        "Matlab"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "En búsqueda activa / Freelance"
      },
      "description": "Físico y Científico de Datos especializado en dinámica no lineal, análisis de datos y sistemas complejos."
    }
  </script>

  <div class="cv-subheader mb-5">
    <div class="container">
      <a href="#Current" class="cv-nav-link">Sobre mí</a>
      <a href="#Experience" class="cv-nav-link">Experiencia</a>
      <a href="#Skills" class="cv-nav-link">Habilidades</a>
      <a href="#Formation" class="cv-nav-link">Formación</a>
      <a href="#Teaching" class="cv-nav-link">Docencia</a>
      <a href="#Publications" class="cv-nav-link">Publicaciones</a>
      <a href="#Presentations and congresses" class="cv-nav-link"
        >Presentaciones</a
      >
      <a href="#Past_jobs" class="cv-nav-link">Otros trabajos</a>
    </div>
  </div>

  <div class="container mt-5 pt-5">
    <section id="Current" class="section mt-3">
      <div class="container">
        <h1 class="text-center mb-5" style="font-weight: bold;">
          CV Online y Experiencia Profesional
        </h1>
        <h2
          class="section-title mb-4 text-center"
          style="font-weight: bold; font-size: 40px;"
        >
          Sobre mí
        </h2>
        <div class="row align-items-center">
          <div class="col-md-8 text-left">
            <p class="mb-2 pb-2">
              Soy físico con pasión por la dinámica no lineal, ciencia de datos,
              sistemas complejos, alertas tempranas, mecánica estadística y sus
              aplicaciones a muchos sistemas. Mis intereses de investigación
              también se extienden a la educación y los campos de la IA
              generativa y la ciencia de datos.
            </p>
            <p class="mb-5 pb-4">
              Mi viaje profesional incluye investigación en dinámica no lineal y
              ciencia de datos, con roles recientes aplicando estas habilidades
              a la analítica digital.
            </p>
          </div>
          <div class="col-md-4 text-center">
            <div class="general-img-holder mb-3">
              <img
                src="/assets/imgs/wordcloud_liviano.webp"
                alt="Imagen generada por webscraping de las palabras clave de todos los artículos desde 2020 en la revista de dinámica no lineal"
                class="img-fluid"
              />
            </div>
            <p class="mb-2 pb-2" style="font-style: italic; font-size: 0.9em;">
              “Usar un término como ciencia no lineal es como referirse a la
              mayor parte de la zoología como el estudio de los animales que no
              son elefantes.” – Stanislaw Ulam.
            </p>
          </div>
        </div>
      </div>
      <a href="#Experience" class="section-arrow" aria-label="Ir a Experiencia">
        <i class="ti-angle-down"></i>
      </a>
    </section>

    <section id="Experience" class="section mt-3">
      <div class="container text-center">
        <h2
          class="section-title mb-4"
          style="font-weight: bold; font-size: 40px;"
        >
          Experiencia Profesional
        </h2>
        <div class="mb-2 pb-4"></div>
      </div>

      <div class="container">
        <div class="row">
          <div class="col-12">
            <h3
              class="section-title mb-2"
              style="font-weight: bold; font-size: 24px;"
            >
              Analista de Datos
            </h3>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              I+D para BI y marketing digital
            </h4>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              <a
                href="https://lamagnetica.com"
                target="_blank"
                rel="noopener noreferrer"
                style="text-decoration: underline;">LaMagnetica</a
              >
            </h4>
            <p class="text-muted mb-3">
              Junio 2025 - Noviembre 2025 | Barcelona, España
            </p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Resumen de Impacto
            </h4>
            <p class="mb-4">
              Optimización integral de la infraestructura de datos y analítica
              digital, logrando una reducción del 93% en el volumen de
              procesamiento y una mejora de velocidad de 10x en consultas
              críticas. Diseño de arquitecturas escalables en Google Cloud
              Platform y visualizaciones personalizadas avanzadas para
              dashboards de negocio.
            </p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Detalles del Proyecto y Logros Clave
            </h4>
            <ul class="mb-4 text-left">
              <li class="mb-2">
                <strong>Optimización de Arquitectura BigQuery:</strong> Reducción
                del volumen de datos procesados mediante refactorización de consultas
                SQL e implementación de estrategias de particionamiento, logrando
                hasta un 93% de reducción de carga.
              </li>
              <li class="mb-2">
                <strong>Ajuste de Rendimiento:</strong> Aceleración de tiempos de
                respuesta de consultas complejas hasta 10x, asegurando estabilidad
                y carga rápida de dashboards de Looker Studio para el cliente final.
              </li>
              <li class="mb-2">
                <strong>Ingeniería de Visualización:</strong> Desarrollo de componentes
                visuales personalizados (ej. Lipstick Plot / Bullet Chart) usando
                D3.js integrado en Power BI, permitiendo representación efectiva de
                KPIs complejos comparados contra objetivos de negocio.
              </li>
              <li class="mb-2">
                <strong>Calidad e Integridad de Datos:</strong> Detección de brechas
                de datos críticas impactando la coherencia de sesiones. Ingeniería
                de una solución para inyectar eventos 'page_view' sintéticos para
                mantener la continuidad de la sesión, resultando en una recuperación
                del 8% de eventos perdidos para usuarios que aceptaron cookies.
              </li>
              <li class="mb-2">
                <strong>Validación Científica:</strong> Diseño e implementación de
                un protocolo de pruebas integral. Establecimiento de los primeros
                KPIs objetivos de fidelidad de datos para medir el éxito de la reconstrucción
                de sesiones para usuarios sin cookies.
              </li>
              <li class="mb-2">
                <strong>Eficiencia Operativa:</strong> Reducción drástica de costos
                operativos (~97%) mediante optimización de consultas y automatización
                de procesos de actualización diaria.
              </li>
            </ul>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Tecnologías Aplicadas
            </h4>
            <p class="mb-4">
              Google BigQuery, SQL (Standard & Legacy), Looker Studio, Power BI
              (DAX), D3.js / JavaScript, Python (Automatización).
            </p>

            <div class="text-center mt-4">
              <a
                href="/assets/reccomendation_letters/Referencia%20Alexis%20LM_Joana.pdf"
                class="btn btn-primary"
                download
                style="background-color: var(--primary); border-color: var(--primary); color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;"
              >
                Descargar Carta de Recomendación
              </a>
            </div>

            <div class="mb-5 pb-4" style="border-bottom: 1px solid #eee;"></div>

            <h3
              class="section-title mb-2"
              style="font-weight: bold; font-size: 24px;"
            >
              Investigador Posdoctoral
            </h3>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              Grupo de Matemáticas del Planeta Tierra
            </h4>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              Universidad de Reading | Reino Unido
            </h4>
            <p class="text-muted mb-3">Abril 2023 - Febrero 2024</p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Resumen de Impacto
            </h4>
            <p class="mb-4">
              Investigación centrada en "Puntos de Inflexión" climáticos
              utilizando sistemas estocásticos, desarrollando algoritmos para
              señales de alerta temprana en series temporales ruidosas y
              evaluando impactos de políticas vía simulaciones numéricas.
            </p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Detalles del Proyecto y Logros Clave
            </h4>
            <ul class="mb-4 text-left">
              <li class="mb-2">
                <strong>Investigación de Puntos de Inflexión:</strong> Investigación
                sobre puntos de inflexión climáticos usando modelado de sistemas estocásticos.
              </li>
              <li class="mb-2">
                <strong>Algoritmos de Alerta Temprana:</strong> Desarrollo de algoritmos
                en Python y Matlab para detectar señales de alerta temprana en series
                temporales ruidosas.
              </li>
              <li class="mb-2">
                <strong>Evaluación de Impacto de Políticas:</strong> Realización de
                simulaciones numéricas para evaluar el impacto de diversas políticas.
              </li>
              <li class="mb-2">
                <strong>Colaboración Internacional:</strong> Colaboración con investigadores
                internacionales como parte del proyecto TIPES (UE Horizon 2020).
              </li>
            </ul>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Tecnologías Aplicadas
            </h4>
            <p class="mb-4">
              Python, Matlab, Simulaciones Numéricas, Modelado Estocástico.
            </p>

            <div class="mb-5 pb-4" style="border-bottom: 1px solid #eee;"></div>

            <h3
              class="section-title mb-2"
              style="font-weight: bold; font-size: 24px;"
            >
              Investigador de Doctorado & Asistente Docente
            </h3>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              Grupo de Dinámica No Lineal y Clima
            </h4>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              Universidad de Ginebra | Ginebra, Suiza
            </h4>
            <p class="text-muted mb-3">Mayo 2018 – Febrero 2023</p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Resumen de Impacto
            </h4>
            <p class="mb-4">
              Modelado multiescala de ondas de gravedad y fluidos, diseño de
              pipelines de análisis en tiempo real para experimentos, y
              validación rigurosa de modelos teóricos con datos experimentales.
              Publicación de 4 artículos revisados por pares y supervisión de un
              estudiante de máster.
            </p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Detalles del Proyecto y Logros Clave
            </h4>
            <ul class="mb-4 text-left">
              <li class="mb-2">
                <strong>Modelado Multiescala:</strong> Modelado de ondas de gravedad
                y fluidos en batimetrías complejas.
              </li>
              <li class="mb-2">
                <strong>Pipeline de Experimentación en Tiempo Real:</strong> Diseño
                de un pipeline en la Universidad de Sydney para analizar mediciones
                de tanque de agua en tiempo real, agilizando el ciclo simulación-experimento.
              </li>
              <li class="mb-2">
                <strong>Validación Experimental:</strong> Validación de estadísticas
                de espectros de láser de alta intensidad usando un pipeline de análisis
                en Python.
              </li>
              <li class="mb-2">
                <strong>Validación de Modelos:</strong> Uso de datos experimentales
                como valor inicial para simulaciones teóricas, permitiendo una validación
                más rigurosa.
              </li>
              <li class="mb-2">
                <strong>Producción Académica:</strong> Publicación de 4 artículos
                en revistas de alto impacto.
              </li>
              <li class="mb-2">
                <strong>Mentoría:</strong> Dirección de un estudiante de Máster.
              </li>
            </ul>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Tecnologías Aplicadas
            </h4>
            <p class="mb-4">
              Python, Dinámica de Fluidos, Modelado de Ondas, Análisis de Datos,
              Procesamiento en Tiempo Real.
            </p>

            <div class="mb-5 pb-4" style="border-bottom: 1px solid #eee;"></div>
          </div>
        </div>
      </div>
      <a href="#Skills" class="section-arrow" aria-label="Ir a Habilidades">
        <i class="ti-angle-down"></i>
      </a>
    </section>

    <section id="Skills" class="section mt-3">
      <div class="container text-center">
        <h2
          class="section-title mb-4"
          style="font-weight: bold; font-size: 40px;"
        >
          Habilidades
        </h2>
        <div class="mb-2 pb-4"></div>
      </div>

      <div class="container text-center">
        <div class="row mx-auto">
          <SkillGroup
            title="Avanzado"
            color="var(--primary)"
            height="150px"
            skills={advancedSkills}
          />

          <SkillGroup
            title="Intermedio"
            color="var(--primary)"
            brightness="1.3"
            opacity="0.8"
            height="100px"
            skills={intermediateSkills}
          />

          <SkillGroup
            title="Principiante"
            color="var(--primary)"
            brightness="1.5"
            opacity="0.5"
            height="60px"
            skills={beginnerSkills}
          />
        </div>
      </div>

      <div class="mb-2 pb-4"></div>

      <div class="container text-left">
        <section>
          <div class="columns">
            <div class="column">
              <div class="rectangle"></div>
              <div class="text">
                <h3>Ciencia de Datos</h3>
                <p>
                  Análisis de Datos, Narración de Datos, Visualización de Datos,
                  Estadística, Modelado Matemático, Simulaciones Numéricas,
                  Análisis de Series Temporales.
                </p>
              </div>
            </div>
            <div class="column">
              <div class="rectangle"></div>
              <div class="text">
                <h3>Matemáticas</h3>
                <p>
                  Regresiones, Análisis de Fourier, integración numérica,
                  extrapolación, interpolación, análisis de wavelets,
                  simulaciones estocásticas, ecuaciones diferenciales no
                  lineales, álgebra lineal, modelado.
                </p>
              </div>
            </div>
            <div class="column">
              <div class="rectangle"></div>
              <div class="text">
                <h3>Estadística</h3>
                <p>
                  Estadística de conjuntos, estimación de incertidumbre, PCA,
                  k-means, correlación, información mutua, momentos estadísticos
                  imparciales.
                </p>
              </div>
            </div>
            <div class="column">
              <div class="rectangle"></div>
              <div class="text">
                <h3>Física</h3>
                <p>
                  Dinámica no lineal, Física láser, Mecánica de Fluidos, Física
                  Estadística
                </p>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="mb-2 pb-4"></div>

      <LanguageChart
        labels={["Español", "Inglés", "Francés", "Alemán"]}
        datasetLabel="Nivel"
      />

      <!-- CTA to Projects Portfolio -->
      <div class="container text-center mt-5 pt-4 mb-5 pb-4">
        <div class="row justify-content-center">
          <div class="col-md-8">
            <h3 class="mb-3" style="font-size: 28px; font-weight: bold;">
              ¿Quieres ver estas habilidades en acción?
            </h3>
            <p class="mb-4" style="font-size: 18px;">
              Consulta mi portafolio para explorar visualizaciones de datos,
              dashboards interactivos y proyectos que demuestran Python, SQL y
              más.
            </p>
            <a
              href="/es/projects"
              class="btn btn-primary btn-lg"
              style="background-color: var(--primary); border-color: var(--primary); color: white; padding: 15px 40px; text-decoration: none; border-radius: 8px; font-size: 18px; font-weight: bold; transition: all 0.3s ease;"
              onmouseover="this.style.transform='scale(1.05)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.2)';"
              onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';"
            >
              Ver Mis Proyectos →
            </a>
          </div>
        </div>
      </div>
      <a
        href="#Formation"
        class="section-arrow"
        aria-label="Ir a Formación Académica"
      >
        <i class="ti-angle-down"></i>
      </a>
    </section>

    <section id="Formation" class="section mt-3">
      <div class="container text-center">
        <h2
          class="section-title mb-4"
          style="font-weight: bold; font-size: 40px;"
        >
          Formación Académica
        </h2>
        <div class="mb-2 pb-4"></div>

        <div class="row mx-auto">
          <div class="col-sm-6 col-md-6 mb-3">
            <h3
              class="section-title mb-3"
              style="font-weight: bold; font-size: 34px;"
            >
              Doctorado en Ciencias Físicas
            </h3>
            <h4 class="section-title mb-2">
              Comportamiento de ondas automoduladas en sistemas no lineales
            </h4>
            <div class="img-holder">
              <style>
                .imagefac {
                  width: auto;
                  height: 100px;
                }
              </style>
              <img
                src="/assets/imgs/fac_sciences_noir.png"
                alt=""
                class="imagefac"
              />
              <h4 class="mb-3 pb-2" style="font-size: 20px;">
                Universidad de Ginebra <br />
                <a
                  href="https://www.unige.ch/gap/nonlinear/"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="font-size: 16px;">Nonlinearity and Climate Group</a
                >
              </h4>
              <p class="h6 mb-1 pb-2 font-weight-bold">Asesores</p>
              <p>Asesor: Jérôme Kasparian</p>
              <p>Co-asesor: Maura Brunetti</p>
            </div>
          </div>
          <div class="col-sm-6 col-md-6 mb-3">
            <h3
              class="section-title mb-3"
              style="font-weight: bold; font-size: 34px;"
            >
              Máster en Ciencias Físicas
            </h3>
            <h4 class="section-title mb-2">
              Rogue waves en lasers modulados en fase
            </h4>
            <h4 class="section-title mb-2">
              (Rogue waves in phase modulated lasers)
            </h4>
            <div class="img-holder">
              <img src="/assets/imgs/600px-UBA.png" alt="" class="imagefac" />
              <h4 class="mb-3 pb-2" style="font-size: 20px;">
                Universidad de Buenos Aires
              </h4>
              <p class="h6 mb-1 pb-2 font-weight-bold">Asesores</p>
              <p>Asesor: Jorge Tredicce</p>
              <p>Co-asesor: Pablo Mininni</p>
            </div>
          </div>
        </div>
      </div>
      <a
        href="#Teaching"
        class="section-arrow"
        aria-label="Ir a Experiencia Docente"
      >
        <i class="ti-angle-down"></i>
      </a>
    </section>

    <div class="container text-center">
      <h2 class="section-title mb-4">Otra formación</h2>
      <p>
        Junio 2022 - Introducción al Machine Learning, Universidad de Lausana
        (UNIL)
      </p>
    </div>

    <section id="Teaching" class="section mt-3">
      <div class="container text-center">
        <h2
          class="section-title mb-4"
          style="font-weight: bold; font-size: 40px;"
        >
          Experiencia Docente
        </h2>
        <div class="mb-2 pb-4"></div>
        <div class="row mx-auto">
          <div class="col-sm-6 col-md-6 mb-3">
            <h3
              class="section-title mb-4"
              style="font-weight: bold; font-size: 34px;"
            >
              Nivel Universitario
            </h3>
            <div class="mb-5 pb-2"></div>

            <h4 class="mb-3 pb-3">Universidad de Ginebra</h4>
            <p style="font-weight: bold;">Asistente de enseñanza</p>
            <p class="mb-2 pb-2 h5">Febrero 2019 - Julio 2022</p>
            <p>
              Cursos: Laboratorio de física para biólogos, Dinámica No Lineal (a
              cargo de toda la práctica)
            </p>

            <div class="mb-5 pb-3"></div>
            <h4 class="mb-2 pb-3">Universidad de Buenos Aires</h4>
            <p style="font-weight: bold;">Asistente de enseñanza</p>
            <p class="mb-2 pb-2 h5">Febrero 2016 - Abril 2016</p>
            <p>Cursos: Introducción a la termodinámica y mecánica cuántica.</p>
          </div>

          <div class="col-sm-6 col-md-6 mb-3">
            <h3
              class="section-title mb-4"
              style="font-weight: bold; font-size: 34px;"
            >
              Nivel Secundario
            </h3>
            <div class="mb-5 pb-3"></div>
            <!--
            <h3 class="mb-3 pb-3">Escuela Paidea</h3>
            <p style="font-weight: bold;">Profesor suplente de física</p>
            <h6 class="mb-2 pb-2">Octubre 2017 - Noviembre 2017</h6>
            <p>Suplencia corta de física para estudiantes de 16-17 años.</p>
