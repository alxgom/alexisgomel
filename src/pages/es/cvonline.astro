  <script
    is:inline
    type="text/javascript"
    src="https://cdn.jsdelivr.net/gh/pcooksey/bibtex-js@1.0.0/src/bibtex_js.min.js"
  ></script>

  <div class="cv-subheader mb-5">
    <div class="container">
      <a href="#Current" class="cv-nav-link">Sobre mí</a>
      <a href="#Skills" class="cv-nav-link">Habilidades</a>
      <a href="#Experience" class="cv-nav-link">Experiencia</a>
      <a href="#Formation" class="cv-nav-link">Formación</a>
      <a href="#Teaching" class="cv-nav-link">Docencia</a>
      <a href="#Publications" class="cv-nav-link">Publicaciones</a>
      <a href="#Presentations and congresses" class="cv-nav-link"
        >Presentaciones</a
      >
      <a href="#Past_jobs" class="cv-nav-link">Otros trabajos</a>
    </div>
  </div>

  <div class="container mt-5 pt-5">
    <section id="Current" class="section mt-3">
      <div class="container">
        <h1 class="text-center mb-5" style="font-weight: bold;">
          CV Online y Experiencia Profesional
        </h1>
        <h2
