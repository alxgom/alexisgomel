---
import MainLayout from "../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/es/sac/"; // Links to Spanish version
---

<MainLayout
  title="How to split rent with your flatmate"
  description="Need to split rent with roommates? The SHARE Calculator helps you estimate a fair rent split based on room square footage and shared area. A simple tool to help navigate shared housing."
  currentLang={currentLang}
  alternateHref={alternateHref}
  image="/assets/imgs/Projects/share_puzzle_logo.svg"
>
  <link rel="stylesheet" href="/assets/css/sac_styles.css?v=2" slot="head" />

  <!-- WebApplication Schema -->
  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "SHARE Calculator - SHared Appartment REnt Calculator",
      "description": "A free tool to calculate fair rent splits for shared apartments based on room dimensions and shared spaces.",
      "url": "https://alexisgomel.com/sac/",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "inLanguage": "en",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@type": "Person",
        "name": "Alexis Gomel",
        "url": "https://alexisgomel.com"
      },
      "featureList": [
        "Calculate rent based on room size",
        "Adjust for shared space value",
        "Include monthly bills in calculation",
        "Visual room size comparison"
      ]
    }
  </script>

  <!-- FAQ Schema for better search visibility -->
  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to split rent fairly in a shared apartment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The fairest way to split rent is based on room size. Calculate each room's proportion of the total private square footage, then factor in shared areas. The SHARE Calculator automates this by showing you how to split rent proportionally based on room dimensions and a configurable shared space value."
          }
        },
        {
          "@type": "Question",
          "name": "Should shared spaces be included in rent calculations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, shared spaces like living rooms and kitchens should be factored into rent calculations. The SHARE Calculator uses a configurable 'shared space value' (0-1) to determine how much weight shared areas carry. A value of 0.75 means shared space is worth 75% of private room value."
          }
        }
      ]
    }
  </script>

  <main>
    <article class="container mt-5 pt-5 mb-5 pb-5">
      <h1 class="title">
        How to Split Rent Fairly by Square Footage: SHARE Calculator
      </h1>
      <p class="subtitle text-center mb-5">
        Split rent fairly based on room size and shared space.
      </p>

      <div class="row">
        <div class="col-lg-6 mb-4">
          <form id="rent-form">
            <div class="sac-card">
              <h3 class="h5 mb-3">1. Apartment Details</h3>
              <div class="inline-inputs mb-3">
                <div>
                  <label for="rent">Total Rent:</label>
                  <input type="number" id="rent" name="rent" required />
                </div>
                <div>
                  <label for="total_area"
                    >Total Apartment Area / Square Footage: <small
                      class="text-muted d-block font-weight-normal"
                      >(any unit)</small
                    ></label
                  >
                  <input
                    type="number"
                    id="total_area"
                    name="total_area"
                    required
                  />
                </div>
                <div id="price-per-unit-area"></div>
              </div>

              <div class="form-group mb-0">
                <label for="bills">Total Bills per month (optional):</label>
                <input type="number" id="bills" name="bills" />
              </div>
            </div>

            <div class="sac-card mt-4">
              <h3 class="h5 mb-3">2. Private Rooms</h3>
              <div class="form-group mb-0">
                <label for="num_rooms">Number of Private Rooms:</label>
                <input type="number" id="num_rooms" name="num_rooms" required />
              </div>

              <div id="room-dimensions-container" class="mt-3"></div>
            </div>

            <div class="sac-card mt-4">
              <h3 class="h5 mb-3">3. Shared Space Preferences</h3>
              <div class="form-group mb-0">
                <div
                  class="d-flex justify-content-between align-items-baseline mb-2"
                >
                  <label for="alpha" class="mb-0">Value of shared space:</label>
                  <span
                    id="alpha-value"
                    class="font-weight-bold"
                    style="font-size: 1.25rem; color: var(--highlight-color);"
                    >0.75</span
                  >
                </div>
                <input
                  type="range"
                  id="alpha"
                  name="alpha"
                  min="0"
                  max="1"
                  step="0.01"
                  value="0.75"
                  class="w-100"
                  style="margin: 0 0 15px 0; padding: 0;"
                />
                <small class="form-text text-muted mb-0">
                  <details>
                    <summary
                      style="cursor: pointer; color: var(--highlight-color);"
                      >What is this?</summary
                    >
                    <div class="mt-2 p-2 bg-light rounded small border">
                      0 if the shared space is not taken into account of the
                      calculation.<br />
                      1 if the value per area of the shared space is considered the
                      same as the value per area of the rooms.<br />
                      <strong>Default: 0.75</strong>. The area of the shared
                      space is considered to be worth 3/4 of the value of the
                      private rooms.
                    </div>
                  </details>
                </small>
              </div>
            </div>

            <button
              type="submit"
              class="btn btn-primary btn-block mt-4 compute-btn"
              >Compute Fair Split <i class="fas fa-calculator ml-2"></i></button
            >
          </form>
        </div>

        <div class="col-lg-6">
          <div id="warning"></div>
          <div id="result"></div>
          <div class="room-visualization" id="room-visualization"></div>
        </div>
      </div>

      <div class="row mt-5 pt-4 border-top">
        <div class="col-md-8 mx-auto">
          <h3 class="h4 mb-3">Why this tool?</h3>
          <p>
            This simple calculator is my small contribution to help those
            navigating the housing crisis. Finding a place is hard enough;
            splitting the rent shouldn't add to the stress.
          </p>
          <p>
            If you are looking to rent a place with others, this tool provides a
            fair starting point for dividing costs. It calculates each person's
            share based on their private room size and the common areas.
          </p>
          <p>
            It's meant to save time and energy in cities where finding
            accommodation is already a challenge. If you find it useful, please
            share it with others!
          </p>
          <p class="text-center mt-4 text-muted small">
            Have suggestions or found a bug? <a href="/contact/">Reach out!</a>
          </p>
        </div>
      </div>

      <!-- Visible FAQ Section for SEO -->
      <div class="row mt-5">
        <div class="col-md-8 mx-auto">
          <h2 class="h4 mb-4 text-center">Frequently Asked Questions</h2>

          <div class="mb-4">
            <h3 class="h6 font-weight-bold">
              How to split rent fairly in a shared apartment?
            </h3>
            <p class="text-muted">
              The fairest way to split rent is based on room size. Calculate
              each room's proportion of the total private square footage, then
              factor in shared areas. The SHARE Calculator automates this by
              dividing rent proportionally based on room dimensions and a
              configurable shared space value.
            </p>
          </div>

          <div class="mb-4">
            <h3 class="h6 font-weight-bold">
              How to share rent with roommates and common areas?
            </h3>
            <p class="text-muted">
              When figuring out how to share rent, common areas like living
              rooms and kitchens should be factored in. The SHARE Calculator
              uses a configurable 'shared space value' (0-1) to determine how
              much weight shared areas carry. A value of 0.75 means shared space
              is worth 75% of private room value.
            </p>
          </div>
        </div>
      </div>
    </article>
  </main>

  <script is:inline defer src="/js/sac_script.js"></script>
</MainLayout>
