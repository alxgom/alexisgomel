    <div class="container">
      <a href="#Current" class="cv-nav-link">About</a>
      <a href="#Skills" class="cv-nav-link">Skills</a>
      <a href="#Experience" class="cv-nav-link">Experience</a>
      <a href="#Formation" class="cv-nav-link">Formation</a>
      <a href="#Teaching" class="cv-nav-link">Teaching</a>
      <a href="#Publications" class="cv-nav-link">Publications</a>
      <a href="#Presentations and congresses" class="cv-nav-link"
        >Presentations</a
      >
      <a href="#Past_jobs" class="cv-nav-link">Other jobs</a>
    </div>
  </div>

