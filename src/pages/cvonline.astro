---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE_TITLE } from "../consts";

// Import Components
import LanguageChart from "../components/cv/LanguageChart.astro";
import SkillGroup from "../components/cv/SkillGroup.astro";
import Lightbox from "../components/Lightbox.astro";

const currentLang = "en";
const alternateHref = "/es/cvonline";
const advancedSkills = [
  { name: "Python", experience: "+8yrs" },
  { name: "Matlab", experience: "+7yrs" },
  { name: "Git", experience: "+5yrs" },
];

const intermediateSkills = [
  { name: "Latex", experience: "+6yrs" },
  { name: "SQL -  BigQuery", experience: "1 year" },
  { name: "Power BI & LookerStudio", experience: "+6 mos" },
];

const beginnerSkills = [
  { name: "HTML", experience: "+1yrs" },
  { name: "Spark", experience: "New" },
];
---

<MainLayout
  title="Curriculum Vitae (CV) | Alexis Gomel - Physicist & Data Scientist"
  description="View my professional experience, skills in Python and Matlab, and academic background in Physics and Data Science."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />
  <script
    is:inline
    type="text/javascript"
    src="https://cdn.jsdelivr.net/gh/pcooksey/bibtex-js@1.0.0/src/bibtex_js.min.js"
  ></script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alexis Gomel",
      "jobTitle": "Physicist, Data Scientist & Data Analyst",
      "url": "https://alexisgomel.com/cvonline",
      "image": "https://alexisgomel.com/assets/imgs/alexis_gomel.jpg",
      "sameAs": [
        "https://www.linkedin.com/in/alexis-gomel-95484278/",
        "https://github.com/alxgom",
        "https://www.researchgate.net/profile/Alexis-Gomel"
      ],
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "University of Geneva",
          "sameAs": "https://www.unige.ch/"
        },
        {
          "@type": "CollegeOrUniversity",
          "name": "University of Buenos Aires",
          "sameAs": "https://www.uba.ar/"
        }
      ],
      "knowsAbout": [
        "Physics",
        "Data Science",
        "Data Analysis",
        "Nonlinear Dynamics",
        "Machine Learning",
        "Python",
        "SQL",
        "BigQuery",
        "Matlab"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Job Seeker / Freelance"
      },
      "description": "Physicist and Data Scientist specializing in nonlinear dynamics, data analysis, and complex systems."
    }
  </script>

  <div class="cv-subheader mb-5">
    <div class="container">
      <a
        href="#Current"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="CV - About">About</a
      >
      <a
        href="#Experience"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="CV - Experience">Experience</a
      >
      <a
        href="#Skills"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="CV - Skills">Skills</a
      >
      <a
        href="#Formation"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="CV - Formation">Formation</a
      >
      <a
        href="#Teaching"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="CV - Teaching">Teaching</a
      >
      <a
        href="#Publications"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="CV - Publications">Publications</a
      >
      <a
        href="#Presentations and congresses"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="CV - Presentations">Presentations</a
      >
      <a
        href="#Past_jobs"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="CV - Other jobs">Other jobs</a
      >
    </div>
  </div>

  <div class="container mt-5 pt-5">
    <section id="Current" class="section mt-3">
      <div class="container">
        <h1 class="text-center mb-5" style="font-weight: bold;">
          Online CV & Professional Experience
        </h1>
        <h2
          class="section-title mb-4 text-center"
          style="font-weight: bold; font-size: 40px;"
        >
          About me
        </h2>
        <div class="row align-items-center">
          <div class="col-md-8 text-left">
            <p class="mb-2 pb-2">
              I am a physicist with a passion for nonlinear dynamics, data
              science, complex systems, early warnings, statistical mechanics
              and its applications to many systems. My research interests also
              extend to education and the fields of generative AI and data
              science.
            </p>
            <p class="mb-5 pb-4">
              My professional journey includes research in nonlinear dynamics
              and data science, with recent roles applying these skills to
              digital analytics.
            </p>
          </div>
          <div class="col-md-4 text-center">
            <div class="general-img-holder mb-3">
              <img
                src="/assets/imgs/wordcloud_liviano.webp"
                alt="Image generated by webscraping the keywords from all the articles since 2020 in the jouirnal of nonlinear dynamics"
                class="img-fluid"
              />
            </div>
            <p class="mb-2 pb-2" style="font-style: italic; font-size: 0.9em;">
              “Using a term like nonlinear science is like referring to the bulk
              of zoology as the study of non-elephant animals.” – Stanislaw
              Ulam.
            </p>
          </div>
        </div>
      </div>
      <a href="#Experience" class="section-arrow" aria-label="Go to Experience">
        <i class="ti-angle-down"></i>
      </a>
    </section>

    <section id="Experience" class="section mt-3">
      <div class="container text-center">
        <h2
          class="section-title mb-4"
          style="font-weight: bold; font-size: 40px;"
        >
          Professional Experience
        </h2>
        <div class="mb-2 pb-4"></div>
      </div>

      <div class="container">
        <div class="row">
          <div class="col-12">
            <h3
              class="section-title mb-2"
              style="font-weight: bold; font-size: 24px;"
            >
              Data Analyst
            </h3>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              R&D for BI and digital marketing
            </h4>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              <a
                href="https://lamagnetica.com"
                target="_blank"
                rel="noopener noreferrer"
                style="text-decoration: underline;">LaMagnetica</a
              >
            </h4>
            <p class="text-muted mb-3">
              June 2025 – November 2025 | Barcelona, Spain
            </p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Impact Summary
            </h4>
            <p class="mb-4">
              Comprehensive optimization of data infrastructure and digital
              analytics, achieving a 93% reduction in processing volume and a
              10x speed improvement in critical queries. Design of scalable
              architectures on Google Cloud Platform and advanced custom
              visualizations for business dashboards.
            </p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Project Details and Key Achievements
            </h4>
            <ul class="mb-4 text-left">
              <li class="mb-2">
                <strong>BigQuery Architecture Optimization:</strong> Reduction of
                processed data volume through SQL query refactoring and implementation
                of table partitioning strategies, achieving up to 93% load reduction.
              </li>
              <li class="mb-2">
                <strong>Performance Tuning:</strong> Acceleration of complex query
                response times up to 10x, ensuring stability and fast loading of Looker
                Studio dashboards for the end client.
              </li>
              <li class="mb-2">
                <strong>Visualization Engineering:</strong> Development of custom
                visual components (e.g. Lipstick Plot / Bullet Chart) using D3.js
                integrated into Power BI, allowing effective representation of complex
                KPIs compared against business objectives.
              </li>
              <li class="mb-2">
                <strong>Data Quality and Integrity:</strong> Detected critical data
                gaps impacting session coherence. Engineered a solution to inject
                synthetic 'page_view' events to maintain session continuity, resulting
                in an 8% recovery of missing events for users who accepted cookies.
              </li>
              <li class="mb-2">
                <strong>Scientific Validation:</strong> Designed and implemented a
                comprehensive testing protocol. Established the first objective data
                fidelity KPIs to measure the success of session reconstruction for
                cookieless users.
              </li>
              <li class="mb-2">
                <strong>Operational Efficiency:</strong> Drastic reduction of operational
                costs (~97%) through query optimization and automation of daily update
                processes.
              </li>
            </ul>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Tech Stack Applied
            </h4>
            <p class="mb-4">
              Google BigQuery, SQL (Standard & Legacy), Looker Studio, Power BI
              (DAX), D3.js / JavaScript, Python (Automation).
            </p>

            <div class="text-center mt-4">
              <a
                href="/assets/reccomendation_letters/Referencia%20Alexis%20LM_Joana.pdf"
                class="btn btn-primary"
                download
                style="background-color: var(--primary); border-color: var(--primary); color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;"
              >
                Download Recommendation Letter
              </a>
            </div>

            <div class="mb-5 pb-4" style="border-bottom: 1px solid #eee;"></div>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <h3
              class="section-title mb-2"
              style="font-weight: bold; font-size: 24px;"
            >
              Postdoctoral Researcher
            </h3>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              Mathematics of Planet Earth Group
            </h4>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              University of Reading | United Kingdom
            </h4>
            <p class="text-muted mb-3">April 2023 – February 2024</p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Impact Summary
            </h4>
            <p class="mb-4">
              Research focused on climate "Tipping Points" using stochastic
              systems, including the development of algorithms for early warning
              signals in noisy time series and the evaluation of policy impacts
              via numerical simulations.
            </p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Project Details and Key Achievements
            </h4>
            <ul class="mb-4 text-left">
              <li class="mb-2">
                <strong>Climate Tipping Points:</strong> Conducted research on tipping
                points using stochastic systems to understand critical transitions.
              </li>
              <li class="mb-2">
                <strong>Early Warning Algorithms:</strong> Developed algorithms in
                Python and Matlab to detect early warning signals in noisy time series
                data.
              </li>
              <li class="mb-2">
                <strong>Policy Impact Evaluation:</strong> Performed numerical simulations
                to assess the impact of various environmental policies.
              </li>
              <li class="mb-2">
                <strong>International Collaboration:</strong> Collaborated with international
                teams under the <a
                  href="https://www.tipes.dk/tipping-points/"
                  target="_blank"
                  rel="noopener noreferrer">TIPES project</a
                > (EU Horizon 2020).
              </li>
            </ul>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Tech Stack Applied
            </h4>
            <p class="mb-4">
              Python, Matlab, Stochastic Modeling, Numerical Simulations, Time
              Series Analysis.
            </p>

            <div class="mb-5 pb-4" style="border-bottom: 1px solid #eee;"></div>

            <h3
              class="section-title mb-2"
              style="font-weight: bold; font-size: 24px;"
            >
              PhD Researcher & Teaching Assistant
            </h3>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              Nonlinear Dynamics & Climate Group
            </h4>
            <h4 class="mb-2" style="font-size: 18px; font-weight: normal;">
              University of Geneva | Geneva, Switzerland
            </h4>
            <p class="text-muted mb-3">May 2018 – February 2023</p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Impact Summary
            </h4>
            <p class="mb-4">
              Conducted multiscale modeling of gravity waves and fluids,
              designed real-time analysis pipelines for experimental data, and
              validated theoretical models against experimental results.
              Published 4 peer-reviewed articles.
            </p>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Project Details and Key Achievements
            </h4>
            <ul class="mb-4 text-left">
              <li class="mb-2">
                <strong>Multiscale Modeling:</strong> Modeled gravity waves and fluids
                over complex bathymetries.
              </li>
              <li class="mb-2">
                <strong>Real-time Experimentation Pipeline:</strong> Designed a pipeline
                at the University of Sydney to analyze water tank measurement files
                in real-time, accelerating the simulation-to-experiment cycle.
              </li>
              <li class="mb-2">
                <strong>Experimental Validation:</strong> Validated high-intensity
                laser spectra statistics using a custom Python analysis pipeline.
              </li>
              <li class="mb-2">
                <strong>Model Validation:</strong> Used experimental data to initialize
                theoretical simulations, providing rigorous model validation beyond
                visual comparison.
              </li>
              <li class="mb-2">
                <strong>Academic Output:</strong> Published 4 articles in high-impact
                peer-reviewed journals.
              </li>
              <li class="mb-2">
                <strong>Mentorship:</strong> Supervised a Master's student.
              </li>
            </ul>

            <h4 class="mb-2" style="font-weight: bold; font-size: 20px;">
              Tech Stack Applied
            </h4>
            <p class="mb-4">
              Python, Fluid Dynamics, Wave Modeling, Data Analysis, Real-time
              Processing.
            </p>

            <div class="mb-5 pb-4" style="border-bottom: 1px solid #eee;"></div>
          </div>
        </div>
      </div>
      <a href="#Skills" class="section-arrow" aria-label="Go to Skills">
        <i class="ti-angle-down"></i>
      </a>
    </section>

    <section id="Skills" class="section mt-3">
      <div class="container text-center">
        <h2
          class="section-title mb-4"
          style="font-weight: bold; font-size: 40px;"
        >
          Skills
        </h2>
        <div class="mb-2 pb-4"></div>
      </div>

      <div class="container text-center">
        <div class="row mx-auto">
          <SkillGroup
            title="Advanced"
            color="var(--primary)"
            height="150px"
            skills={advancedSkills}
          />

          <SkillGroup
            title="Intermediate"
            color="var(--primary)"
            brightness="1.2"
            opacity="0.8"
            height="100px"
            skills={intermediateSkills}
          />

          <SkillGroup
            title="Beginner"
            color="var(--primary)"
            brightness="1.5"
            opacity="0.5"
            height="60px"
            skills={beginnerSkills}
          />
        </div>
      </div>

      <div class="mb-2 pb-4"></div>

      <div class="container text-left">
        <section>
          <div class="columns">
            <div class="column">
              <div class="rectangle"></div>
              <div class="text">
                <h3>Data Science</h3>
                <p>
                  Data Analysis, Data Storytelling, Data Visualizations,
                  Statistics, Mathematical Modelling, Numerical Simulations Time
                  Series Analysis.
                </p>
              </div>
            </div>
            <div class="column">
              <div class="rectangle"></div>
              <div class="text">
                <h3>Mathematics</h3>
                <p>
                  Regressions, Fourier analysis, numerical integration,
                  extrapolation, interpolation, wavelet analysis, stochastic
                  simulations, nonlinear differential equations, linear algebra,
                  modelling.
                </p>
              </div>
            </div>
            <div class="column">
              <div class="rectangle"></div>
              <div class="text">
                <h3>Statistics</h3>
                <p>
                  Ensemble statistics, uncertainty estimation, PCA, k-means,
                  correlation, mutual information, unbiased statistical moments.
                </p>
              </div>
            </div>
            <div class="column">
              <div class="rectangle"></div>
              <div class="text">
                <h3>Physics</h3>
                <p>
                  Non-linear dynamics, Laser physics, Fluid Mechanics,
                  Statistical Physics
                </p>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="mb-2 pb-4"></div>

      <LanguageChart
        labels={["Spanish", "English", "French", "German"]}
        datasetLabel="Level"
      />

      <!-- CTA to Projects Portfolio -->
      <div class="container text-center mt-5 pt-4 mb-5 pb-4">
        <div class="row justify-content-center">
          <div class="col-md-8">
            <h3 class="mb-3" style="font-size: 28px; font-weight: bold;">
              Want to see these skills in action?
            </h3>
            <p class="mb-4" style="font-size: 18px;">
              Check out my portfolio to explore data visualizations, interactive
              dashboards, and projects showcasing Python, SQL, and more.
            </p>
            <a
              href="/projects"
              class="btn btn-primary btn-lg"
              style="background-color: var(--primary); border-color: var(--primary); color: white; padding: 15px 40px; text-decoration: none; border-radius: 8px; font-size: 18px; font-weight: bold; transition: all 0.3s ease;"
              onmouseover="this.style.transform='scale(1.05)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.2)';"
              onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';"
            >
              View My Projects →
            </a>
          </div>
        </div>
      </div>
    </section>
    <a
      href="#Formation"
      class="section-arrow"
      aria-label="Go to Academic Formation"
    >
      <i class="ti-angle-down"></i>
    </a>

    <section id="Formation" class="section mt-3">
      <div class="container text-center">
        <h2
          class="section-title mb-4 pb-4"
          style="font-weight: bold; font-size: 40px;"
        >
          Academic Formation
        </h2>

        <div class="row mx-auto">
          <div class="col-sm-6 col-md-6 mb-3">
            <h3
              class="section-title mb-3"
              style="font-weight: bold; font-size: 34px;"
            >
              PHD in Physical sciences
            </h3>
            <h4 class="section-title mb-2">
              Behavior of self-modulated waves in nonlinear systems
            </h4>
            <div class="img-holder">
              <style>
                .imagefac {
                  width: auto;
                  height: 100px;
                }
              </style>
              <img
                src="/assets/imgs/fac_sciences_noir.png"
                alt=""
                class="imagefac"
              />
              <h4 class="mb-3 pb-2" style="font-size: 20px;">
                University of Geneva <br />
                <a
                  href="https://www.unige.ch/gap/nonlinear/"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="font-size: 16px;">Nonlinearity and Climate Group</a
                >
              </h4>
              <p class="h6 mb-1 pb-2 font-weight-bold">Advisors</p>
              <p>Advisor: Jérôme Kasparian</p>
              <p>Co-advisor: Maura Brunetti</p>
            </div>
          </div>
          <div class="col-sm-6 col-md-6 mb-3">
            <h3
              class="section-title mb-3"
              style="font-weight: bold; font-size: 34px;"
            >
              Master in Physical sciences
            </h3>
            <h4 class="section-title mb-2">
              Rogue waves en lasers modulados en fase
            </h4>
            <h4 class="section-title mb-2">
              (Rogue waves in phase modulated lasers)
            </h4>
            <div class="img-holder">
              <img src="/assets/imgs/600px-UBA.png" alt="" class="imagefac" />
              <h4 class="mb-3 pb-2" style="font-size: 20px;">
                University of Buenos Aires
              </h4>
              <p class="h6 mb-1 pb-2 font-weight-bold">Advisors</p>
              <p>Advisor: Jorge Tredicce</p>
              <p>Co-advisor: Pablo Mininni</p>
            </div>
          </div>
        </div>
      </div>
      <a
        href="#Teaching"
        class="section-arrow"
        aria-label="Go to Teaching Experience"
      >
        <i class="ti-angle-down"></i>
      </a>
    </section>

    <div class="container text-center">
      <h2 class="section-title mb-4">Other formation</h2>
      <p>
        June 2022 - Introduction to Machine Learning, University of Lausanne
        (UNIL)
      </p>
    </div>

    <section id="Teaching" class="section mt-3">
      <div class="container text-center">
        <h2
          class="section-title mb-5 pb-4"
          style="font-weight: bold; font-size: 40px;"
        >
          Teaching Experience
        </h2>
        <div class="row mx-auto">
          <div class="col-sm-6 col-md-6 mb-3">
            <h3
              class="section-title mb-4 pb-3"
              style="font-weight: bold; font-size: 34px;"
            >
              University level
            </h3>

            <h4 class="mb-3 pb-3">University of Geneva</h4>
            <p style="font-weight: bold;">Teaching assistant</p>
            <p class="mb-2 pb-2 h5">February 2019 - July 2022</p>
            <p>
              Courses: Physics lab for biologist, Nonlinear Dynamics (in charge
              of the whole practice)
            </p>

            <div class="mb-5 pb-3"></div>
            <h4 class="mb-2 pb-3">University of Buenos Aires</h4>
            <p style="font-weight: bold;">Teaching assistant</p>
            <p class="mb-2 pb-2 h5">February 2016 - April 2016</p>
            <p>
              Courses: Introduction to thermodynamics and quantum mechanics.
            </p>
          </div>

          <div class="col-sm-6 col-md-6 mb-3">
            <h3
              class="section-title mb-4 pb-3"
              style="font-weight: bold; font-size: 34px;"
            >
              High school level
            </h3>
            <!--
            <h4 class="mb-3 pb-3">Paidea School</h4>
            <p style="font-weight: bold;">Physics replacement teacher</p>
            <h5 class="mb-2 pb-2">October 2017 - November 2017</h5>
            <p>Short physics replacement for the 16-17yrs old students.</p>
            -->
            <h4 class="mb-3 pb-3">River Plate High School</h4>
            <p style="font-weight: bold;">Math replacement teacher</p>
            <p class="mb-2 pb-2 h5">July 2015 - February 2016</p>
            <p>In charge of math for the 14-17yrs old students.</p>
            <h4 class="mb-3 pb-3">Boston High shcool</h4>
            <p style="font-weight: bold;">Math replacement teacher</p>
            <p class="mb-2 pb-2 h5">September 2015 - Dicember 2015</p>
            <p>In charge of math for the 16yrs old students.</p>
            <div class="mb-5 pb-2"></div>
          </div>
        </div>
      </div>
      <a
        href="#Publications"
        class="section-arrow"
        aria-label="Go to Publications"
      >
        <i class="ti-angle-down"></i>
      </a>
    </section>

    <section id="Publications" class="section mt-3">
      <div class="container text-center">
        <div class="bibtex_template">
          <div style="margin-left: 10px; margin-bottom:5px;">
            <span
              class="title"
              style="font-size: 28px;  font-family: American Typewriter;"
            ></span>
          </div>
          <div class="if author">
            <span class="if year">
              <span class="year" style="font-size: 20px"></span>,
            </span>
            <span class="author" style="font-size: 20px"></span>
            <span class="if url" style="margin-left: 20px">
              <a class="url" style="color:black; font-size:10px"
                >(view online)</a
              >
            </span>
            <h6 class="mb-1 pb-1"></h6>
          </div>
        </div>

        <h2
          class="section-title mb-6 pb-3"
          style="font-weight: bold; font-size: 40px;"
        >
          Publications
