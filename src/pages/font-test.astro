  <script is:inline>
    // Palette Definition
    const sevillePalette = [
      { name: "Almegre Red", hex: "#A50034", var: "--almegre-red" },
      { name: "Triana Green", hex: "#115740", var: "--triana-green" },
      { name: "Lapiz Lazuli", hex: "#26619C", var: "--lapiz-lazuli-blue" },
      { name: "Albero Pantone", hex: "#FFAB60", var: "--albero-pantone" },
      { name: "White", hex: "#FFFFFF", var: "--white" },
      { name: "Cloud Dance", hex: "#F0EEE9", var: "--cloud-dance-white" },
      { name: "Light Gray", hex: "#D4D4D4", var: "--light-gray" },
      { name: "Dark Gray", hex: "#434343", var: "--dark-gray" },
      { name: "Black", hex: "#000000", var: "--black" },
    ];

    // --- Helper Functions for Contrast ---
    function hexToRgb(hex) {
      const shorthandRegex = /^#?([a-f\d])([a-f\d])([a-f\d])$/i;
      hex = hex.replace(shorthandRegex, function (m, r, g, b) {
        return r + r + g + g + b + b;
      });
      const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      return result
        ? {
            r: parseInt(result[1], 16),
            g: parseInt(result[2], 16),
            b: parseInt(result[3], 16),
          }
        : null;
    }

    function luminance(r, g, b) {
      const a = [r, g, b].map(function (v) {
        v /= 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      });
      return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
    }

    function calculateRatio(hex1, hex2) {
      const rgb1 = hexToRgb(hex1);
      const rgb2 = hexToRgb(hex2);
      if (!rgb1 || !rgb2) return 0;
      const lum1 = luminance(rgb1.r, rgb1.g, rgb1.b);
      const lum2 = luminance(rgb2.r, rgb2.g, rgb2.b);
      const brightest = Math.max(lum1, lum2);
      const darkest = Math.min(lum1, lum2);
      return (brightest + 0.05) / (darkest + 0.05);
    }

    // --- Render Logic ---
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Render Swatches
      const swatchesContainer = document.getElementById("palette-swatches");
      if (swatchesContainer) {
        sevillePalette.forEach((color) => {
          const swatch = document.createElement("div");
          swatch.style.cssText = `
                        width: 140px; 
                        padding: 15px; 
                        border-radius: 8px; 
                        background-color: ${color.hex}; 
                        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
                        display: flex; flex-direction: column; justify-content: flex-end;
                        color: ${calculateRatio(color.hex, "#000000") > 4.5 ? "#000000" : "#FFFFFF"};
                        border: 1px solid rgba(0,0,0,0.1);
                    `;
          swatch.innerHTML = `
                        <div style="font-weight:bold; font-size:14px;">${color.name}</div>
                        <div style="font-family:monospace; opacity:0.8;">${color.hex}</div>
                        <div style="font-size:10px; opacity:0.6; margin-top:5px;">${color.var}</div>
                    `;
          swatchesContainer.appendChild(swatch);
        });
      }

      // 2. Render Contrast Matrix
      const table = document.getElementById("contrast-matrix");
      if (table) {
        // Header Row
        const headerRow = document.createElement("tr");
        headerRow.appendChild(document.createElement("th")); // Empty corner
        sevillePalette.forEach((colColor) => {
          const th = document.createElement("th");
          th.textContent = colColor.name.split(" ")[0]; // Short name
          th.style.padding = "10px";
          th.style.writingMode = "vertical-rl";
          th.style.transform = "rotate(180deg)";
          th.style.height = "100px";
          headerRow.appendChild(th);
        });
        table.appendChild(headerRow);

        // Data Rows
        sevillePalette.forEach((rowColor) => {
          const tr = document.createElement("tr");

          // Row Header
          const th = document.createElement("th");
          th.textContent = rowColor.name;
          th.style.textAlign = "right";
          th.style.padding = "5px 10px";
          th.style.whiteSpace = "nowrap";
          tr.appendChild(th);

          sevillePalette.forEach((colColor) => {
            const td = document.createElement("td");
            const ratio = calculateRatio(rowColor.hex, colColor.hex);

            td.textContent = ratio.toFixed(2);
            td.style.backgroundColor = rowColor.hex;
            td.style.color = colColor.hex;
            td.style.padding = "10px";
            td.style.textAlign = "center";
            td.style.fontWeight = ratio >= 4.5 ? "900" : "400";
            td.style.textDecoration = ratio >= 3.0 ? "none" : "none";
            td.style.border = "1px solid rgba(255,255,255,0.1)"; // Subtle border

            // Icon pass/fail
            if (ratio >= 4.5) td.textContent += " ✓";

            // Tooltip
            td.title = `BG: ${rowColor.name}\nFG: ${colColor.name}\nRatio: ${ratio.toFixed(2)}`;

            tr.appendChild(td);
          });
          table.appendChild(tr);
        });
      }
    });
  </script>
  <script is:inline src="https://d3js.org/d3.v7.min.js"></script>
  <script is:inline>
    // Data for the plot
    const data = Array.from({ length: 20 }, (_, i) => ({
      x: i,
      y: Math.sin(i / 2) * 10 + i + Math.random() * 5,
    }));

    function drawPlot(containerId, headingFontClass, bodyFontClass) {
      const container = document.getElementById(containerId);
      if (!container) return;

      // Get computed styles to match fonts
      // We need to find the parent .font-section to know which font to use
      const parentSection = container.closest(".font-section");

      // Determine fonts based on the section class
      let headingFont = "inherit";
      let bodyFont = "inherit";

      if (parentSection) {
        // This is a bit of a hack to get the font family from the CSS classes
        // In a real app we might pass these explicitly
        const computedStyle = window.getComputedStyle(parentSection);
        // For combos, we might need to be more specific, but inheriting from container usually works
        // if we set the class on the text elements correctly
      }

      const margin = { top: 40, right: 30, bottom: 40, left: 50 };
      const width = container.clientWidth - margin.left - margin.right;
      const height = 300 - margin.top - margin.bottom;

      // Clear previous
      container.innerHTML = "";

      // Add title
      const title = document.createElement("div");
      title.className = "plot-title";
      title.textContent = "Sample Data Distribution";
      // Title inherits heading font from parent section automatically via CSS
      container.appendChild(title);

      const svg = d3
        .select(container)
        .append("svg")
        .attr("width", width + margin.left + margin.right)
        .attr("height", height + margin.top + margin.bottom)
        .append("g")
        .attr("transform", `translate(${margin.left},${margin.top})`);

      const x = d3
        .scaleLinear()
        .domain(d3.extent(data, (d) => d.x))
        .range([0, width]);

      const y = d3
        .scaleLinear()
        .domain([0, d3.max(data, (d) => d.y)])
        .range([height, 0]);

      // X Axis
      svg
        .append("g")
        .attr("transform", `translate(0,${height})`)
        .call(d3.axisBottom(x))
        .attr("class", "axis x-axis")
        .style("font-family", "inherit"); // Inherit from parent

      // Y Axis
      svg
        .append("g")
        .call(d3.axisLeft(y))
        .attr("class", "axis y-axis")
        .style("font-family", "inherit"); // Inherit from parent

      // Line
      svg
        .append("path")
        .datum(data)
        .attr("fill", "none")
        .attr("stroke", "var(--highlight-color)")
        .attr("stroke-width", 2)
        .attr(
          "d",
          d3
            .line()
            .x((d) => x(d.x))
            .y((d) => y(d.y)),
        );

      // Dots
      svg
        .selectAll(".dot")
        .data(data)
        .enter()
        .append("circle")
        .attr("cx", (d) => x(d.x))
        .attr("cy", (d) => y(d.y))
        .attr("r", 4)
        .attr("fill", "#ff7a57");

      // X Label
      svg
        .append("text")
        .attr("class", "axis-label")
        .attr("text-anchor", "middle")
        .attr("x", width / 2)
        .attr("y", height + 35)
        .text("Time (s)")
        .style("font-family", "inherit"); // Inherit from parent

      // Y Label
      svg
        .append("text")
        .attr("class", "axis-label")
        .attr("text-anchor", "middle")
        .attr("transform", "rotate(-90)")
        .attr("y", -35)
        .attr("x", -height / 2)
        .text("Amplitude (a.u.)")
        .style("font-family", "inherit"); // Inherit from parent
    }

    // Render all plots
    document.addEventListener("DOMContentLoaded", () => {
      const sections = [
        "montserrat",
        "montserrat-alt",
        "times",
        "arial",
        "alegreya",
        "alegreya-sans",
        "combo-montalt-mont",
        "combo-mont-alegreya",
        "combo-alegreya-mix",
        "combo-times-alegreyas",
        "combo-times-mont",
        "georgia",
      ];

      sections.forEach((id) => {
        // For combos, we need to handle the font inheritance carefully
        // The plot container is inside the .font-section, so it inherits the body font by default
        // The title is a div inside plot-container, so it also inherits body font by default
        // We need to explicitly set the title font for combos

        drawPlot(`plot-${id}`);

        // Fix title fonts for combos
        const container = document.getElementById(`plot-${id}`);
        if (container) {
          const section = container.closest(".font-section");
          const title = container.querySelector(".plot-title");

          if (section && title) {
            if (section.classList.contains("combo-montalt-mont")) {
              title.style.fontFamily = '"Montserrat Alternates", sans-serif';
            } else if (section.classList.contains("combo-mont-alegreya")) {
              title.style.fontFamily = '"Montserrat", sans-serif';
            } else if (section.classList.contains("combo-alegreya-mix")) {
              title.style.fontFamily = '"Alegreya", serif';
            } else if (
              section.classList.contains("combo-times-alegreyas") ||
              section.classList.contains("combo-times-mont")
            ) {
              title.style.fontFamily = '"Times New Roman", Times, serif';
            }
          }
        }
      });
    });
  </script>
</MainLayout>
