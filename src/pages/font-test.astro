---
import MainLayout from "../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/font-test/";
---

<MainLayout
  title="Font Testing Page"
  description="Internal font testing page"
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
    slot="head"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,500;0,700;1,400&family=Alegreya+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Montserrat+Alternates:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
    rel="stylesheet"
    slot="head"
  />

  <style>
    .font-test-container {
      max-width: 1000px;
      margin: 120px auto 60px;
      padding: 0 20px;
    }

    .font-section {
      margin-bottom: 60px;
      padding: 30px;
      border: 1px solid var(--light-gray);
      border-radius: 12px;
      background: var(--cloud-dance-white);
    }

    .font-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--highlight-color);
      margin-bottom: 20px;
      font-family: system-ui, sans-serif;
    }

    .hero-sample {
      margin-bottom: 30px;
    }

    .hero-sample .subtitle {
      font-size: 25px;
      font-weight: 500;
      margin-bottom: 0;
      opacity: 0.8;
    }

    .hero-sample .title {
      font-size: 74px;
      font-weight: bold;
      margin-bottom: 0;
      line-height: 1.1;
      font-family: inherit;
    }

    .hero-sample .tagline {
      font-size: 22px;
      margin-top: -5px;
    }

    .headings-sample h1 {
      font-size: 2.5rem;
      margin-bottom: 10px;
    }
    .headings-sample h2 {
      font-size: 2rem;
      margin-bottom: 10px;
    }
    .headings-sample h3 {
      font-size: 1.75rem;
      margin-bottom: 10px;
    }
    .headings-sample h4 {
      font-size: 1.5rem;
      margin-bottom: 10px;
    }
    .headings-sample h5 {
      font-size: 1.25rem;
      margin-bottom: 10px;
    }
    .headings-sample h6 {
      font-size: 1rem;
      margin-bottom: 10px;
    }

    .body-sample {
      font-size: 1rem;
      line-height: 1.6;
      max-width: 700px;
    }

    .body-sample p {
      margin-bottom: 1rem;
    }

    /* Font Families */
    .font-montserrat {
      font-family: "Montserrat", sans-serif;
    }
    .font-montserrat-alt {
      font-family: "Montserrat Alternates", sans-serif;
    }
    .font-alegreya {
      font-family: "Alegreya", serif;
    }
    .font-alegreya-sans {
      font-family: "Alegreya Sans", sans-serif;
    }
    .font-times {
      font-family: "Times New Roman", Times, serif;
    }
    .font-arial {
      font-family: Arial, Helvetica, sans-serif;
    }
    .font-georgia {
      font-family: Georgia, serif;
    }

    /* Plot styles */
    .plot-container {
      margin-top: 30px;
      border: 1px solid var(--light-gray);
      border-radius: 8px;
      padding: 20px;
      background: var(--white);
    }
    .plot-title {
      font-size: 1.25rem;
      font-weight: bold;
      margin-bottom: 10px;
      text-align: center;
    }
    .plot-svg {
      width: 100%;
      height: 300px;
      overflow: visible;
    }
    .axis-label {
      font-size: 0.9rem;
    }
    .tick text {
      font-size: 0.8rem;
    }

    /* Combo styles */
    .combo-montalt-mont .hero-sample,
    .combo-montalt-mont .headings-sample {
      font-family: "Montserrat Alternates", sans-serif;
    }
    .combo-montalt-mont .body-sample {
      font-family: "Montserrat", sans-serif;
    }

    .combo-mont-alegreya .hero-sample,
    .combo-mont-alegreya .headings-sample {
      font-family: "Montserrat", sans-serif;
    }
    .combo-mont-alegreya .body-sample {
      font-family: "Alegreya", serif;
    }

    .combo-alegreya-mix .hero-sample,
    .combo-alegreya-mix .headings-sample {
      font-family: "Alegreya", serif;
    }
    .combo-alegreya-mix .body-sample {
      font-family: "Alegreya Sans", sans-serif;
    }

    .combo-times-alegreyas .hero-sample,
    .combo-times-alegreyas .headings-sample {
      font-family: "Times New Roman", Times, serif;
    }
    .combo-times-alegreyas .body-sample {
      font-family: "Alegreya Sans", sans-serif;
    }

    .combo-times-mont .hero-sample,
    .combo-times-mont .headings-sample {
      font-family: "Times New Roman", Times, serif;
    }
    .combo-times-mont .body-sample {
      font-family: "Montserrat", sans-serif;
    }

    @media (max-width: 768px) {
      .hero-sample .title {
        font-size: 40px;
      }
      .hero-sample .subtitle {
        font-size: 18px;
      }
      .hero-sample .tagline {
        font-size: 16px;
      }
    }
