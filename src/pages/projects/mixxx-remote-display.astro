---
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import einkAlongside from "../../assets/imgs/Projects/eink_mixxx_display_alongside.jpg";
import einkCloseup from "../../assets/imgs/Projects/eink_mixxx_display_closeup.jpg";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/es/projects/mixxx-remote-display/";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Mixxx Remote Display",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Android",
  description:
    "A wireless companion display for Mixxx that helps dancers discover the artist and title of the music they are dancing to in real time.",
  url: "https://alexisgomel.com/projects/mixxx-remote-display/",
  downloadUrl: "https://github.com/alxgom/mixxx-bt-display/releases",
  author: {
    "@type": "Person",
    name: "Alexis Gomel",
    url: "https://alexisgomel.com",
  },
  keywords:
    "Mixxx display, DJ screen for dancers, Android e-ink DJ, music discovery tool, social dance technology",
});
---

<MainLayout
  title="Bring music discovery to the dance floor with Mixxx Remote Display | Alexis Gomel"
  description="A wireless 'Now Playing' screen for Mixxx. Give your dancers a low-friction way to discover artists and songs while they dance."
  currentLang={currentLang}
  alternateHref={alternateHref}
  image="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
>
  <meta
    slot="head"
    name="keywords"
    content="Mixxx remote display, now playing screen, dancer discovery tool, android dj app, e-ink dj display, artist recognition social dance"
  />
  <script type="application/ld+json" set:html={schema} slot="head" />

  <style>
    .display-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.25rem;
    }
    .display-hero {
      padding: 8rem 1rem 6rem;
      background: var(--cloud-dance-white);
      position: relative;
      overflow: hidden;
    }
    /* Subtle technical background pattern */
    .display-hero::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: radial-gradient(var(--light-gray) 1px, transparent 1px);
      background-size: 30px 30px;
      opacity: 0.2;
      pointer-events: none;
    }
    .display-hero .eyebrow {
      font-family: var(--font-family-monospace);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: 1rem;
      display: block;
    }
    .display-hero h1 {
      font-size: clamp(2.2rem, 6vw, 3.8rem);
      font-weight: 900;
      line-height: 1.05;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
    }
    .display-hero .lead {
      max-width: 620px;
      margin: 0 0 2.5rem;
      font-size: 1.2rem;
      color: var(--dark-gray);
      line-height: 1.6;
    }
    .btn-hero-primary {
      display: inline-block;
      background: var(--primary);
      color: #fff;
      font-weight: 700;
      padding: 0.9rem 2rem;
      border-radius: 0; /* Sharp corner */
      text-decoration: none;
      transition: all 0.2s ease;
      margin-right: 1rem;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.9rem;
    }
    .btn-hero-primary:hover {
      background: var(--dark);
      color: #fff;
      transform: translateY(-2px);
    }
    .btn-hero-outline {
      display: inline-block;
      border: 1px solid var(--dark-gray);
      color: var(--dark-gray);
      font-weight: 700;
      padding: 0.9rem 2rem;
      border-radius: 0; /* Sharp corner */
      text-decoration: none;
      transition: all 0.2s ease;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.9rem;
    }
    .btn-hero-outline:hover {
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-2px);
    }
    .display-section {
      padding: 5rem 0;
      border-top: 1px solid var(--light-gray);
    }
    .display-section p a {
      color: var(--primary);
      text-decoration: underline;
      font-weight: 600;
    }
    .display-section p a:hover {
      color: var(--dark);
    }
    .display-section h2 {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      letter-spacing: -0.01em;
    }
    .story-quote {
      border-left: 2px solid var(--primary);
      padding: 1.5rem 2rem;
      margin: 2rem 0;
      font-style: italic;
      color: var(--dark-gray);
      background: var(--cloud-dance-white);
      font-size: 1.1rem;
    }
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }
    .feature-item {
      padding: 2rem 0;
      border-top: 1px solid var(--light-gray);
      transition: border-color 0.3s;
    }
    .feature-item:hover {
      border-top-color: var(--primary);
    }
    .feature-item h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .feature-item p {
      color: #666;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .screenshot-frame {
      overflow: hidden;
      box-shadow: 20px 20px 0px var(--albero-pantone); /* Hard offset shadow instead of soft glow */
      border: 1px solid var(--dark);
      background: #000;
      transition: all 0.3s ease;
    }
    .screenshot-frame:hover {
      transform: translate(-4px, -4px);
      box-shadow: 24px 24px 0px var(--albero-pantone);
    }
    .screenshot-frame img {
      display: block;
      width: 100%;
      filter: grayscale(0.2) contrast(1.1);
      transition: all 0.4s ease;
    }
    .screenshot-frame:hover img {
      filter: grayscale(0) contrast(1.1);
      transform: scale(1.02);
    }
    .tech-badge {
      display: inline-block;
      border: 1px solid var(--light-gray);
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
      font-family: var(--font-family-monospace);
      font-weight: 500;
      margin: 0.25rem 0.2rem;
      color: var(--dark-gray);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .primary-badge {
      border-color: var(--primary);
      color: var(--primary);
    }
    .success-badge {
      border-color: var(--triana-green);
      color: var(--triana-green);
    }
    .hero-frame {
      transform: perspective(1000px) rotateY(-8deg) rotateX(2deg) skewY(1deg);
    }
    .hero-frame:hover {
      transform: perspective(1000px) rotateY(-2deg) rotateX(1deg);
    }
    /* Pipeline and setup steps - Anti-AI UI elements */
    .pipeline-flow {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.5rem;
      margin: 3rem 0;
      border: 1px solid var(--light-gray);
      padding: 2rem;
      background: var(--cloud-dance-white);
      position: relative;
    }
    .pipeline-step {
      position: relative;
    }
    .pipeline-step::after {
      content: "\2192"; /* Right arrow */
      position: absolute;
      right: -1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--primary);
      font-weight: bold;
      font-size: 1.5rem;
    }
    .pipeline-step:last-child::after {
      content: "";
    }
    .pipeline-step-num {
      font-family: var(--font-family-monospace);
      font-size: 0.75rem;
      color: var(--primary);
      margin-bottom: 0.5rem;
      display: block;
      font-weight: 700;
    }
    .pipeline-step h4 {
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .pipeline-step p {
      font-size: 0.85rem;
      color: var(--dark-gray);
      margin: 0;
      line-height: 1.5;
    }
    .setup-steps {
      list-style: none;
      padding: 0;
      margin: 2rem 0;
    }
    .setup-step-item {
      display: flex;
      align-items: flex-start;
      margin-bottom: 2rem;
    }
    .setup-step-num {
      font-family: var(--font-family-monospace);
      font-weight: 900;
      color: var(--primary);
      font-size: 1.25rem;
      width: 45px;
      flex-shrink: 0;
      line-height: 1;
      padding-top: 2px;
    }
    .setup-step-content {
      border-left: 2px solid var(--light-gray);
      padding-left: 1.5rem;
    }
    .setup-step-content h4 {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    .setup-step-content p {
      font-size: 0.95rem;
      color: #666;
      margin: 0;
      line-height: 1.5;
    }
    @media (max-width: 991px) {
      .display-hero {
        text-align: left;
        padding: 6rem 1rem 4rem;
      }
      .badge-row {
        justify-content: flex-start;
        display: flex;
        flex-wrap: wrap;
      }
      .hero-frame {
        transform: none;
        box-shadow: 10px 10px 0px var(--albero-pantone);
      }
    }
    @media (max-width: 767px) {
      .display-hero h1 {
        font-size: 2.2rem;
      }
      .pipeline-flow {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
      .pipeline-step::after {
        content: "\2193"; /* Down arrow */
        right: auto;
        left: 50%;
        bottom: -2rem;
        top: auto;
        transform: translateX(-50%);
      }
    }
    
    /* CTA Section - Anti-AI UI/UX layout */
    .display-cta {
      margin-top: 5rem;
      padding: 4rem 1.25rem;
      border-top: 1px solid var(--light-gray);
    }
    .display-cta-inner {
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
    }
    .display-cta h2 {
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
    }
    .display-cta .lead {
      max-width: 600px;
      margin: 0 auto 3rem;
      color: var(--dark-gray);
      font-size: 1.05rem;
    }
    .cta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 3rem;
      text-align: left;
    }
    .cta-card {
      border-top: 2px solid var(--light-gray);
      padding-top: 1.5rem;
      display: flex;
      flex-direction: column;
      height: 100%;
      transition: border-color 0.2s;
    }
    .cta-card:hover {
      border-top-color: var(--primary);
    }
    .cta-label {
      font-family: var(--font-family-monospace);
      font-size: 0.75rem;
      color: var(--primary);
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 0.5rem;
      display: block;
    }
    .cta-card h3 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .cta-card p {
      font-size: 0.9rem;
      color: #666;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }
    .cta-link {
      font-family: var(--font-family-monospace);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--dark);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: inline-flex;
      align-items: center;
      transition: color 0.2s;
    }
    .cta-link:hover {
      color: var(--primary);
    }
  </style>

  <div class="display-hero">
    <div class="display-container">
      <div class="row align-items-center text-start">
        <div class="col-lg-6">
          <p class="eyebrow">Companion Screen for Mixxx</p>
          <h1>Mixxx Remote Display brings music discovery to the dance floor.</h1>
          <p class="lead">
            This wireless "Now Playing" screen helps dancers identify tracks and artists without interrupting the DJ. It works on any Android device using Bluetooth.
          </p>
          <div class="hero-actions">
            <a
              href="https://github.com/alxgom/mixxx-bt-display"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-hero-primary"
            >
              Get the APK
            </a>
            <a href="#how-it-works" class="btn-hero-outline">How it works</a>
          </div>
        </div>
        <div class="col-lg-6 mt-5 mt-lg-0">
          <div class="screenshot-frame hero-frame">
            <Image
              src={einkAlongside}
              alt="Mixxx running on a laptop alongside the remote discovery display"
              class="img-fluid"
              loading="eager"
              width={600}
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="display-container">
    <section class="display-section">
      <div class="row align-items-center">
        <div class="col-md-7">
          <h2>Lowering the friction of music discovery</h2>
          <p>
            When someone hears a song they love at a social dance, they often
            forget to ask the DJ about it later. I built this app to close that
            gap. It provides a passive way for people to learn about the music
            without breaking the social flow of the party.
          </p>
          <div class="story-quote">
            "Those who want to learn have a low-friction entrance into discovery,
            and those who just want to dance don't need to notice it even exists."
          </div>
          <p>
            The app works on <strong>any Android phone or tablet</strong>. By using 
            Bluetooth, the display can be placed anywhere in the venue without 
            relying on the local Wi-Fi. It is a set-and-forget tool for the DJ 
            that updates automatically every time a song changes.
          </p>
        </div>
        <div class="col-md-5 mt-4 mt-md-0">
          <div class="screenshot-frame">
            <Image
              src={einkCloseup}
              alt="Close-up of the discovery display showing the artist and track title"
              class="img-fluid"
              width={500}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="display-section">
      <h2>Capabilities</h2>
      <div class="features-grid">
        <div class="feature-item">
          <h3>Bluetooth Connectivity</h3>
          <p>
            Uses Bluetooth SPP (RFCOMM) for a direct link to the DJ laptop. 
            No internet or router required, ensuring reliability in any venue.
          </p>
        </div>
        <div class="feature-item">
          <h3>Lightweight and Efficient</h3>
          <p>
            Tuned to send minimal data. It receives pre-resized cover art 
            and metadata, keeping the connection fast even on 10-year-old hardware.
          </p>
        </div>
        <div class="feature-item">
          <h3>Built for low-end devices</h3>
          <p>
            Runs smoothly on older Android phones, tablets, and e-readers. 
            Built-in hardware refresh modes prevent ghosting on E-ink screens, 
            making it a perfect high-contrast display for dance booths.
          </p>
        </div>
        <div class="feature-item">
          <h3>Automatic Song Tracking</h3>
          <p>
            The DJ starts the broadcast once. The display then tracks every 
            song change from Mixxx automatically throughout the night.
          </p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="display-section">
      <h2>How it works</h2>
      <p class="lead mb-5">
        A lightweight architecture designed to bridge the DJ booth and the dance floor without internet dependencies.
      </p>

      <div class="pipeline-flow">
        <div class="pipeline-step">
          <span class="pipeline-step-num">STEP 01</span>
          <h3>Broadcast</h3>
          <p>
            <a href="/projects/mixxx-dj-buddy/">Mixxx DJ Buddy</a> running on the DJ laptop monitors live track changes and extracts album artwork metadata.
          </p>
        </div>
        <div class="pipeline-step">
          <span class="pipeline-step-num">STEP 02</span>
          <h3>Stream</h3>
          <p>
            The laptop transcodes and resizes the image bytes. It then pushes metadata and artwork packets over a secure Bluetooth SPP link.
          </p>
        </div>
        <div class="pipeline-step">
          <span class="pipeline-step-num">STEP 03</span>
          <h3>Render</h3>
          <p>
            The Android companion client receives the lightweight packet, paints the screen, and triggers custom E-ink refresh cycles.
          </p>
        </div>
      </div>

      <div class="row mt-5">
        <div class="col-lg-6">
          <h3 class="mb-4">Getting Started</h3>
          <ul class="setup-steps">
            <li class="setup-step-item">
              <div class="setup-step-num">01</div>
              <div class="setup-step-content">
                <h4>Deploy the APK</h4>
                <p>Install the client app on any Android device (minimum Android 4.2.2).</p>
              </div>
            </li>
            <li class="setup-step-item">
              <div class="setup-step-num">02</div>
              <div class="setup-step-content">
                <h4>Pair Devices</h4>
                <p>Establish a standard Bluetooth pairing between the Android display and the DJ laptop.</p>
              </div>
            </li>
            <li class="setup-step-item">
              <div class="setup-step-num">03</div>
              <div class="setup-step-content">
                <h4>Run DJ Buddy</h4>
                <p>Launch the <a href="/projects/mixxx-dj-buddy/">Mixxx DJ Buddy</a> server script on your laptop and toggle the Bluetooth broadcast.</p>
              </div>
            </li>
            <li class="setup-step-item">
              <div class="setup-step-num">04</div>
              <div class="setup-step-content">
                <h4>Place & Display</h4>
                <p>Launch the client app, select the paired laptop, and place the screen in the venue.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0 d-flex flex-column justify-content-between">
          <div>
            <h3 class="mb-4">Technical Stack</h3>
            <p>
              By moving high-overhead tasks like image resizing and format conversion to the host laptop, the Android client remains light enough to run smoothly on legacy hardware.
            </p>
          </div>
          <div class="mt-4">
            <span class="tech-badge">Android (Java)</span>
            <span class="tech-badge">Bluetooth SPP</span>
            <span class="tech-badge">Go (Server)</span>
            <span class="tech-badge">Mixxx API</span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="display-cta">
    <div class="display-cta-inner">
      <span class="cta-label">More DJ tools & sets</span>
      <h2>Explore the full picture</h2>
      <p class="lead">
        Mixxx Remote Display is part of a larger ecosystem of tools built for social dance events.
      </p>

      <div class="cta-grid">
        <div class="cta-card">
          <span class="cta-label">Host Broadcast Server</span>
          <h3>Mixxx DJ Buddy</h3>
          <p>
            The desktop engine powering this remote display. It tracks your live BPM flow, monitors crate categories, and provides the Bluetooth transmitter.
          </p>
          <a href="/projects/mixxx-dj-buddy/" class="cta-link">View host app →</a>
        </div>

        <div class="cta-card">
          <span class="cta-label">Post-set analysis</span>
          <h3>DJ Set Analysis Dashboard</h3>
          <p>
            An interactive Python/Dash web app showing the complete history of Alexis's DJ sets under the persona <strong>Dr. Beat</strong>. Analyze BPM curves, song transitions, and long-term track choices.
          </p>
          <a href="https://dj-dashboard.onrender.com/" target="_blank" rel="noopener noreferrer" class="cta-link">Open dashboard →</a>
        </div>

        <div class="cta-card">
          <span class="cta-label">The music behind the tools</span>
          <h3>Dr. Beat: Swing & Jazz Sets</h3>
          <p>
            Curious to hear the actual music that inspired these projects? Explore the playlists and live set archives that Dr. Beat curates for social dancers.
          </p>
          <a href="/playlists/" class="cta-link">Listen to sets →</a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
