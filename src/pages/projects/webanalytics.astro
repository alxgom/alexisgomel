---
import MainLayout from "../../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/projects/webanalytics/";
---

<MainLayout
  title="GA4, BigQuery & Data Studio Dashboard | Alexis Gomel"
  description="A live demonstration of a custom web analytics stack using GA4, BigQuery, and Data Studio. View near real-time traffic and user journey data."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <!-- SEO: Indexing Enabled -->
  <!-- SEO: Indexing Enabled -->
  <meta
    slot="head"
    name="keywords"
    content="Web Analytics Dashboard, GA4 BigQuery Project, Data Studio Portfolio, Custom Analytics Stack, Real-time Data Visualization, Core Web Vitals, PageSpeed Insights, Lighthouse Automation"
  />
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />

  <div class="container mt-5 pt-5 mb-5">
    <!-- Hero Section -->
    <section class="text-center mb-5">
      <h1 class="section-title display-4 mb-3">
        Web Analytics & Performance Dashboard: GA4, BigQuery & Data Studio
      </h1>
      <p class="lead text-muted mx-auto" style="max-width: 700px;">
        A comprehensive, near real-time analytics overview for <strong
          >alexisgomel.com</strong
        >. Powered by modern data engineering tools to monitor traffic, user
        behavior, and Core Web Vitals performance.
      </p>
    </section>

    <!-- Dashboard Embed -->
    <section class="mb-5">
      <div
        class="embed-responsive embed-responsive-16by9 shadow-lg rounded looker-embed-container"
        style="min-height: 800px; position: relative; height: 100%; width: 100%; overflow: hidden;"
      >
        <div id="looker-loader" class="looker-loader">
          <div class="spinner"></div>
        </div>
        <iframe
          id="looker-iframe"
          src="https://lookerstudio.google.com/embed/reporting/f947f8a3-9830-42b1-abab-3d8c39af1865/page/p_co6axt5m0d"
          frameborder="0"
          style="border:0; position: absolute; top:0; left:0; width:100%; height:100%; min-height: 800px;"
          allowfullscreen
          sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
          loading="lazy"
          title="Alexis Gomel Website Analytics Dashboard"
        >
        </iframe>
      </div>
      <p class="text-center text-muted mt-3 mb-4">
        Navigate between pages to explore the General Overview, Traffic
        Breakdown, Core Web Vitals Performance, and SEO Insights.
      </p>
    </section>

    <!-- Project Details & Features -->
    <section class="row mb-5 align-items-center">
      <div class="col-md-6 mb-4 mb-md-0">
        <h2 class="h3 mb-3">Project Overview</h2>
        <p>
          This dashboard serves as a public preview of my personal analytics
          suite. It leverages raw event data to visualize user journey and
          engagement with granularity not available in standard reports.
        </p>
        <ul class="list-unstyled mt-3">
          <li class="mb-2">
            <i class="ti-stats-up text-primary mr-2"></i><strong
              >Near Real-Time Data:</strong
            > Updates every 4 hours via BigQuery.
          </li>
          <li class="mb-2">
            <i class="ti-timer text-primary mr-2"></i><strong
              >Performance Monitoring:</strong
            > automated daily tests via Cloud Functions & PageSpeed API.
          </li>
          <li class="mb-2">
            <i class="ti-search text-primary mr-2"></i><strong
              >SEO & Search Console:</strong
            > Integration with Google Search Console for organic search performance.
          </li>
          <li class="mb-2">
            <i class="ti-layers-alt text-primary mr-2"></i><strong
              >Custom Tracking:</strong
            > Events captured via Google Tag Manager with custom data layers.
          </li>
          <li class="mb-2">
            <i class="ti-layout-grid2 text-primary mr-2"></i><strong
              >Advanced Visuals:</strong
            > Features <a href="/projects/looker-studio-custom-visuals/"
              >Custom Visuals like Tree Hierarchy and Custom KPI</a
            > for enhanced reporting.
          </li>
        </ul>
      </div>
      <div class="col-md-6">
        <div class="p-4 bg-light rounded shadow-sm">
          <h3 class="h5 mb-3">Tech Stack</h3>
          <div class="d-flex flex-wrap">
            <span class="badge badge-light border text-dark m-1 p-2"
              >Google Analytics 4</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >BigQuery</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >Data Studio</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >Google Tag Manager</span
            >
            <span class="badge badge-light border text-dark m-1 p-2">SQL</span>
            <span class="badge badge-light border text-dark m-1 p-2"
              >D3.js & DSCC</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >PageSpeed API</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >Google Search Console</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >Cloud Functions</span
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<script is:inline>
  const iframe = document.getElementById("looker-iframe");
  const loader = document.getElementById("looker-loader");

  if (iframe && loader) {
    iframe.onload = function () {
      // Small delay to ensure render start
      setTimeout(() => {
        loader.classList.add("hidden");
      }, 1000);
    };
  }
</script>
