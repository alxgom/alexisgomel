---
import MainLayout from "../../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/projects/webanalytics/";
---

<MainLayout
  title="GA4, BigQuery & Looker Studio Dashboard | Alexis Gomel"
  description="A live demonstration of a custom web analytics stack using GA4, BigQuery, and Looker Studio. View near real-time traffic and user journey data."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <!-- SEO: Indexing Enabled -->
  <!-- SEO: Indexing Enabled -->
  <meta
    slot="head"
    name="keywords"
    content="Web Analytics Dashboard, GA4 BigQuery Project, Looker Studio Portfolio, Custom Analytics Stack, Real-time Data Visualization"
  />
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />

  <div class="container mt-5 pt-5 mb-5">
    <!-- Hero Section -->
    <section class="text-center mb-5">
      <h1 class="section-title display-4 mb-3">
        Web Analytics Dashboard: GA4, BigQuery & Looker Studio
      </h1>
      <p class="lead text-muted mx-auto" style="max-width: 700px;">
        A comprehensive, near real-time analytics overview for <strong
          >alexisgomel.com</strong
        >. Powered by modern data engineering tools to provide deep insights
        into traffic and user behavior.
      </p>
    </section>

    <!-- Dashboard Embed -->
    <section class="mb-5">
      <div
        class="embed-responsive embed-responsive-16by9 shadow-lg rounded"
        style="min-height: 800px; position: relative; height: 100%; width: 100%; overflow: hidden;"
      >
        <iframe
          src="https://lookerstudio.google.com/embed/reporting/c498c4a2-7433-4687-8f3e-49b59d848e6d/page/p_5phix7rdzd"
          frameborder="0"
          style="border:0; position: absolute; top:0; left:0; width:100%; height:100%; min-height: 800px;"
          allowfullscreen
          sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
          title="Alexis Gomel Website Analytics Dashboard"
        >
        </iframe>
      </div>
      <p class="text-center text-muted mt-3 mb-4">
        Navigate between pages to see the General Overview (Page 1) and the
        Traffic Breakdown (Page 2).
      </p>
    </section>

    <!-- Project Details & Features -->
    <section class="row mb-5 align-items-center">
      <div class="col-md-6 mb-4 mb-md-0">
        <h2 class="h3 mb-3">Project Overview</h2>
        <p>
          This dashboard serves as a public preview of my personal analytics
          suite. It leverages raw event data to visualize user journey and
          engagement with granularity not available in standard reports.
        </p>
        <ul class="list-unstyled mt-3">
          <li class="mb-2">
            <i class="ti-stats-up text-primary mr-2"></i><strong
              >Near Real-Time Data:</strong
            > Updates every 4 hours via BigQuery.
          </li>
          <li class="mb-2">
            <i class="ti-layers-alt text-primary mr-2"></i><strong
              >Custom Tracking:</strong
            > Events captured via Google Tag Manager with custom data layers.
          </li>
          <li class="mb-2">
            <i class="ti-layout-grid2 text-primary mr-2"></i><strong
              >Advanced Visuals:</strong
            > Features a custom Tree Hierarchy visualization for categorical breakdowns.
          </li>
        </ul>
      </div>
      <div class="col-md-6">
        <div class="p-4 bg-light rounded shadow-sm">
          <h3 class="h5 mb-3">Tech Stack</h3>
          <div class="d-flex flex-wrap">
            <span class="badge badge-light border text-dark m-1 p-2"
              >Google Analytics 4</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >BigQuery</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >Looker Studio</span
            >
            <span class="badge badge-light border text-dark m-1 p-2"
              >Google Tag Manager</span
            >
            <span class="badge badge-light border text-dark m-1 p-2">SQL</span>
            <span class="badge badge-light border text-dark m-1 p-2"
              >Custom Viz Dev</span
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
