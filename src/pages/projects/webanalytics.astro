---
import MainLayout from "../../layouts/MainLayout.astro";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/projects/webanalytics";
---

<MainLayout
  title="Web Analytics | Alexis Gomel"
  description="Project Dashboard for Website Analytics"
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <!-- SEO: Prevent Indexing -->
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="container mt-5 pt-5 mb-5">
    <div class="text-center mb-5">
      <h1 class="section-title">Website Analytics Project</h1>
      <p class="text-muted">Live dashboard of this portfolio's traffic data.</p>
    </div>

    <div
      class="embed-responsive embed-responsive-16by9"
      style="min-height: 800px; position: relative; height: 100%; width: 100%;"
    >
      <iframe
        src="https://lookerstudio.google.com/embed/reporting/b4926b71-785d-4e49-9a9e-adcc2a3de08f/page/p_5phix7rdzd"
        frameborder="0"
        style="border:0; position: absolute; top:0; left:0; width:100%; height:100%; min-height: 800px;"
        allowfullscreen
        sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
      >
      </iframe>
    </div>
  </div>
</MainLayout>
