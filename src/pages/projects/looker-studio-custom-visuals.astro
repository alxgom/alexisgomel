---
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import performanceImg from "../../assets/imgs/Projects/performance.png";
import bestPracticesImg from "../../assets/imgs/Projects/best_practices_screenshot.png";
import reviewsImg from "../../assets/imgs/Projects/reviews_screenshot.png";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHrefs = {
  es: "/es/projects/looker-studio-custom-visuals/",
  fr: "/fr/projects/looker-studio-custom-visuals/",
};
---

<MainLayout
  title="Data Studio (formerly Looker Studio) Community Visualizations"
  description="Enhance your data storytelling with interactive custom community visualizations for Google Data Studio (formerly Looker Studio), including Tree Hierarchy, Histogram, and Lipstick charts."
  currentLang={currentLang}
  alternateHrefs={alternateHrefs}
  image="/assets/imgs/Projects/community_visuals_banner.svg"
>
  <meta
    slot="head"
    name="description"
    content="Explore advanced interactive custom visualizations for Google Looker Studio. Built with JavaScript and DSCC, these community visualizations include Tree Hierarchy, Histogram, and Lipstick charts for deep data insights."
  />
  <meta
    slot="head"
    name="keywords"
    content="Custom Looker Studio Visualizations, Community Visualizations, Looker Studio Tree Hierarchy, Lipstick Chart, Histogram Visualization, DSCC API, JavaScript Data Viz, Google Looker Studio Extensions"
  />
  <meta
    slot="head"
    property="og:title"
    content="Custom Data Studio (formerly Looker Studio) Community Visualizations | Alexis Gomel"
  />
  <meta
    slot="head"
    property="og:description"
    content="Interactive custom community visualizations for Looker Studio. Features advanced Tree Hierarchy, Histogram, and Lipstick charts."
  />
  <meta
    slot="head"
    property="og:image"
    content="/assets/imgs/Projects/tree_hierarchy_viz.png"
  />
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />

  <!-- FAQ Schema for LLM Context -->
  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://alexisgomel.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Projects",
          "item": "https://alexisgomel.com/projects/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Looker Studio Community Visualizations",
          "item": "https://alexisgomel.com/projects/looker-studio-custom-visuals/"
        }
      ]
    }
  </script>
  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are some examples of custom Data Studio (Looker Studio) community visualizations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Examples of custom Data Studio (formerly Looker Studio) visualizations include Tree Hierarchies for multi-level data drill-downs, Lipstick Charts for tracking performance against targets, Cleveland Plots for tracking distributions without clutter, and Sparkline tables. These extend the native capabilities of Data Studio (Looker Studio)."
          }
        },
        {
          "@type": "Question",
          "name": "How are Data Studio (Looker Studio) community visualizations built?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Data Studio (formerly Looker Studio) custom community visualizations are built using JavaScript, CSS, and libraries like D3.js. They connect to data using the Data Studio Community Component API (DSCC API) provided by Google, allowing developers to render completely custom, interactive HTML inside their reports. While the source code is not provided publicly on the page, you can interact with the live embedded dashboard to see how they work just like native visuals, and reach out if you want to know more."
          }
        }
      ]
    }
  </script>

  <style>
    .looker-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .section-title {
      text-align: center;
      margin-bottom: 1rem;
    }

    .lead {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 2rem auto;
    }

    .report-frame {
      width: 100%;
      max-width: 1000px;
      margin: 2rem auto;
      display: block;
      border: none;
      border-radius: 8px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .viz-list {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid #eee;
    }

    .viz-list h3 {
      margin-bottom: 1rem;
    }

    .viz-list ul {
      list-style: disc;
      padding-left: 1.5rem;
    }

    .viz-list li {
      margin-bottom: 0.5rem;
    }

    .viz-list ul.included-list li {
      display: flex;
      align-items: center;
    }

    .viz-icon {
      width: 24px;
      height: 24px;
      margin-right: 10px;
    }
  </style>

  <div class="looker-container">
    <div class="container mt-5 pt-5">
      <h1 class="section-title">Data Studio (formerly Looker Studio) Community Visualizations</h1>
      <p class="lead text-muted">
        Custom community visualizations I've developed for Google Data Studio (formerly Looker Studio),
        extending its capabilities with specialized chart types for better data
        storytelling.
      </p>

      <div class="looker-embed-container">
        <div id="looker-loader" class="looker-loader">
          <div class="spinner"></div>
        </div>
        <iframe
          id="looker-iframe"
          class="report-frame"
          width="100%"
          height="800"
          src="https://lookerstudio.google.com/embed/reporting/7f1ad7dc-2ae4-4e72-be31-b588c9890fa9/page/p_8m1usmbk0d"
          frameborder="0"
          style="border:0"
          allowfullscreen
          loading="lazy"
          sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        ></iframe>
        <script>
          document.addEventListener("DOMContentLoaded", function () {
            const iframe = document.getElementById("looker-iframe");
            const loader = document.getElementById("looker-loader");

            if (iframe && loader) {
              iframe.addEventListener("load", function () {
                loader.style.display = "none";
                iframe.style.visibility = "visible";
              });

              // Fallback for cases where 'load' event might not fire reliably
              setTimeout(() => {
                if (iframe.style.visibility !== "visible") {
                  loader.style.display = "none";
                  iframe.style.visibility = "visible";
                }
              }, 5000); // Hide loader after 5 seconds if iframe hasn't loaded
            }
          });
        </script>
      </div>

      <div class="viz-list">
        <h3>Visualizations Included</h3>
        <div class="row align-items-center mt-4">
          <div class="col-md-12">
            <ul class="included-list">
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/lipstick%20icon.svg"
                  class="viz-icon"
                  alt="Lipstick Chart Icon"
                />
                <div>
                  <strong>Lipstick Chart</strong> - A specialized chart type for comparing
                  real values against targets with a distinctive, high-density visual
                  style.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/tree%20icon.svg"
                  class="viz-icon"
                  alt="Tree Hierarchy Icon"
                />
                <div>
                  <strong>Tree Hierarchy</strong> - A hierarchical visualization for
                  displaying multi-level data structures with intuitive drill-down
                  capabilities.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/Histogram.svg"
                  class="viz-icon"
                  alt="Histogram Icon"
                />
                <div>
                  <strong>Histogram</strong> - A customizable histogram with options
                  for orientation, log scale, and axis visibility for distribution
                  analysis.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/sparkline_table_icon.svg"
                  class="viz-icon"
                  alt="Sparkline Table Icon"
                />
                <div>
                  <strong>Sparkline Table</strong> - A data-dense table with embedded
                  sparklines for tracking trends at a glance.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/cleveland%20icon.svg"
                  class="viz-icon"
                  alt="Cleveland Plot Icon"
                />
                <div>
                  <strong>Cleveland Plot</strong> - A clean alternative to bar charts
                  for comparing values or showing distributions.
                </div>
              </li>
              <li>
                <img
                  src="https://raw.githubusercontent.com/alxgom/Icons/main/Viz%20icons/minimal_pause_kpi.svg"
                  class="viz-icon"
                  alt="Custom KPI Icon"
                />
                <div>
                  <strong>Custom KPI</strong> - A minimalist KPI card design with
                  'minimal pause' aesthetics for clear metric impact.
                </div>
              </li>
              <li>
                <img
                  src="/assets/imgs/Projects/matrix_heatmap_icon.svg"
                  class="viz-icon"
                  alt="Matrix Heatmap Icon"
                />
                <div>
                  <strong>Matrix Heatmap</strong> - A data-dense visualization for exploring correlations, distributions, and intensity across two dimensions with customizable color scaling.
                </div>
              </li>
              <li>
                <img
                  src="/assets/imgs/Projects/radar_icon.svg"
                  class="viz-icon"
                  alt="Radar Chart Icon"
                />
                <div>
                  <strong>Radar Chart</strong> - Plots multi-dimensional metrics on polygonal or circular webs using tidy or wide data models.
                </div>
              </li>
              <li>
                <img
                  src="/assets/imgs/Projects/text_card_icon.svg"
                  class="viz-icon"
                  alt="Text Card Icon"
                />
                <div>
                  <strong>Text Card Grid</strong> - Presents descriptive text blocks alongside quantitative metrics in responsive column grids or chronological timelines.
                </div>
              </li>
              <li>
                <img
                  src="/assets/imgs/Projects/deviation_viz_icon.svg"
                  class="viz-icon"
                  alt="Bar & Lollipop Deviation Icon"
                />
                <div>
                  <strong>Bar & Lollipop Deviation</strong> - A vertically concatenated dual chart showing deviation to plan (lollipops) and actual vs plan comparisons (bars and ticks) with customizable grids and dynamic color matching.
                </div>
              </li>
              <li>
                <img
                  src="/assets/imgs/Projects/icicle_icon.svg"
                  class="viz-icon"
                  alt="Icicle Chart Icon"
                />
                <div>
                  <strong>Icicle Chart</strong> - An interactive, multi-level hierarchy visualization supporting vertical/horizontal orientations, custom breadcrumbs, high-fidelity tooltips, and click-to-zoom.
                </div>
              </li>
            </ul>
            <p class="text-muted mt-3">
              Below you can see detailed demonstrations and technical
              explanations for the primary visualizations.
            </p>
          </div>
        </div>
      </div>

      <div class="viz-list">
        <h3>Lipstick Chart: Value vs. Target Analysis</h3>
        <div class="row align-items-center mt-4">
          <div class="col-md-6 order-md-2 mb-4 mb-md-0">
            <div class="video-container">
              <video
                autoplay
                muted
                loop
                playsinline
                class="img-fluid rounded shadow"
                aria-label="Lipstick Visualization Demo"
              >
                <source
                  src="/assets/imgs/Projects/lookerstudio_lipstick_viz.webm"
                  type="video/webm"
                />
                <source
                  src="/assets/imgs/Projects/lookerstudio_lipstick_viz_optimized.mp4"
                  type="video/mp4"
                />
                Your browser does not support the video tag.
              </video>
            </div>
          </div>
          <div class="col-md-6 order-md-1">
            <p>
              The <strong>Lipstick Visual</strong> is a powerful tool designed to
              compare current performance against specific targets. It excels at breaking
              down metrics across various dimensions, for example, comparing <em
                >Actual Revenue</em
              > from different regions against their <em>Expected Targets</em>.
            </p>
            <p>
              By combining multiple data points into a single graphical element,
              it provides a comprehensive view at a glance:
            </p>
            <ul>
              <li><strong>Completion Percentage:</strong> Visual progress towards the goal.</li>
              <li><strong>Real Metric Value:</strong> The absolute current figure.</li>
              <li><strong>Target Value:</strong> The benchmark or budget.</li>
              <li><strong>Absolute Variation:</strong> The calculated gap between both values.</li>
              <li><strong>Optional Dimensions:</strong> Dynamic breakdown across secondary details or category grouping levels.</li>
              <li><strong>Secondary Targets:</strong> Concentric dashed end-caps and straight lines representing stretch goals.</li>
              <li><strong>Togglable Views:</strong> An interactive axis scale toggle to swap between percentages and absolute metrics on the fly.</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="viz-list">
        <h3>Tree Hierarchy in Action</h3>
        <div class="row align-items-center mt-4">
          <div class="col-md-6 mb-4 mb-md-0">
            <div class="video-container">
              <video
                autoplay
                muted
                loop
                playsinline
                class="img-fluid rounded shadow"
                aria-label="Tree Hierarchy Visualization Demo"
                poster="/assets/imgs/Projects/tree_hierarchy_viz.png"
              >
                <source
                  src="/assets/imgs/Projects/lookerstudio_tree_hierarchy_viz.webm"
                  type="video/webm"
                />
                <source
                  src="/assets/imgs/Projects/lookerstudio_tree_hierarchy_viz_optimized.mp4"
                  type="video/mp4"
                />
                Your browser does not support the video tag.
              </video>
            </div>
          </div>
          <div class="col-md-6">
            <p>
              The <strong>Tree Hierarchy</strong> visualization allows users to navigate
              through multi-level data structures intuitively. By clicking on nodes,
              users can drill down into specific categories, while smooth transitions
              maintain context and energy flow.
            </p>
            <p class="text-muted small">
              This video showcases the drill-down capabilities, responsive
              layout, and interactive node selection features of the tree
              structure.
            </p>
          </div>
        </div>
      </div>

      <div class="viz-list">
        <h3>Qualitative Narrative Card Grid</h3>
        <div class="row align-items-center mt-4">
          <div class="col-md-6 mb-4 mb-md-0">
            <div class="shadow rounded overflow-hidden d-inline-block" style="background: white;">
              <Image
                src={reviewsImg}
                alt="Text Card Grid displaying reviews"
                class="img-fluid"
              />
            </div>
          </div>
          <div class="col-md-6">
            <p>
              The <strong>Text Card Grid</strong> presents descriptive narrative text fields side-by-side with quantitative indicators. It adapts layout behaviors depending on the user's focus:
            </p>
            <ul>
              <li><strong>Layout Switcher:</strong> Swap dynamically between a responsive card grid, a vertical timeline feed, and a split-screen reader.</li>
              <li><strong>Design Flexibility:</strong> Automatically restructures the card layout to organize titles, subtitles, category tags, and descriptive text fields.</li>
              <li><strong>Metric KPI Labels:</strong> Integrates quantitative data fields alongside narrative text blocks using your custom field formatting.</li>
              <li><strong>Natural Spacing:</strong> Preserves paragraph breaks, spacing, lists, and double carriage-returns to retain original document readability.</li>
            </ul>
            <p class="text-muted small mt-3">
              <strong>Primary Use Cases:</strong> Real-world applications include interactive customer review lists with NPS filtering, centralized developer component portfolios, and chronological version changelogs.
            </p>
          </div>
        </div>
      </div>

      <div class="viz-list">
        <h3>Why Use Custom Community Visualizations?</h3>
        <p>
          While Google Looker Studio offers a robust set of default charts, some
          complex data structures require specialized visual approaches.
          <strong>Custom community visualizations</strong> fill this gap by allowing
          developers to build unique, interactive charts using
          <a href="https://d3js.org/" target="_blank" rel="noopener noreferrer"
            >D3.js</a
          >
          and the
          <a
            href="https://developers.google.com/looker-studio/visualization"
            target="_blank"
            rel="noopener noreferrer">DSCC API</a
          >.
        </p>
        <p>Key benefits include:</p>
        <ul>
          <li>
            <strong>Branded Reporting:</strong> Tailor the look and feel of your data
            to match your brand identity.
          </li>
          <li>
            <strong>Advanced Interaction:</strong> Implement complex drill-down behaviors
            and cross-filtering.
          </li>
          <li>
            <strong>Specialized Charts:</strong> Use non-standard charts like Tree
            Hierarchies or Lipstick charts for more effective communication.
          </li>
        </ul>
      </div>

      <div class="viz-list">
        <h3>Frequently Asked Questions</h3>
        <div class="faq-item mt-4">
          <h5>1. What is a Data Studio (Looker Studio) Community Visualization?</h5>
          <p>
            It's a third-party chart developed using the Google Data Studio (formerly Looker Studio)
            Community Visualization API. It allows for custom rendering and
            interaction that goes beyond standard built-in components.
          </p>
        </div>
        <div class="faq-item mt-3">
          <h5>2. How do I install these custom visualizations?</h5>
          <p>
            You can add them to your report by using the "Community
            Visualizations and Components" icon in the Data Studio toolbar and
            pasting the manifest path provided (available upon request).
          </p>
        </div>
        <div class="faq-item mt-3">
          <h5>3. Are these visualizations responsive?</h5>
          <p>
            Yes, all visualizations shown here are built to be fully responsive
            and adapt to the size of the container within your Data Studio (Looker Studio)
            report.
          </p>
        </div>
      </div>

      <div class="viz-list">
        <h3>Technical Details</h3>
        <p>
          These visualizations are built using the
          <a
            href="https://developers.google.com/looker-studio/visualization"
            target="_blank"
            rel="noopener noreferrer"
          >
            Data Studio (Looker Studio) Community Visualization API (DSCC)
          </a>
          with JavaScript and D3.js for rendering. They are designed to be highly
          configurable through the Data Studio style panel.
        </p>
        <p>
          <strong>Tech & skills:</strong> JavaScript, D3.js, DSCC API, Data Visualization,
          CSS.
        </p>
      </div>
    </div>
  </div>
</MainLayout>

<div
  style="background: linear-gradient(to bottom, #ffffff 0%, #f0eee9 300px, #f0eee9 100%); width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; padding: 4rem 0;"
>
  <div class="looker-container">
    <div class="container">
      <h3>Real-World Application: Performance Monitoring</h3>
      <p
        class="lead"
        style="text-align: left; margin: 0 0 1rem 0; color: #212529;"
      >
        I use these components to visualize data in ways that are impossible
        with native charts. The <strong>Cleveland Plot</strong>, for instance,
        allows me to track performance distributions in a single view, whereas
        standard tools would require multiple separate charts to convey the same
        information.
      </p>

      <p>
        It visualizes daily <strong>PageSpeed Insights</strong> scores, allowing for
        quick identification of performance trends and distribution of Core Web Vitals
        metrics.
      </p>

      <div class="row mt-4">
        <div class="col-md-6 mb-4">
          <figure class="text-center">
            <div
              class="shadow rounded overflow-hidden d-inline-block"
              style="background: white;"
            >
              <Image
                src={performanceImg}
                alt="Cleveland Plot showing Performance Scores distribution"
                class="img-fluid"
              />
            </div>
            <figcaption class="text-muted small mt-2">
              Performance scores distribution visualized with Cleveland Plot
            </figcaption>
          </figure>
        </div>
        <div class="col-md-6 mb-4">
          <figure class="text-center">
            <div
              class="shadow rounded overflow-hidden d-inline-block"
              style="background: white;"
            >
              <Image
                src={bestPracticesImg}
                alt="Cleveland Plot showing Best Practices Scores over time"
                class="img-fluid"
              />
            </div>
            <figcaption class="text-muted small mt-2">
              Best Practices metrics tracking
            </figcaption>
          </figure>
        </div>
      </div>

      <div class="text-center mt-4 mb-5">
        <a
          href="/projects/webanalytics/"
          class="btn btn-primary btn-lg shadow-sm"
        >
          View Web Analytics Dashboard <i class="fas fa-arrow-right ml-2"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<div style="background: #f8f9fa; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; padding: 4rem 0; border-top: 1px solid #eee;">
  <div class="looker-container">
    <div class="container text-center">
      <h3 class="mb-3">Looking for Power BI Solutions?</h3>
      <p class="lead mb-4" style="max-width: 700px; margin: 0 auto; color: #212529;">
        I also develop advanced, custom visual components for the Microsoft Power BI ecosystem. 
        Explore my specialized charts designed to elevate your Power BI reporting.
      </p>
      <a href="/projects/powerbi-custom-visuals/" class="btn btn-outline-primary btn-lg shadow-sm">
        Explore Power BI Visuals <i class="fas fa-chart-bar ml-2"></i>
      </a>
    </div>
  </div>
</div>
