---
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import mainScreenshot from "../../assets/imgs/Projects/mixxx_dj_buddy_main.png";
import settingsScreenshot from "../../assets/imgs/Projects/mixxx_dj_buddy_settings.png";
import einkCloseup from "../../assets/imgs/Projects/eink_mixxx_display_closeup.jpg";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/es/projects/mixxx-dj-buddy/";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Mixxx DJ Buddy",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows",
  description:
    "A live companion app for Mixxx that tracks BPM trends and track history, helping DJs stay in the zone during social dance events.",
  url: "https://alexisgomel.com/projects/mixxx-dj-buddy/",
  downloadUrl: "https://github.com/alxgom/Mixxx-dj-buddy/releases",
  author: {
    "@type": "Person",
    name: "Alexis Gomel",
    url: "https://alexisgomel.com",
  },
  keywords:
    "Mixxx companion, DJ set visualizer, BPM chart, swing blues DJ, live DJ tool, Go app, open source DJ software",
});
---

<MainLayout
  title="Visualize your DJ set flow in real time with Mixxx DJ Buddy | Alexis Gomel"
  description="Mixxx DJ Buddy is a real-time companion app for Mixxx. Track your BPM flow, organize crates, and maintain your set energy without distraction."
  currentLang={currentLang}
  alternateHref={alternateHref}
  image="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
>
  <meta
    slot="head"
    name="keywords"
    content="Mixxx companion app, DJ set visualizer, BPM chart live, swing blues DJ tool, open source DJ software, Go desktop app, social dance DJ, Lindy Hop DJ, Balboa DJ, Salsa DJ, Tango DJ, Bachata DJ, Forro DJ"
  />
  <meta
    slot="head"
    property="og:title"
    content="Visualize your DJ set flow in real time with Mixxx DJ Buddy | Alexis Gomel"
  />
  <meta
    slot="head"
    property="og:description"
    content="Real-time BPM chart and track metadata companion for Mixxx DJs. Built in Go with D3.js."
  />
  <meta
    slot="head"
    property="og:image"
    content="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
  />
  <link
    rel="preload"
    as="image"
    href={mainScreenshot.src}
    slot="head"
    fetchpriority="high"
  />
  <link
    rel="preload"
    as="image"
    href="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
    slot="head"
  />
  <script type="application/ld+json" set:html={schema} slot="head" />
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://alexisgomel.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Projects",
          "item": "https://alexisgomel.com/projects/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Mixxx DJ Buddy",
          "item": "https://alexisgomel.com/projects/mixxx-dj-buddy/"
        }
      ]
    }
  </script>

  <style>
    /* ── Layout ────────────────────────────────────── */
    .buddy-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.25rem;
    }

    /* ── Hero ──────────────────────────────────────── */
    .buddy-hero {
      padding: 8rem 1rem 6rem;
      background: var(--cloud-dance-white);
      position: relative;
      overflow: hidden;
    }
    .buddy-hero::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: radial-gradient(var(--light-gray) 1px, transparent 1px);
      background-size: 30px 30px;
      opacity: 0.2;
      pointer-events: none;
    }
    .buddy-hero .eyebrow {
      font-family: var(--font-family-monospace);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: 1rem;
      display: block;
    }
    .buddy-hero h1 {
      font-size: clamp(2.2rem, 6vw, 3.8rem);
      font-weight: 900;
      line-height: 1.05;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
    }
    .buddy-hero .lead {
      max-width: 620px;
      margin: 0 0 2.5rem;
      font-size: 1.2rem;
      color: var(--dark-gray);
      line-height: 1.6;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem 1rem;
      margin-bottom: 2.5rem;
    }

    /* ── Section dividers ──────────────────────────── */
    .buddy-section {
      padding: 5rem 0;
      border-top: 1px solid var(--light-gray);
    }
    .buddy-section p a {
      color: var(--primary);
      text-decoration: underline;
      font-weight: 600;
    }
    .buddy-section p a:hover {
      color: var(--dark);
    }
    .buddy-section h2 {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      letter-spacing: -0.01em;
    }
    .buddy-section h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    /* ── Story quote ───────────────────────────────── */
    .story-quote {
      border-left: 2px solid var(--primary);
      padding: 1.5rem 2rem;
      margin: 2rem 0;
      font-style: italic;
      color: var(--dark-gray);
      background: var(--cloud-dance-white);
      font-size: 1.1rem;
    }

    /* ── Features grid ─────────────────────────────── */
    .features-row {
      display: grid;
      gap: 2.5rem;
      margin-top: 2.5rem;
    }
    .features-row-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .features-row-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .feature-item {
      padding: 2rem 0;
      border-top: 1px solid var(--light-gray);
      transition: border-color 0.3s;
    }
    .feature-item:hover {
      border-top-color: var(--primary);
    }
    .feature-item h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .feature-item p {
      color: #666;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .feature-item-img {
      margin-top: 1.5rem;
      overflow: hidden;
      border: 1px solid var(--light-gray);
      background: #000;
    }
    .feature-item-img img {
      display: block;
      width: 100%;
      opacity: 0.9;
    }

    /* ── Video ─────────────────────────────────────── */
    .demo-video {
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
      border: 1px solid var(--dark);
      box-shadow: 20px 20px 0px var(--albero-pantone);
      display: block;
      transition: all 0.3s ease;
    }
    .demo-video:hover {
      transform: translate(-4px, -4px);
      box-shadow: 24px 24px 0px var(--albero-pantone);
    }

    /* ── Screenshots ───────────────────────────────── */
    .screenshot-frame {
      overflow: hidden;
      box-shadow: 20px 20px 0px var(--albero-pantone);
      border: 1px solid var(--dark);
      background: #000;
      transition: all 0.3s ease;
    }
    .screenshot-frame:hover {
      transform: translate(-4px, -4px);
      box-shadow: 24px 24px 0px var(--albero-pantone);
    }
    .screenshot-frame img {
      display: block;
      width: 100%;
      filter: grayscale(0.2) contrast(1.1);
      transition: all 0.4s ease;
    }
    .screenshot-frame:hover img {
      filter: grayscale(0) contrast(1.1);
      transform: scale(1.02);
    }
    .hero-frame {
      transform: perspective(1000px) rotateY(-8deg) rotateX(2deg) skewY(1deg);
    }
    .hero-frame:hover {
      transform: perspective(1000px) rotateY(-2deg) rotateX(1deg) translate(-4px, -4px) !important;
    }

    /* ── Tech badges ───────────────────────────────── */
    .tech-badge {
      display: inline-block;
      border: 1px solid var(--light-gray);
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
      font-family: var(--font-family-monospace);
      font-weight: 500;
      margin: 0.25rem 0.2rem;
      color: var(--dark-gray);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* ── CTA cards ─────────────────────────────────── */
    .display-cta {
      margin-top: 5rem;
      padding: 5rem 1.25rem;
      border-top: 1px solid var(--light-gray);
      background: var(--cloud-dance-white);
    }
    .display-cta-inner {
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
    }
    .display-cta h2 {
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
    }
    .display-cta .lead {
      max-width: 600px;
      margin: 0 auto 3rem;
      color: var(--dark-gray);
      font-size: 1.05rem;
    }
    .cta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      text-align: left;
    }
    .cta-label {
      font-family: var(--font-family-monospace);
      font-size: 0.75rem;
      color: var(--primary);
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 0.5rem;
      display: block;
    }


    /* ── Future plans list ─────────────────────────── */
    .future-list li {
      margin-bottom: 0.6rem;
      padding-left: 0.25rem;
    }

    /* ── Setup Steps - Anti-AI UI elements ────────── */
    .setup-steps {
      list-style: none;
      padding: 0;
      margin: 2rem 0;
    }
    .setup-step-item {
      display: flex;
      align-items: flex-start;
      margin-bottom: 2rem;
    }
    .setup-step-num {
      font-family: var(--font-family-monospace);
      font-weight: 900;
      color: var(--primary);
      font-size: 1.25rem;
      width: 45px;
      flex-shrink: 0;
      line-height: 1;
      padding-top: 2px;
    }
    .setup-step-content {
      border-left: 2px solid var(--light-gray);
      padding-left: 1.5rem;
    }
    .setup-step-content h3 {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    .setup-step-content p {
      font-size: 0.95rem;
      color: #666;
      margin: 0;
      line-height: 1.5;
    }

    /* ── Remote Display callout ─────────────────────── */
    .remote-display-callout {
      background: var(--dark);
      padding: 5rem 2rem;
      border-top: none;
    }
    .remote-display-callout h2 {
      color: #fff;
    }
    .remote-display-callout .eyebrow {
      color: var(--albero-pantone);
    }
    .remote-display-callout p {
      color: rgba(255,255,255,0.75);
    }
    .remote-display-callout p a {
      color: var(--albero-pantone) !important;
      text-decoration: underline;
    }


    @media (max-width: 767px) {
      .buddy-hero {
        padding: 6rem 1rem 4rem;
        text-align: left;
      }
      .display-cta {
        padding: 2rem 1rem;
      }
      .features-row-3,
      .features-row-2 {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <div class="buddy-hero">
    <div class="buddy-container">
      <div class="row align-items-center text-start">
        <div class="col-lg-6">
          <p class="eyebrow">Open-source DJ tool for Mixxx</p>
          <h1>Mixxx DJ Buddy visualizes your DJ set in real time.</h1>
          <p class="lead">
            Mixxx DJ Buddy is a live companion app for
            <a href="https://mixxx.org/" target="_blank" rel="noopener noreferrer"
              >Mixxx</a
            >. It tracks your BPM flow as you play. It also surfaces the crates behind every song and includes a broadcast server for remote displays.
          </p>
          <div class="hero-actions">
            <a
              href="https://github.com/alxgom/Mixxx-dj-buddy/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-link-button cta-seville-red gtm-track-click"
              data-event-category="Mixxx DJ Buddy"
              data-event-label="Hero - Download"
            >
              <span class="span">Download (.exe)</span>
            </a>
            <a
              href="https://github.com/alxgom/Mixxx-dj-buddy"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-link-chevron cta-seville-white gtm-track-click"
              data-event-category="Mixxx DJ Buddy"
              data-event-label="Hero - GitHub"
            >
              <span class="span">View on GitHub</span>
              <span class="second">
                <svg viewBox="0 0 50 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="width: 100%; height: 100%; overflow: visible;">
                  <path d="M3 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="one" fill="currentColor"></path>
                  <path d="M19 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="two" fill="currentColor"></path>
                  <path d="M35 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="three" fill="currentColor"></path>
                </svg>
              </span>
            </a>
          </div>
        </div>
        <div class="col-lg-6 mt-5 mt-lg-0">
          <div class="screenshot-frame hero-frame">
            <Image
              src={mainScreenshot}
              alt="Mixxx DJ Buddy main interface showing a BPM chart with the Jazzy Light theme"
              class="img-fluid"
              loading="eager"
              width={600}
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="buddy-container">
    <!-- ─── THE STORY ────────────────────────────────────────── -->
    <section class="buddy-section">
      <h2>From a notebook to a real-time visualizer</h2>
      <p>
        When I started DJing for swing &amp; blues dance parties as
        <strong>Dr. Beat</strong>, I kept a small notebook beside the decks
        to sketch the BPM arc of my set. It was a rough map of the energy I was
        trying to build, release, and rebuild throughout the night.
      </p>
      <div class="story-quote">
        "I look at the dance floor and react. I also like to build a
        narrative. Raise the energy, build tension, let it
        breathe."
      </div>
      <div class="mt-4 mb-4">
        <video
          autoplay
          muted
          loop
          playsinline
          class="demo-video"
          poster="/assets/imgs/Projects/mixxx_dj_buddy_poster.jpg"
          aria-label="Mixxx DJ Buddy screen recording demo"
        >
          <source src="/assets/imgs/Projects/mixxx_dj_buddy.webm" type="video/webm" />
          <source src="/assets/imgs/Projects/mixxx_dj_buddy_optimized.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <p class="text-muted small mt-3 text-center">
          The chart updates live as each track plays. Hover over any point to see
          the song's crates and playlists. Shared crates with the previous track
          are highlighted automatically.
        </p>
      </div>
      <p>
        Mixxx DJ Buddy turned that notebook into a live chart. It reads
        directly from the <a
          href="https://mixxx.org/"
          target="_blank"
          rel="noopener noreferrer">Mixxx</a
        >
        SQLite database and updates automatically as you play each track. There's no
        manual input and no interruptions to your flow.
      </p>
      <p>
        BPM alone doesn't capture everything, but it's a reliable starting
        point. The crates and playlists layer makes it genuinely
        useful for in-set decision making. Future versions will go deeper
        with perceptual audio metrics.
      </p>
    </section>

    <!-- ─── FEATURES ─────────────────────────────────────────── -->
    <section class="buddy-section">
      <h2>Key features</h2>

      <div class="features-row features-row-3">
        <div class="feature-item">
          <h3>Live BPM Chart</h3>
          <p>
            A D3.js-powered line chart updates in real time as each new track
            starts. See the arc of your set's energy at a glance: rises,
            breaks, and recoveries.
          </p>
        </div>

        <div class="feature-item">
          <h3>Crates &amp; Playlists Tooltip</h3>
          <p>
            Hover over or click any data point to see which
            <strong>crates</strong> (your personal song categories: big band, vocals,
            energy, endings…) and <strong>playlists</strong> a track belongs to. Shared
            crates with the previous song are highlighted, helping you spot thematic
            threads mid-set.
          </p>
        </div>

        <div class="feature-item">
          <h3>Always on Top</h3>
          <p>
            Toggle a "pin" mode so the window stays visible on top of Mixxx. This is
            ideal when you're DJing on a single laptop screen. Maximise the
            chart for more real estate when you need it.
          </p>
        </div>
      </div>

      <div class="features-row features-row-2">
        <div class="feature-item">
          <h3>Themes</h3>
          <p>
            Switch between a dark default theme and the vibrant
            <strong>Jazzy Light</strong> theme. This uses expressive colours inspired by jazz's
            spirit of personal style.
          </p>
          <div class="feature-item-img">
            <Image
              src={mainScreenshot}
              alt="Mixxx DJ Buddy main chart. Jazzy Light theme with BPM line chart and vinyl logo"
              class="img-fluid"
              width={500}
            />
          </div>
          <p class="text-muted small mt-2">Main interface. Jazzy Light theme</p>
        </div>

        <div class="feature-item">
          <h3>Persistent Settings</h3>
          <p>
            All your preferences (theme, always-on-top, axis display, tooltip
            mode) are saved and restored automatically between sessions.
          </p>
          <div class="feature-item-img">
            <Image
              src={settingsScreenshot}
              alt="Mixxx DJ Buddy settings panel showing axis options, always-on-top toggle, theme switch, and tooltip info mode selector"
              class="img-fluid"
              width={500}
            />
          </div>
          <p class="text-muted small mt-2">Settings panel. Dark theme</p>
        </div>
      </div>
    </section>

    <!-- ─── REMOTE DISPLAY CALLOUT ───────────────────────────── -->
    <section class="buddy-section remote-display-callout">
      <div class="row align-items-center">
        <div class="col-md-6">
          <span class="eyebrow">Optional wireless extension</span>
          <h2>Broadcast to Mixxx Remote Display</h2>
          <p>
            DJ Buddy can wirelessly broadcast track data and cover art to
            <a href="/projects/mixxx-remote-display/">Mixxx Remote Display</a>, an
            Android app that turns a spare phone into a venue screen.
            Built as a companion project, it's designed for social dance events
            where the crowd wants to know what's playing.
          </p>
          <a
            href="/projects/mixxx-remote-display/"
            class="cta-link-chevron cta-seville-albero gtm-track-click"
            data-event-category="Mixxx DJ Buddy"
            data-event-label="Remote Display Callout"
          >
            <span class="span">View Mixxx Remote Display</span>
            <span class="second">
              <svg viewBox="0 0 50 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="width: 100%; height: 100%; overflow: visible;">
                <path d="M3 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="one" fill="currentColor"></path>
                <path d="M19 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="two" fill="currentColor"></path>
                <path d="M35 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="three" fill="currentColor"></path>
              </svg>
            </span>
          </a>
        </div>
        <div class="col-md-6 mt-4 mt-md-0">
          <div class="screenshot-frame">
            <Image
              src={einkCloseup}
              alt="Mixxx Remote Display showing track info on an e-ink screen at a dance event"
              class="img-fluid"
              width={500}
            />
          </div>
        </div>
      </div>
    </section>


    <!-- ─── HOW IT WORKS ─────────────────────────────────────── -->
    <section class="buddy-section">
      <div class="row align-items-center">
        <div class="col-md-6">
          <h2>How it works</h2>
          <p>
            Mixxx stores its history in a local SQLite database (<code>mixxxdb.sqlite</code>). 
            DJ Buddy polls this database at regular intervals to detect newly played tracks. 
            No network connection required. No account needed.
          </p>
          <p>
            The chart is rendered with <strong>D3.js</strong>, while the Go backend
            handles database polling. If enabled, it also hosts a lightweight
            <strong>Bluetooth RFCOMM server</strong> to broadcast track metadata.
          </p>
          <p>
            This architecture keeps the app fast and self-contained. It
            runs as a single <code>.exe</code> without the need for a Python
            environment or complex setup.
          </p>
          <p>
            It automatically detects the default <code>mixxxdb.sqlite</code>
            location based on your OS. First-run is literally just double-clicking.
          </p>
          <div class="mt-3">
            <span class="tech-badge">Go</span>
            <span class="tech-badge">HTML</span>
            <span class="tech-badge">D3.js</span>
            <span class="tech-badge">SQLite</span>
            <span class="tech-badge">Mixxx</span>
          </div>
        </div>
        <div class="col-md-6 mt-4 mt-md-0">
          <h3>Who is it for?</h3>
          <p>
            DJ Buddy is built for DJs who curate music for <strong>social dance events</strong>. 
            Whether you are playing Swing (Lindy Hop, Balboa, Shag), Blues, Salsa, Tango, Bachata, or Forró, 
            this tool helps you manage the energy of a room where tracks are played in full.
          </p>
          <p>
            In these genres, the DJ's role is focused on curation and energy management rather than beat-matching. 
            DJ Buddy gives you a historical perspective on your current set, making it easier to decide 
            where to take the floor next.
          </p>
          <h3 class="mt-4">Getting started</h3>
          <ul class="setup-steps">
            <li class="setup-step-item">
              <div class="setup-step-num">01</div>
              <div class="setup-step-content">
                <h3>Download</h3>
                <p>
                  Get the <a
                    href="https://github.com/alxgom/Mixxx-dj-buddy/releases"
                    target="_blank"
                    rel="noopener noreferrer">latest <code>.exe</code></a
                  > from GitHub.
                </p>
              </div>
            </li>
            <li class="setup-step-item">
              <div class="setup-step-num">02</div>
              <div class="setup-step-content">
                <h3>Requirements</h3>
                <p>Ensure <a
                  href="https://mixxx.org/"
                  target="_blank"
                  rel="noopener noreferrer">Mixxx</a
                > is installed on your computer.</p>
              </div>
            </li>
            <li class="setup-step-item">
              <div class="setup-step-num">03</div>
              <div class="setup-step-content">
                <h3>Launch</h3>
                <p>Run <code>mixxx-dj-buddy.exe</code>. It will find your database automatically.</p>
              </div>
            </li>
            <li class="setup-step-item">
              <div class="setup-step-num">04</div>
              <div class="setup-step-content">
                <h3>Play</h3>
                <p>Start your DJ session and watch the energy chart come alive.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ─── FUTURE PLANS ─────────────────────────────────────── -->
    <section class="buddy-section">
      <h2>What's coming next</h2>
      <p>
        BPM is a useful proxy but not the whole story. The next version of DJ
        Buddy will move towards <strong>perceptual audio metrics</strong>.
        These features better represent how a song actually feels on the dance floor:
        energy, weight, pulse, dynamics.
      </p>
      <ul class="future-list mt-3">
        <li>
          <strong>Advanced audio analysis</strong>. Metrics that more closely reflect perceived energy and musical character.
        </li>
        <li>
          <strong>Richer set history</strong>. Better visualizations for long sets
          and patterns across multiple events.
        </li>
        <li>
          <strong>Remote discovery app for iOS</strong>. Expanding the wireless
          experience to more devices.
        </li>
      </ul>
      <p class="mt-3">
        Have a feature idea?
        <a
          href="https://github.com/alxgom/Mixxx-dj-buddy/issues"
          target="_blank"
          rel="noopener noreferrer">Open an issue on GitHub</a
        >.
      </p>
    </section>
