---
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";
import Lightbox from "../components/Lightbox.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
import wordcloud from "../assets/imgs/wordcloud.png";
import mixxxScreenshot from "../assets/imgs/Projects/mixxx_screenshot.png";
import mixxxDashboardSvg from "../assets/imgs/Projects/mixxx_dashboard_svg_logo.svg";
import rentalsImg from "../assets/imgs/Projects/PopulationByDistrict_NiceColormap.png";
import shareImg from "../assets/imgs/Projects/sac_web_app.png";
import trackingAppImg from "../assets/imgs/Projects/tracking_app.png";
import stitchedColorImg from "../assets/imgs/jet_example.png";
import springPendulumGif from "../assets/imgs/springPendulum.gif";
import waveGif from "../assets/imgs/3_WAVE.gif";
import filamentImg from "../assets/imgs/filament_scheme2.png";
import birdsImg from "../assets/imgs/Projects/birds.png";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/es/projects"; // Links to Spanish version
---

<MainLayout
  title={`Data Science & Physics Projects | ${SITE_TITLE}`}
  description="Explore my Data Science and Physics projects, including nonlinear dynamics, web scraping, and data visualization tools."
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <link rel="stylesheet" href="/assets/css/cv.css" slot="head" />

  <div class="cv-subheader mb-5">
    <div class="container">
      <a
        href="#Data_analysis"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="Projects - Data Analysis"
        >Data analysis & dashboards</a
      >
      <a
        href="#App_development"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="Projects - App Development">App development</a
      >
      <a
        href="#Viz_development"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="Projects - Visualization Dev"
        >Visualization development</a
      >
      <a
        href="#Plots_Viz"
        class="cv-nav-link gtm-track-click"
        data-event-category="Sub-navigation"
        data-event-label="Projects - Plots & Viz">Plots & Visualization</a
      >
    </div>
  </div>

  <div class="container mt-5 pt-5">
    <!-- Data Analysis & Dashboards Section -->
    <section id="Data_analysis" class="section mt-3">
      <div class="container text-center" style="padding-bottom:30px;">
        <h2 class="section-title mb-4">Data analysis & dashboards</h2>
      </div>

      <div class="container">
        <!-- Project: MIXX -->
        <div class="row mb-5 align-items-center">
          <div class="col-md-6 mb-3 mb-md-0">
            <div class="general-img-holder">
              <Image
                src={mixxxScreenshot}
                alt="MIXX Extension"
                class="img-fluid"
                loading="eager"
              />
              <div class="overlay">
                <a
                  href="https://dj-dashboard.onrender.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="overlay-link-full"
                  aria-label="View MIXX Dashboard"></a>
                <div class="overlay-infos">
                  <h5>Mixxx DJ Set Analysis Dashboard</h5>
                </div>
                <a
                  href={mixxxScreenshot.src}
                  class="overlay-zoom-link"
                  aria-label="Zoom in on Dashboard"
                  data-lightbox="true"><i class="ti-zoom-in"></i></a
                >
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <h4>Mixxx DJ Set Analysis Dashboard</h4>
            <p>
              It is a dashboard designed for <strong
                >post-set analysis and self-reflection</strong
              >. I use it to gain insights into my DJing style, understand my
              flow, and discover new song combinations or artists to explore.
            </p>
            <p>
              It tracks the <strong>entire history of my sets</strong> played at Swing
              & Blues events using data exported from Mixxx, allowing me to analyze
              individual performances and discover long-term trends.
            </p>
          </div>
          <p>
            You can check a live example here (it might take a few minutes to
            wake up):
            <a
              href="https://dj-dashboard.onrender.com/"
              target="_blank"
              rel="noopener noreferrer">Live Dashboard</a
            >
          </p>
          <p>
            <strong>Tech & skills:</strong> Data analysis, data visualization, Python,
            Dash, Plotly, SQL. <a
              href="https://github.com/alxgom/mixx_addon"
              target="_blank"
              rel="noopener noreferrer">View code on GitHub</a
            >
          </p>
        </div>
      </div>

      <!-- Project: Mixxx Python Companion -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <video
              autoplay
              muted
              loop
              playsinline
              class="img-fluid"
              poster="/assets/imgs/Projects/mixxx_pycompanion_poster.jpg"
              aria-label="Mixxx Python Companion Demo Video"
            >
              <source
                src="/assets/imgs/Projects/mixxx_pycompanion.webm"
                type="video/webm"
              />
              <source
                src="/assets/imgs/Projects/mixxx_pycompanion_optimized.mp4"
                type="video/mp4"
              />
              Your browser does not support the video tag.
            </video>
            <div class="overlay">
              <a
                href="https://github.com/alxgom/mixx-pycompanion"
                target="_blank"
                rel="noopener noreferrer"
                class="overlay-link-full gtm-track-click"
                data-event-category="Projects"
                data-event-label="Mixxx Companion - GitHub"
                aria-label="View Mixxx Companion on GitHub"></a>
              <div class="overlay-infos">
                <h5>Mixxx Python Companion</h5>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>Mixxx Python Companion</h4>
          <p>
            Small Python app to visualize the BPM sequence of DJ sets live. It
            works offline as a standalone web app using D3.js and reading
            directly from the Mixxx SQLite database in real-time.
          </p>
          <p>
            It provides DJs with a visual history of their set's energy flow,
            helping to maintain the desired atmosphere on the dance floor.
          </p>
          <p>
            <strong>Tech & skills:</strong> Python, D3.js, SQLite, Real-time Visualization.
            <a
              href="https://github.com/alxgom/mixx-pycompanion"
              target="_blank"
              rel="noopener noreferrer"
              class="gtm-track-click"
              data-event-category="Projects"
              data-event-label="Mixxx Companion - Text Link">View on GitHub</a
            >
          </p>
        </div>
      </div>

      <!-- Project: Rentals -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image src={rentalsImg} alt="Rentals Analysis" class="img-fluid" />
            <div class="overlay">
              <a
                href="https://www.kaggle.com/code/alexisgomel/apartment-rental-offers-munich"
                class="overlay-link-full"
                aria-label="View Rentals project"></a>
              <div class="overlay-infos">
                <h5>Rentals</h5>
              </div>
              <a
                href={rentalsImg.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on Rentals"
                data-lightbox="true"><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>Historical rent analysis</h4>
          <p>
            Analysis of historical rental data in Germany and price outlier
            detection (ongoing).
          </p>
          <p>
            The purpose of this project is to study the evolution of rental
            princes and the detection of outliers. Eventually i'd like it to be
            a tool for people to estimate if a property of their interest is
            reasonably priced.
          </p>
          <p>
            <strong>Tech & skills:</strong> Data analytics, Data science, Python,
            Scikit-learn, Pandas, geopandas, Jupyter-notebook.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- App Development Section -->
  <section id="App_development" class="section mt-3">
    <div class="container text-center" style="padding-bottom:30px;">
      <h2 class="section-title mb-4">App development</h2>
    </div>

    <div class="container">
      <!-- Project: SHARE -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image src={shareImg} alt="SHARE App" class="img-fluid" />
            <div class="overlay">
              <a
                href="/sac"
                class="overlay-link-full"
                aria-label="View SHARE project"></a>
              <div class="overlay-infos">
                <h5>SHared Appartment REnt Calculator (SHARE)</h5>
              </div>
              <a
                href={shareImg.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on SHARE"
                data-lightbox="true"><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>SHared Appartment REnt Calculator (SHARE)</h4>
          <p>
            Simple calculator to approximate the share of rent each tenant
            should pay, given the area of their room and the total rent of the
            appartment. It is also possible to add extra shared taxes like
            intenet or council tax to the calculation for budgeting purposes.
          </p>
          <p>
            The app Is inspired by my experience trying to find a accomodation
            in cities where rent is very high and sharing accomodation is
            commonplace. It is meant to be a first guess at what a fare share of
            rent would be for each flatmate. It doesn't take into account
            features like insuite bathrooms, balcony, etc..
          </p>
          <p>
            <a href="/sac" class="text-primary font-weight-bold"
              >Try the SHARE Calculator &rarr;</a
            >
          </p>
          <p>
            <strong>Tech & skills:</strong> Javascript, HTML
          </p>
        </div>
      </div>

      <!-- Project: Task Tracker -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image src={trackingAppImg} alt="Task Tracker" class="img-fluid" />
            <div class="overlay">
              <a
                href="https://github.com/alxgom/Tracking_app"
                class="overlay-link-full"
                aria-label="View Task tracker project"></a>
              <div class="overlay-infos">
                <h5>Task tracker</h5>
              </div>
              <a
                href={trackingAppImg.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on Task tracker"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>Task Tracker</h4>
          <p>
            Python app to track time spent on tasks. One can add what taks it
            wished to track, and the amount to time spent on each task each day.
            It is meant to be a tracking app for desktop only, to avoid
            interactig with a phone. It also allows to plot time spent on each
            task, to be able to visualize progress and consistance.
          </p>
          <p>
            <strong>Tech & skills:</strong> Full stack, Python, Pandas, json
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Visualization Development Section -->
  <section id="Viz_development" class="section mt-3">
    <div class="container text-center" style="padding-bottom:30px;">
      <h2 class="section-title mb-4">Visualization development</h2>
    </div>

    <div class="container">
      <!-- Project: Wordcloud -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image
              src={wordcloud}
              alt="Wordcloud Journal webscrapping"
              class="img-fluid"
            />
            <div class="overlay">
              <a
                href="https://github.com/alxgom/NL-Dynamics-wordcloud"
                class="overlay-link-full"
                aria-label="View Wordcloud project"></a>
              <div class="overlay-infos">
                <h5>Wordcloud Journal webscrapping</h5>
              </div>
              <a
                href={wordcloud.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on Wordcloud"
                data-lightbox="true"><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>Wordcloud Journal webscrapping</h4>
          <p>
            Web scraping project to visualize journal keywords from Nonlinear
            Dynamics journals.
          </p>
          <p>
            <strong>Tech & skills:</strong> Web scraping, Data visualization, Python.
          </p>
        </div>
      </div>

      <!-- Project: Stitched Colormaps -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image
              src={stitchedColorImg}
              alt="Stitched Colormaps"
              class="img-fluid"
            />
            <div class="overlay">
              <a
                href="https://github.com/alxgom/-stitched_colorbars/wiki/Stiched-Colormaps"
                class="overlay-link-full"
                aria-label="View Stitched colormaps project"></a>
              <div class="overlay-infos">
                <h5>Stiched colormaps</h5>
              </div>
              <a
                href={stitchedColorImg.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on Stitched colormaps"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>Custom colormaps code</h4>
          <p>
            This is a Python and Matlab code to make a new colormap by stitching
            together two pre-existing colormaps. It allows joining two diverging
            colormaps, but being able to change the colorbar limits and the
            pivot point of the divergence.
          </p>
          <p>
            It is usefull for data that has relevant information in very
            different ranges, or has a natural threshold that divides the data
            (For example topography with a water level.) Click on the image link
            to access the github repository.
          </p>
          <p>
            <strong>Tech & skills:</strong> Data visualization, Python, Matlab.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Plots and Visualization Section -->
  <section id="Plots_Viz" class="section mt-3">
    <div class="container text-center" style="padding-bottom:30px;">
      <h2 class="section-title mb-4">Plots & Visualization</h2>
    </div>

    <div class="container">
      <!-- Project: Spring Pendulum -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <img
              src={springPendulumGif.src}
              alt="Spring Pendulum"
              class="img-fluid"
            />
            <div class="overlay">
              <div class="overlay-infos">
                <h5>Spring Pendulum</h5>
              </div>
              <a
                href={springPendulumGif.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on Spring Pendulum"
                data-lightbox="true"><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>Spring Pendulum</h4>
          <p>Visualization of the dynamics of the spring pendulum system</p>
          <p>
            <strong>Tech & skills:</strong> Data visualization, Python, Matplotlib.
          </p>
        </div>
      </div>

      <!-- Project: 3 Wave Stabilization -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image src={waveGif} alt="3 Wave Stabilization" class="img-fluid" />
            <div class="overlay">
              <div class="overlay-infos">
                <h5>3 Wave stabilization</h5>
              </div>
              <a
                href={waveGif.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on 3 Wave stabilization"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>3 Wave stabilization</h4>
          <p>
            Modulational instability animation. Showing the nonlinear interation
            between frequencies of a propagating wave in a self-focusing regime.
          </p>
          <p>
            <strong>Tech & skills:</strong> Data visualization, Differential equations.
          </p>
        </div>
      </div>

      <!-- Project: Filamentation Scheme -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image
              src={filamentImg}
              alt="Filamentation Scheme"
              class="img-fluid"
            />
            <div class="overlay">
              <a
                href="https://github.com/alxgom/Filamentation_scheme/wiki/Filamentation-Scheme"
                class="overlay-link-full"
                aria-label="View Filamentation scheme project"></a>
              <div class="overlay-infos">
                <h5>Filamentation scheme</h5>
              </div>
              <a
                href={filamentImg.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on Filamentation scheme"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>Laser filamentation scheme</h4>
          <p>3d Laser filamentation scheme made in Python.</p>
          <p>
            <strong>Tech & skills:</strong> Data visualization, Dessign, Python, Matplotlib.
          </p>
        </div>
      </div>

      <!-- Project: Bird Migration -->
      <div class="row mb-5 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="general-img-holder">
            <Image src={birdsImg} alt="Bird Migration" class="img-fluid" />
            <div class="overlay">
              <a
                href="#"
                class="overlay-link-full"
                aria-label="View Bird migration project"></a>
              <div class="overlay-infos">
                <h5>Bird migration</h5>
              </div>
              <a
                href={birdsImg.src}
                class="overlay-zoom-link"
                aria-label="Zoom in on Bird migration"
                ><i class="ti-zoom-in"></i></a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h4>Bird migration</h4>
          <p>Visualization of bird migration data. (needs updating)</p>
          <p>
            <strong>Tech & skills:</strong> SQL, Tableau, Data visualization.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Viz Resources Section -->
  <section id="resources" class="section mt-3">
    <div
      class="bg-image bg-image-white"
      style="background-image: url(/assets/imgs/DSC02718-2.jpg); "
    >
      <div
        class="bg-image-white"
        style="background-color: rgba(255, 255, 255, 0.7); "
      >
        <div class="container text-left pt-5 pb-5">
          <h3 class="mb-4">Data visualization resources</h3>
          <p>Collection of useful resources for data visualization</p>
          <h4 class="mt-4 pt-2 pb-1">Visualization design</h4>

          <h5>
            <a
              href="https://economicsfromthetopdown.com/2020/07/23/10-tips-for-making-beautiful-charts/"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Read '10 Tips for Making Beautiful Charts' on economicsfromthetopdown.com"
            >
              10 Tips for Making Beautiful Charts
            </a>
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://journals.plos.org/ploscompbiol/article?id=10.1371/journal.pcbi.1003833"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Read 'Ten Simple Rules for Better Figures' by Nicolas P. Rougier, Michael Droettboom, and Philip E. Bourne"
            >
              Ten Simple Rules for Better Figures.
            </a> Nicolas P. Rougier, Michael Droettboom, Philip E. Bourne
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://www.edwardtufte.com/tufte/"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Visit Edward Tufte's website"
            >
              Edward Tufte website.
            </a> Some of the best resources for data visualization.
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://www.youtube.com/watch?v=xkBheRZTkaw&"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Data Visualization with D3 – Full Course for Beginners"
            >
              Data Visualization with D3.
            </a> Excellent 20hs course from his series "Get it right in black and
            white", to learn D3.js and how SVG works, developed by Curran Kelleher.
          </h5>

          <h3 class="mt-4 pb-1">Use of color in visualizations</h3>
          <h5>
            <a
              class="mt-2"
              href="https://matplotlib.org/cmocean/"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Visit CMocean colormaps website"
              >CMocean Colormaps for Oceanography.
            </a> Good examples of how colormaps impact the way we understand data.
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://onlinelibrary.wiley.com/doi/10.1002/rth2.12308"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Read the article 'Choosing color palettes for scientific figures' by Timothy B. Plante and Mary Cushman"
            >
              Choosing color palettes for scientific figures.
            </a> Timothy B. Plante MD, MHS, Mary Cushman MD, MSc
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://ai.googleblog.com/2019/08/turbo-improved-rainbow-colormap-for.html"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Read about Turbo, an improved rainbow colormap for visualization on Google AI Blog"
            >
              Turbo.
            </a> A linear colormap, optimized for data visualization with high contrast.
            Google AI Blog.
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://www.fabiocrameri.ch/colourmaps/"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Visit Fabio Crameri's scientific colormaps website"
            >
              Fabio Crameri's scientific colormaps.
            </a> Scientific colormaps developed for better performance and accessibility.
            Fabio Crameri.
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://www.nature.com/articles/s41467-020-19160-7 "
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Read the article 'The misuse of colour in science communication' by Fabio Crameri, Grace E. Shephard, and Philip J. Heron"
            >
              Article on the misuse of colour in science communication.
            </a> Fabio Crameri, Grace E. Shephard & Philip J. Heron.
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://www.simplifiedsciencepublishing.com/resources/best-color-palettes-for-scientific-figures-and-data-visualizations"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Read about choosing palettes for scientific visualization on simplifiedsciencepublishing.com"
            >
              simplifiedsciencepublishing.com
            </a> Guides and tools for choosing color palettes for scientific visualization.
          </h5>

          <h5>
            <a
              class="mt-2"
              href="https://www.youtube.com/watch?v=Qj1FK8n7WgY&"
              target="_blank"
              rel="noopener noreferrer"
              style="color: var(--primary)"
              aria-label="Watch 'Understanding color' by Blender Guru on YouTube"
            >
              Youtube: Understanding color. Blender Guru
            </a> Best resource for learning about color theory and how it impacts
            storytelling.
          </h5>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<Lightbox />

<script>
  // Sticky Sub-header Active State
  const navLinks = document.querySelectorAll(".cv-nav-link");
  const sections = document.querySelectorAll("section");

  const observerOptions = {
    root: null,
    rootMargin: "-20% 0px -60% 0px", // Highlighting when section is near top/center
    threshold: 0,
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        // Remove active class from all links
        navLinks.forEach((link) => link.classList.remove("active"));
        // Add active class to corresponding link
        const id = entry.target.getAttribute("id");
        if (id) {
          const activeLink = document.querySelector(
            `.cv-nav-link[href="#${id}"]`,
          );
          if (activeLink) {
            activeLink.classList.add("active");
          }
        }
      }
    });
  }, observerOptions);

  sections.forEach((section) => {
    observer.observe(section);
  });
</script>
