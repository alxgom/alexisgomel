          <select id="select-color" style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--light-gray, #d4d4d4); font-size: 0.9rem; background: white; cursor: pointer; font-family: monospace;">
            <option value="" selected>Original Purple</option>
            <option value="cta-seville-red">Seville Red</option>
            <option value="cta-seville-green">Seville Green</option>
            <option value="cta-seville-blue">Seville Blue</option>
            <option value="cta-seville-black">Seville Black (Red hover)</option>
            <option value="cta-seville-white">Seville White (Red hover)</option>
            <option value="cta-seville-albero">Seville Albero Gold</option>
          </select>
        </div>

        <!-- Chevron Size Selection -->
        <div class="control-group">
          <label style="display: block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--gray, #6c757d); margin-bottom: 8px;">Chevron Size</label>
          <select id="select-size" style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--light-gray, #d4d4d4); font-size: 0.9rem; background: white; cursor: pointer; font-family: monospace;">
            <option value="size-small">Small (~15px Chevron)</option>
            <option value="size-medium" selected>Medium (~18px Chevron - Cap Height)</option>
            <option value="size-large">Large (~25px Chevron - Full Font Size)</option>
          </select>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 320px; background: var(--cloud-dance-white, #f0eee9); border-radius: 12px; padding: 40px 24px; border: 1px dashed var(--light-gray, #d4d4d4); position: relative;">
        
        <div class="interactive-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; width: 100%; margin-bottom: 24px;">
          <!-- Version A: Morph Confirmation -->
          <div class="demo-box" style="padding: 24px; min-height: 180px; display: flex; flex-direction: column; align-items: center; justify-content: space-between;">
            <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gray, #6c757d); margin-bottom: 16px; text-align: center;">Version A: Morph to Checkmark</div>
            
            <button class="cta font-montserrat" id="btn-version-a" aria-label="Submit confirmation A">
              <span class="span btn-text" id="text-a">SUBMIT</span>
              <span class="second arrow-container" id="arrow-a">
                <svg viewBox="0 0 50 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="width: 100%; height: 100%; overflow: visible;">
                  <path d="M3 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="one" fill="currentColor"></path>
                  <path d="M19 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="two" fill="currentColor"></path>
                  <path d="M35 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="three" fill="currentColor"></path>
                </svg>
              </span>
              <svg
                class="success-svg"
                id="checkmark-a"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
            <div style="height: 10px;"></div>
          </div>

          <!-- Version B: Press & Expand -->
          <div class="demo-box" style="padding: 24px; min-height: 180px; display: flex; flex-direction: column; align-items: center; justify-content: space-between;">
            <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gray, #6c757d); margin-bottom: 16px; text-align: center;">Version B: Press & Expand</div>
            
            <button class="cta font-montserrat version-b" id="btn-version-b" aria-label="Submit confirmation B">
              <span class="span btn-text" id="text-b">SUBMIT</span>
              <span class="second arrow-container" id="arrow-b">
                <svg viewBox="0 0 50 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="width: 100%; height: 100%; overflow: visible;">
                  <path d="M3 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="one" fill="currentColor"></path>
                  <path d="M19 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="two" fill="currentColor"></path>
                  <path d="M35 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="three" fill="currentColor"></path>
                </svg>
              </span>
            </button>
            <div style="height: 10px;"></div>
          </div>

          <!-- Version C: Chevron Gateway -->
          <div class="demo-box" style="padding: 24px; min-height: 180px; display: flex; flex-direction: column; align-items: center; justify-content: space-between;">
            <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gray, #6c757d); margin-bottom: 16px; text-align: center;">Version C: Chevron Gateway (Portal)</div>
            
            <button class="cta font-montserrat version-c" id="btn-version-c" aria-label="Submit confirmation C">
              <span class="span btn-text" id="text-c">SUBMIT</span>
              <span class="second arrow-container" id="arrow-c">
                <svg viewBox="0 0 50 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="width: 100%; height: 100%; overflow: visible;">
                  <path d="M3 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="one" fill="currentColor"></path>
                  <path d="M19 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="two" fill="currentColor"></path>
                  <path d="M35 2 l10 10 l-10 10 h3 l10 -10 l-10 -10 z" class="three" fill="currentColor"></path>
                </svg>
              </span>
            </button>
            <div style="height: 10px;"></div>
          </div>
        </div>

        <button 
          id="btn-reset-all" 
          style="background: none; border: 1px solid var(--light-gray, #d4d4d4); padding: 8px 24px; font-size: 0.85rem; border-radius: 6px; cursor: pointer; color: var(--dark-gray, #434343); transition: all 0.2s;"
        >
          Reset All Buttons
        </button>
      </div>

      <!-- Live Log Console -->
      <div class="console-wrapper">
        <div class="console-header">
          <div>
            <span class="console-dot" id="console-pulse"></span>
            <span class="console-title" style="margin-left: 8px;">Telemetry Console</span>
          </div>
          <button class="console-clear-btn" id="console-clear">Clear Logs</button>
        </div>
        <div class="console-screen" id="console-logs-container">
          <!-- Live events will render here -->
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Buttons
      const btnA = document.getElementById("btn-version-a");
      const btnB = document.getElementById("btn-version-b");
      const btnC = document.getElementById("btn-version-c");

      // Text elements
      const textA = document.getElementById("text-a");
      const textB = document.getElementById("text-b");
      const textC = document.getElementById("text-c");

      // Containers
      const arrowA = document.getElementById("arrow-a");
      const checkmarkA = document.getElementById("checkmark-a");
      const resetAllBtn = document.getElementById("btn-reset-all");

      // Telemetry log container
      const logsContainer = document.getElementById("console-logs-container");
      const pulseDot = document.getElementById("console-pulse");
      const clearBtn = document.getElementById("console-clear");

      // Configuration elements
      const selectFont = document.getElementById("select-font");
      const selectColor = document.getElementById("select-color");
      const selectSize = document.getElementById("select-size");

      // Apply default font/size to all three buttons
      const allInteractiveBtns = [btnA, btnB, btnC];

      // Add log utility
      function addLog(type, message) {
        const time = new Date().toLocaleTimeString();
        const log = document.createElement("div");
        log.className = "console-log";
        
        let tagClass = "tag-system";
        if (type === "HOVER") tagClass = "tag-hover";
        if (type === "CLICK") tagClass = "tag-click";
        if (type === "SUCCESS") tagClass = "tag-success";
        if (type === "SYSTEM") tagClass = "tag-system";

        log.innerHTML = `<span class="console-time">[${time}]</span><span class="console-tag ${tagClass}">${type}</span>${message}`;
        logsContainer.appendChild(log);
        logsContainer.scrollTop = logsContainer.scrollHeight;

        // Flash pulse dot green
        pulseDot.classList.add("active");
        setTimeout(() => pulseDot.classList.remove("active"), 150);
      }

      // Initial Log
      addLog("SYSTEM", "Interaction console initialized. Standing by for user input.");

      // Hover feedback logs for other buttons
      const logBtns = document.querySelectorAll(".demo-log-btn");
      logBtns.forEach(button => {
        button.addEventListener("mouseenter", () => {
          const font = button.getAttribute("data-font");
          const color = button.getAttribute("data-color");
          if (font) {
            addLog("HOVER", `Hovered static: ${font} font. Left-to-right flow active.`);
          } else if (color) {
            addLog("HOVER", `Hovered static: ${color} color. Left-to-right flow active.`);
          }
        });
      });

      // Config control event listeners
      selectFont.addEventListener("change", (e) => {
        const selectedFont = e.target.value;
        allInteractiveBtns.forEach(btn => {
          btn.classList.remove("font-poppins", "font-montserrat", "font-alegreya");
          btn.classList.add(selectedFont);
        });
        addLog("SYSTEM", `Config: Font family set to ${e.target.options[e.target.selectedIndex].text} on all buttons.`);
      });

      selectColor.addEventListener("change", (e) => {
        const selectedColor = e.target.value;
        allInteractiveBtns.forEach(btn => {
          btn.classList.remove("cta-seville-red", "cta-seville-green", "cta-seville-blue", "cta-seville-albero", "cta-seville-black", "cta-seville-white");
          if (selectedColor) {
            btn.classList.add(selectedColor);
          }
        });
        addLog("SYSTEM", `Config: Color palette set to ${e.target.options[e.target.selectedIndex].text} on all buttons.`);
      });

      selectSize.addEventListener("change", (e) => {
        const selectedSize = e.target.value;
        allInteractiveBtns.forEach(btn => {
          btn.classList.remove("size-small", "size-medium", "size-large");
          btn.classList.add(selectedSize);
        });
        addLog("SYSTEM", `Config: Chevron size set to ${e.target.options[e.target.selectedIndex].text} on all buttons.`);
      });

      // Independent states
      let stateA = "idle";
      let stateB = "idle";
      let stateC = "idle";

      // --- Button A (Morph) ---
      btnA.addEventListener("mouseenter", () => {
        if (stateA === "idle") {
          addLog("HOVER", "Hovered Version A (Morph). Left-to-right flow active.");
        }
      });

      // Press down (contract)
      const pressBtnA = () => {
        if (stateA !== "idle") return;
        btnA.classList.add("state-pressed");
        addLog("CLICK", "Version A Pressed: Chevrons contracted.");
      };
      btnA.addEventListener("mousedown", pressBtnA);
      btnA.addEventListener("touchstart", (e) => {
        e.preventDefault();
        pressBtnA();
      });

      // --- Button B (Expansion) ---
      btnB.addEventListener("mouseenter", () => {
        if (stateB === "idle") {
          addLog("HOVER", "Hovered Version B (Expansion). Left-to-right flow active.");
        }
      });

      // Press down (contract)
      const pressBtnB = () => {
        if (stateB !== "idle") return;
        btnB.classList.add("state-pressed");
        addLog("CLICK", "Version B Pressed: Chevrons contracted.");
      };
      btnB.addEventListener("mousedown", pressBtnB);
      btnB.addEventListener("touchstart", (e) => {
        e.preventDefault();
        pressBtnB();
      });

      // --- Button C (Chevron Gateway / Portal) ---
      btnC.addEventListener("mouseenter", () => {
        if (stateC === "idle") {
          addLog("HOVER", "Hovered Version C (Gateway Portal). Glowing outline active.");
        }
      });

      // Press down (contract)
      const pressBtnC = () => {
        if (stateC !== "idle") return;
        btnC.classList.add("state-pressed");
        addLog("CLICK", "Version C Pressed: Gateway track loaded backwards.");
      };
      btnC.addEventListener("mousedown", pressBtnC);
      btnC.addEventListener("touchstart", (e) => {
        e.preventDefault();
        pressBtnC();
      });

      // Global release handler (mouseup & touchend)
      const handleRelease = () => {
        if (stateA === "idle" && btnA.classList.contains("state-pressed")) {
          btnA.classList.remove("state-pressed");
          stateA = "loading";
          btnA.classList.add("state-loading");
          textA.textContent = "PROCESSING...";
          addLog("CLICK", "Version A Released: Frozen pressed state + active color flow loading.");

          setTimeout(() => {
            stateA = "success";
            btnA.classList.remove("state-loading");
            btnA.classList.add("state-success");
            textA.textContent = "CONFIRMED";
            addLog("SUCCESS", "Version A Success: Morphed to Checkmark.");
          }, 1500);
        }

        if (stateB === "idle" && btnB.classList.contains("state-pressed")) {
          btnB.classList.remove("state-pressed");
          stateB = "success";
          btnB.classList.add("state-success");
          textB.textContent = "CONFIRMED";
          addLog("SUCCESS", "Version B Released: Chevrons expanded, solid color locked.");
        }

        if (stateC === "idle" && btnC.classList.contains("state-pressed")) {
          btnC.classList.remove("state-pressed");
          stateC = "success";
          btnC.classList.add("state-success");
          textC.textContent = "CONFIRMED";
          addLog("SUCCESS", "Version C Released: Chevrons shot forward, solid gold gateway locked.");
        }
      };

      window.addEventListener("mouseup", handleRelease);
      window.addEventListener("touchend", handleRelease);

      // --- Reset All ---
      resetAllBtn.addEventListener("click", () => {
        // Reset Version A
        stateA = "idle";
        btnA.classList.remove("state-success", "state-loading", "state-pressed");
        textA.textContent = "SUBMIT";

        // Reset Version B
        stateB = "idle";
        btnB.classList.remove("state-success", "state-pressed");
        textB.textContent = "SUBMIT";

        // Reset Version C
        stateC = "idle";
        btnC.classList.remove("state-success", "state-pressed");
        textC.textContent = "SUBMIT";

        addLog("SYSTEM", "All sandbox testing states reset to default idle.");
      });

      // Clear Logs
      clearBtn.addEventListener("click", () => {
        logsContainer.innerHTML = "";
        addLog("SYSTEM", "Logs cleared.");
      });
    });
  </script>
</MainLayout>
