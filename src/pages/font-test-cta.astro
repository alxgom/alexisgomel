      <!-- Configuration Controls -->
      <div class="control-panel" style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 30px; padding: 20px; background: var(--cloud-dance-white, #f0eee9); border-radius: 8px; border: 1px solid var(--light-gray, #d4d4d4);">
