            stroke="white"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>

        <button 
          id="btn-reset" 
          style="margin-top: 30px; background: none; border: 1px solid var(--light-gray, #d4d4d4); padding: 8px 16px; font-size: 0.85rem; border-radius: 6px; cursor: pointer; display: none;"
        >
          Reset Animation
        </button>
      </div>

      <!-- Live Log Console -->
      <div class="console-wrapper">
        <div class="console-header">
          <div>
            <span class="console-dot" id="console-pulse"></span>
            <span class="console-title" style="margin-left: 8px;">Telemetry Console</span>
          </div>
          <button class="console-clear-btn" id="console-clear">Clear Logs</button>
        </div>
        <div class="console-screen" id="console-logs-container">
          <!-- Live events will render here -->
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("interactive-cta-btn");
      const btnText = document.getElementById("btn-text");
      const arrowContainer = document.getElementById("arrow-container");
      const checkmark = document.getElementById("success-checkmark");
      const resetBtn = document.getElementById("btn-reset");
      const logsContainer = document.getElementById("console-logs-container");
      const pulseDot = document.getElementById("console-pulse");
      const clearBtn = document.getElementById("console-clear");

      // Add log utility
      function addLog(type, message) {
        const time = new Date().toLocaleTimeString();
        const log = document.createElement("div");
        log.className = "console-log";
        
        let tagClass = "tag-system";
        if (type === "HOVER") tagClass = "tag-hover";
        if (type === "CLICK") tagClass = "tag-click";
        if (type === "SUCCESS") tagClass = "tag-success";
        if (type === "SYSTEM") tagClass = "tag-system";

        log.innerHTML = `<span class="console-time">[${time}]</span><span class="console-tag ${tagClass}">${type}</span>${message}`;
        logsContainer.appendChild(log);
        logsContainer.scrollTop = logsContainer.scrollHeight;

        // Flash pulse dot green
        pulseDot.classList.add("active");
        setTimeout(() => pulseDot.classList.remove("active"), 150);
      }

      // Initial Log
      addLog("SYSTEM", "Interaction console initialized. Standing by for user input.");

      // Hover feedback logs for other buttons
      const logBtns = document.querySelectorAll(".demo-log-btn");
      logBtns.forEach(button => {
        button.addEventListener("mouseenter", () => {
          const font = button.getAttribute("data-font");
          const color = button.getAttribute("data-color");
          if (font) {
            addLog("HOVER", `Hovered: ${font} font variant. Chevron slide transition active.`);
          } else if (color) {
            addLog("HOVER", `Hovered: ${color} Seville palette variant. box-shadow shifted.`);
          }
        });
      });

      // Main Interactive Button States
      let currentState = "idle"; // idle, loading, success

      btn.addEventListener("mouseenter", () => {
        if (currentState === "idle") {
          addLog("HOVER", "Hovered main CTA. Skew state active. Slide-in transition active.");
        }
      });

      btn.addEventListener("mouseleave", () => {
        if (currentState === "idle") {
          addLog("HOVER", "Mouse left main CTA. Returned to default state.");
        }
      });

      btn.addEventListener("click", () => {
        if (currentState !== "idle") return;

        currentState = "loading";
        addLog("CLICK", "Primary Click Registered. Transitioning to loading state.");
        
        // Change state to loading
        btn.classList.add("state-loading");
        btnText.textContent = "PROCESSING...";
        addLog("SYSTEM", "Simulating asynchronous API confirmation request (1.5s delay)...");

        setTimeout(() => {
          currentState = "success";
          btn.classList.remove("state-loading");
          btn.classList.add("state-success");
          btnText.textContent = "CONFIRMED";
          arrowContainer.style.display = "none";
          checkmark.style.display = "inline-block";
          resetBtn.style.display = "inline-block";
          
          addLog("SUCCESS", "Fidelity checks passed. Success state active. Chevrons morphed to Checkmark.");
        }, 1500);
      });

      resetBtn.addEventListener("click", () => {
        currentState = "idle";
        btn.classList.remove("state-success");
        btnText.textContent = "SUBMIT";
        arrowContainer.style.display = "inline-block";
        checkmark.style.display = "none";
        resetBtn.style.display = "none";
        
        addLog("SYSTEM", "Testing sandbox reset. Returned to idle state.");
      });

      clearBtn.addEventListener("click", () => {
        logsContainer.innerHTML = "";
        addLog("SYSTEM", "Logs cleared.");
      });
    });
  </script>
</MainLayout>
