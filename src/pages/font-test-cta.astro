---
import MainLayout from "../layouts/MainLayout.astro";

const currentLang = "en";
const alternateHref = "/font-test-cta/";
---

<MainLayout
  title="CTA Interaction Test Page"
  description="Sandbox page to test the animated mobinkakei CTA button from Uiverse.io"
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <style>
    /* ==========================================
       CTA Button Styles from Uiverse.io by mobinkakei
       ========================================== */
    .cta-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 60vh;
      background: var(--cloud-dance-white, #f0eee9);
      padding: 40px;
      border-radius: 16px;
      margin: 120px auto 40px;
      max-width: 800px;
      border: 1px solid var(--light-gray, #d4d4d4);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .demo-title {
      font-family: var(--font-family-sans-serif, sans-serif);
      font-weight: 700;
      color: var(--black, #000);
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .demo-subtitle {
      font-family: var(--font-family-sans-serif-system, sans-serif);
      font-size: 0.95rem;
      color: var(--gray, #6c757d);
      margin-bottom: 40px;
      text-align: center;
      max-width: 500px;
      line-height: 1.5;
    }

    /* Uiverse.io mobinkakei CTA styles */
    .cta {
      display: flex;
      padding: 11px 33px;
      text-decoration: none;
      font-size: 25px;
      color: white;
      background: #6225e6;
      transition: 1s;
      box-shadow: 6px 6px 0 black;
      transform: skewX(-15deg);
      border: none;
      cursor: pointer;
    }

    .cta:focus {
      outline: none;
    }

    .cta:hover {
      transition: 0.5s;
      box-shadow: 10px 10px 0 #fbc638;
    }

    .cta .second {
      transition: 0.5s;
      margin-right: 0px;
    }

    .cta:hover .second {
      transition: 0.5s;
      margin-right: 45px;
    }

    .span {
      transform: skewX(15deg);
    }

    .second {
      width: 20px;
      margin-left: 30px;
      position: relative;
      top: 12%;
      display: inline-block;
      height: 20px;
    }

    .one {
      transition: 0.4s;
      transform: translateX(-60%);
    }

    .two {
      transition: 0.5s;
      transform: translateX(-30%);
    }

    .cta:hover .three {
      animation: color_anim 1s infinite 0.2s;
    }

    .cta:hover .one {
      transform: translateX(0%);
      animation: color_anim 1s infinite 0.6s;
    }

    .cta:hover .two {
      transform: translateX(0%);
      animation: color_anim 1s infinite 0.4s;
    }

    @keyframes color_anim {
      0% {
        fill: white;
      }

      50% {
        fill: #fbc638;
      }

      100% {
        fill: white;
      }
    }

    /* Source code display section */
    .code-section {
      width: 100%;
      max-width: 800px;
      margin: 0 auto 80px;
      background: #272822;
      padding: 30px;
      border-radius: 12px;
      border: 1px solid #3e3f3a;
      box-shadow: 0 4px 24px rgba(0,0,0,0.15);
    }

    .code-title {
      font-family: var(--font-family-sans-serif, sans-serif);
      font-size: 1.1rem;
      font-weight: 700;
      color: #f8f8f2;
      margin-bottom: 20px;
      border-bottom: 1px solid #3e3f3a;
      padding-bottom: 10px;
    }

    .code-section pre {
      margin: 0;
      overflow-x: auto;
      font-size: 0.85rem;
      line-height: 1.5;
    }

    .code-section code {
      color: #f8f8f2;
      background: none;
      padding: 0;
      border-radius: 0;
    }
  </style>

  <div class="test-wrapper">
    <div class="cta-container">
      <h1 class="demo-title">CTA Interaction Sandbox</h1>
      <p class="demo-subtitle">
        Hover over the slanted button below to trigger the sliding chevron translation 
        and color animation effects.
      </p>

      <!-- mobinkakei CTA Button -->
      <button class="cta" aria-label="Next step button">
        <span class="span">NEXT</span>
        <span class="second">
          <svg
            width="50px"
            height="20px"
            viewBox="0 0 66 43"
            version="1.1"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
          >
            <g
              id="arrow"
              stroke="none"
              stroke-width="1"
              fill="none"
              fill-rule="evenodd"
            >
              <path
                class="one"
                d="M40.1543933,3.89485454 L43.9763149,0.139296592 C44.1708311,-0.0518420739 44.4826329,-0.0518571125 44.6771675,0.139262789 L65.6916134,20.7848311 C66.0855801,21.1718824 66.0911863,21.8050225 65.704135,22.1989893 C65.7000188,22.2031791 65.6958657,22.2073326 65.6916762,22.2114492 L44.677098,42.8607841 C44.4825957,43.0519059 44.1708242,43.0519358 43.9762853,42.8608513 L40.1545186,39.1069479 C39.9575152,38.9134427 39.9546793,38.5968729 40.1481845,38.3998695 C40.1502893,38.3977268 40.1524132,38.395603 40.1545562,38.3934985 L56.9937789,21.8567812 C57.1908028,21.6632968 57.193672,21.3467273 57.0001876,21.1497035 C56.9980647,21.1475418 56.9959223,21.1453995 56.9937605,21.1432767 L40.1545208,4.60825197 C39.9574869,4.41477773 39.9546013,4.09820839 40.1480756,3.90117456 C40.1501626,3.89904911 40.1522686,3.89694235 40.1543933,3.89485454 Z"
                fill="#FFFFFF"
              ></path>
              <path
                class="two"
                d="M20.1543933,3.89485454 L23.9763149,0.139296592 C24.1708311,-0.0518420739 24.4826329,-0.0518571125 24.6771675,0.139262789 L45.6916134,20.7848311 C46.0855801,21.1718824 46.0911863,21.8050225 45.704135,22.1989893 C45.7000188,22.2031791 45.6958657,22.2073326 45.6916762,22.2114492 L24.677098,42.8607841 C24.4825957,43.0519059 24.1708242,43.0519358 23.9762853,42.8608513 L20.1545186,39.1069479 C19.9575152,38.9134427 19.9546793,38.5968729 20.1481845,38.3998695 C20.1502893,38.3977268 20.1524132,38.395603 20.1545562,38.3934985 L36.9937789,21.8567812 C37.1908028,21.6632968 37.193672,21.3467273 37.0001876,21.1497035 C36.9980647,21.1475418 36.9959223,21.1453995 36.9937605,21.1432767 L20.1545208,4.60825197 C19.9574869,4.41477773 19.9546013,4.09820839 20.1480756,3.90117456 C20.1501626,3.89904911 20.1522686,3.89694235 20.1543933,3.89485454 Z"
                fill="#FFFFFF"
              ></path>
              <path
                class="three"
                d="M0.154393339,3.89485454 L3.97631488,0.139296592 C4.17083111,-0.0518420739 4.48263286,-0.0518571125 4.67716753,0.139262789 L25.6916134,20.7848311 C26.0855801,21.1718824 26.0911863,21.8050225 25.704135,22.1989893 C25.7000188,22.2031791 25.6958657,22.2073326 25.6916762,22.2114492 L4.67709797,42.8607841 C4.48259567,43.0519059 4.17082418,43.0519358 3.97628526,42.8608513 L0.154518591,39.1069479 C-0.0424848215,38.9134427 -0.0453206733,38.5968729 0.148184538,38.3998695 C0.150289256,38.3977268 0.152413239,38.395603 0.154556228,38.3934985 L16.9937789,21.8567812 C17.1908028,21.6632968 17.193672,21.3467273 17.0001876,21.1497035 C16.9980647,21.1475418 16.9959223,21.1453995 16.9937605,21.1432767 L0.15452076,4.60825197 C-0.0425130651,4.41477773 -0.0453986756,4.09820839 0.148075568,3.90117456 C0.150162624,3.89904911 0.152268631,3.89694235 0.154393339,3.89485454 Z"
                fill="#FFFFFF"
              ></path>
            </g>
          </svg>
        </span>
      </button>
    </div>

    <!-- Markup Guidelines for Reference -->
    <div class="code-section">
      <div class="code-title">HTML Structure Used:</div>
      <pre><code>&lt;button class="cta"&gt;
  &lt;span class="span"&gt;NEXT&lt;/span&gt;
  &lt;span class="second"&gt;
    &lt;svg
      width="50px"
      height="20px"
      viewBox="0 0 66 43"
      version="1.1"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
    &gt;
      &lt;g id="arrow" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"&gt;
        &lt;path class="one" d="..." fill="#FFFFFF"&gt;&lt;/path&gt;
        &lt;path class="two" d="..." fill="#FFFFFF"&gt;&lt;/path&gt;
        &lt;path class="three" d="..." fill="#FFFFFF"&gt;&lt;/path&gt;
      &lt;/g&gt;
    &lt;/svg&gt;
  &lt;/span&gt;
&lt;/button&gt;</code></pre>
    </div>
  </div>
</MainLayout>
