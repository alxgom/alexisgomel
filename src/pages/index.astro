---
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";
import Lightbox from "../components/Lightbox.astro";
import PortfolioCarousel from "../components/PortfolioCarousel.astro";
import { Image } from "astro:assets";
import avatarLiviano from "../assets/imgs/avatar_liviano.png";
import hamiltonian3d from "../assets/imgs/3d_hamiltonian.png";
import waveSchemeFlows from "../assets/imgs/wave_scheme_flows.png";

import populationMap from "../assets/imgs/PopulationByDistrict_NiceColormap_mini.png";
import filamentScheme from "../assets/imgs/filament_scheme2.png";
import sacWebApp from "../assets/imgs/Projects/sac_web_app.png";
import mixxxDashboard from "../assets/imgs/Projects/mixxx_dashboard_svg_logo.svg";
import sharePuzzleLogo from "../assets/imgs/Projects/share_puzzle_logo.svg";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  EMAIL,
  INSTAGRAM_LINK,
  LINKEDIN_LINK,
  GITHUB_LINK,
  RESEARCHGATE_LINK,
} from "../consts";

// MULTILINGUAL SETTINGS
const currentLang = "en";
const alternateHref = "/es/"; // Links to Spanish version

// Portfolio items for carousel
const portfolioItems = [
  {
    image: hamiltonian3d,
    imageAlt: "Rogue wave freezing visualization",
    title: "Rogue Wave Freezing",
    description:
      "Research on controlling extreme ocean waves using Hamiltonian mechanics. Published in Physical Review Letters 2021.",
    zoomHref: "/assets/imgs/3d_hamiltonian.png",
    linkHref:
      "https://journals.aps.org/prl/abstract/10.1103/PhysRevLett.126.174501",
    linkAriaLabel: "View Rogue wave freezing publication",
    zoomAriaLabel: "Zoom in on Rogue wave freezing",
    gtmLabel: "Rogue wave freezing",
  },
  {
    image: mixxxDashboard,
    imageAlt: "Mixxx DJ Set Analysis Dashboard",
    title: "Mixxx DJ Set Analysis Dashboard",
    description:
      "Dashboard designed for post-set analysis of DJ sets, providing insights into style, flow, and song combinations.",
    zoomHref: "/assets/imgs/Projects/mixxx_screenshot.png",
    linkHref: "https://dj-dashboard.onrender.com/",
    linkAriaLabel: "View Mixxx Dashboard",
    zoomAriaLabel: "Zoom in on Mixxx Dashboard",
    gtmLabel: "Mixxx Dashboard",
  },
  {
    image: populationMap,
    imageAlt: "Custom colormaps visualization",
    title: "Custom Colormaps",
    description:
      "Python library for creating stitched colorbars - combining multiple color palettes for complex data visualization.",
    zoomHref: "/assets/imgs/PopulationByDistrict_NiceColormap.png",
    linkHref: "https://github.com/alxgom/-stitched_colorbars",
    linkAriaLabel: "View Custom colormaps on GitHub",
    zoomAriaLabel: "Zoom in on Custom colormaps",
    gtmLabel: "Custom colormaps",
  },
  {
    image: sharePuzzleLogo,
    imageAlt: "Animated House Puzzle Logo for SHARE Calculator",
    title: "SHARE Calculator",
    description:
      "Simple calculator to approximate the share of rent each tenant should pay based on room size. Built with JavaScript and HTML.",
    zoomHref: "/assets/imgs/Projects/sac_web_app.png",
    linkHref: "/sac",
    linkAriaLabel: "Open SHARE Calculator",
    zoomAriaLabel: "Zoom in on SHARE Calculator",
    gtmLabel: "SHARE Calculator",
  },
  // PRESERVED FOR FUTURE USE: Laser Filamentation Regimes
  // {
  //   image: filamentScheme,
  //   imageAlt: "Filamentation statistical regimes",
  //   title: "Laser Filamentation Regimes",
  //   description:
  //     "Statistical analysis of light filamentation in nonlinear media, exploring different propagation regimes.",
  //   zoomHref: "/assets/imgs/filament_scheme2.png",
  //   linkHref:
  //     "https://opg.optica.org/oe/fulltext.cfm?uri=oe-31-6-9973&id=527180",
  //   linkAriaLabel: "View Filamentation publication",
  //   zoomAriaLabel: "Zoom in on Filamentation",
  //   gtmLabel: "Filamentation",
  // },
];
---

<MainLayout
  title="Alexis Gomel | Physicist & Data Scientist Portfolio"
  description={SITE_DESCRIPTION}
  currentLang={currentLang}
  alternateHref={alternateHref}
>
  <section class="header" id="hero">
    <div class="bg-image bg-image-white">
      <div class="bg-image-white">
        <div class="container">
          <div class="infos">
            <div class="row mb-4">
              <div class="col-12 text-center text-md-left">
                <h1 class="title h6 mb-2">Alexis Gomel</h1>
                <h2 class="subtitle font-weight-normal mb-0">
                  Physics | Data science | Data analysis | Researcher
                </h2>
              </div>
            </div>
            <div class="row align-items-center">
              <div class="col-md-4 text-center">
                <Image
                  src={avatarLiviano}
                  alt="Alexis Gomel Avatar"
                  class="img-thumbnail mb-4"
                  style="width: 100%; max-width: 250px; height: auto;"
                />
                <div class="buttons mb-2 mb-md-0">
                  <a
                    href="#contact"
                    class="btn btn-primary rounded mr-2 gtm-track-click"
                    aria-label="Contact Alexis"
                    data-event-category="Header"
                    data-event-label="Contact Button Click"
                  >
                    <i class="ti-email"></i>
                  </a>
                  <a
                    href="/assets/files/CV Alexis Gomel - General Profile.pdf"
                    download
                    class="gtm-track-click"
                    data-event-category="Header"
                    data-event-label="Download CV"
                  >
                    <button
                      class="btn btn-dark rounded"
                      aria-label="Download CV">DOWNLOAD CV</button
                    >
                  </a>
                </div>
              </div>
              <div class="col-md-8 text-center text-md-left pl-md-5">
                <h3
                  class="lead"
                  style="font-size: clamp(22px, 2.9vw, 40px); line-height: 1.4;"
                >
                  I get inspired by connecting the dots between different
                  worlds. From physics and education to photography, I use my
                  diverse background to look past the obvious and create
                  innovative solutions.
                </h3>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <a href="#service" class="scroll-down" aria-label="Scroll Down">
      <span>Portfolio</span>
      <i class="ti-angle-down"></i>
    </a>
  </section>

  <main>
    <section id="service" class="section">
      <div class="container text-center">
        <h2 class="section-title pt-5 mb-2">What I Do</h2>
        <p class="section-subtitle">
          Check out my professional experience, my projects, and my academic
          publications.
        </p>
        <div class="row justify-content-center">
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/cvonline"
              icon="icon ti-user"
              title="Online cv"
              ariaLabel="View Online CV"
              gtmCategory="Home Card"
              gtmLabel="Online CV"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/projects"
              icon="icon ti-gallery"
              title="Apps, visualizations & other projects"
              ariaLabel="Apps, visualizations & other projects"
              gtmCategory="Home Card"
              gtmLabel="Apps, visualizations & other projects"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="https://scholar.google.com/citations?user=XgG56aYAAAAJ&hl=es&oi=ao"
              target="_blank"
              icon="ai ai-google-scholar ai-3x"
              title="Publications (G-scholar)"
              ariaLabel="View Publications on Google Scholar"
              gtmCategory="Home Card"
              gtmLabel="Publications"
            />
          </div>
        </div>
      </div>
    </section>
    <section id="hobbies" class="section">
      <div class="container text-center">
        <h2 class="section-title pt-5 mb-2">Hobbies</h2>
        <p class="section-subtitle">
          Outside of my professional pursuits, I love to capture life through
          photography, move to the rhythm of swing dances, the beat the drums,
          and hit the road for spontaneous hitchhiking adventures.
        </p>
        <div class="row justify-content-center">
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/photography"
              icon="icon ti-camera"
              title="Photography"
              ariaLabel="View Photography"
              gtmCategory="Home Card"
              gtmLabel="Photography"
            />
          </div>
          <div class="col-sm-6 col-md-3 mb-4">
            <Card
              href="/playlists"
              icon="icon ti-music-alt"
              title="Playlists"
              ariaLabel="View Playlists"
              gtmCategory="Home Card"
              gtmLabel="Playlists"
            />
          </div>
        </div>
      </div>
    </section>

    <PortfolioCarousel
      items={portfolioItems}
      sectionTitle="Check My Works"
      sectionSubtitle="Here is a little snippet of my portfolio. If you want see more, please check out my projects page on the section above."
    />

    <section id="contact" class="position-relative section">
      <div class="container text-center">
        <p class="subtitle">Contact</p>
        <h2 class="section-title mb-4">
          <a
            href="mailto:alexis.gomel@gmail.com"
            target="_blank"
            rel="noopener noreferrer"
            class="gtm-track-click"
            data-event-category="Contact"
            data-event-label="Send Email Link"
          >
            Send me an email: alexis.gomel@gmail.com
          </a>
        </h2>
        <form
          action="https://formspree.io/f/xldqpzqd"
          method="POST"
          class="contact-form"
        >
          <input
            type="email"
            name="email"
            placeholder="Your email"
            aria-label="Email"
            required
          />
          <textarea
            name="message"
            placeholder="Your message"
            aria-label="Message"
            required></textarea>
          <button
            type="submit"
            class="btn btn-primary rounded gtm-track-click"
            data-event-category="Contact"
            data-event-label="Submit Form"
          >
            Send Message
          </button>
        </form>
      </div>
      <div id="map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d95776.4!2d2.154!3d41.3851!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2ses"
          title="Barcelona Location Map"
          style="border:0; width: 100%; height: 100%; filter: grayscale(100%);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>
    <Lightbox />
  </main>
</MainLayout>
