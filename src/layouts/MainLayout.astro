---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  currentLang: string;
  alternateHref: string;
  bodyId?: string;
  bodyClass?: string;
  bodyData?: Record<string, string>;
  image?: string;
}

const {
  title,
  description,
  currentLang,
  alternateHref,
  bodyId = "home",
  bodyClass = "",
  bodyData = {},
  image,
} = Astro.props;

const GTM_ID = "GTM-WDZK7ZFX";
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      currentLang={currentLang}
      alternateHref={alternateHref}
    />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });

      // Synchronously update consent based on previous choices, before GTM loads
      try {
        if (localStorage.getItem("silktideCookieBanner_InitialChoice")) {
          var consentUpdates = {};
          if (
            localStorage.getItem("silktideCookieChoice_analytics") === "true"
          ) {
            consentUpdates.analytics_storage = "granted";
          }
          if (
            localStorage.getItem("silktideCookieChoice_advertising") === "true"
          ) {
            consentUpdates.ad_storage = "granted";
            consentUpdates.ad_user_data = "granted";
            consentUpdates.ad_personalization = "granted";
          }
          if (Object.keys(consentUpdates).length > 0) {
            gtag("consent", "update", consentUpdates);
          }
        }
      } catch (e) {
        // Ignore localStorage errors (e.g., if cookies are disabled)
      }
    </script>

    <CookieConsent currentLang={currentLang} />

    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-WDZK7ZFX");
    </script>

    <link
      rel="preload"
      href="/assets/vendors/themify-icons/css/themify-icons.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="/assets/vendors/themify-icons/css/themify-icons.css"
      />
    </noscript>

    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
      />
    </noscript>

    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css"
      />
    </noscript>
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
      integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/assets/css/global.css" />
    <link rel="stylesheet" href="/assets/css/cards.css" />
    <link rel="stylesheet" href="/assets/css/images.css" />

    <!-- Allow child pages to inject into head -->
    <slot name="head" />
  </head>

  <body
    data-spy="scroll"
    data-target=".navbar"
    data-offset="40"
    id={bodyId}
    class={bodyClass}
    {...bodyData}
  >
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        title="Google Tag Manager"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <Header />

    <slot />

    <Footer />

    <!-- Core Scripts -->
    <script
      is:inline
      defer
      src="/assets/vendors/jquery/jquery-3.4.1.slim.min.js"></script>
    <script
      is:inline
      defer
      src="/assets/vendors/bootstrap/bootstrap.bundle.min.js"></script>
    <script is:inline defer src="/assets/vendors/bootstrap/bootstrap.affix.js"
    ></script>
    <slot name="scripts" />
  </body>
</html>
